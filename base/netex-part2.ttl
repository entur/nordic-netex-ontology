    rdfs:comment "The allocation of a SCHEDULED STOP POINT (i.e. a SCHEDULED STOP POINT of a SERVICE PATTERN or JOURNEY PATTERN) to a specific STOP PLACE or QUAY, for either a Passenger JOURNEY or VEHICLE SERVICE." ;
    netex:xsdType "VehicleJourneyStopAssignment_VersionStructure" .

netex:vehicleJourneyStopAssignmentRef a owl:ObjectProperty ;
    rdfs:label "VehicleJourneyStopAssignmentRef" ;
    rdfs:range netex:VehicleJourneyStopAssignment ;
    netex:isReference true ;
    netex:xsdType "VehicleJourneyStopAssignmentRefStructure" .

netex:vehicleJourneyWaitTime a owl:ObjectProperty ;
    rdfs:label "VehicleJourneyWaitTime" ;
    netex:xsdType "VehicleJourneyWaitTime_VersionedChildStructure" .

netex:vehicleJourneys a owl:ObjectProperty ;
    rdfs:label "vehicleJourneys" ;
    rdfs:comment "VEHICLE JOURNEYs in frame." ;
    netex:xsdType "journeysInFrame_RelStructure" .

netex:vehicleModes a owl:DatatypeProperty ;
    rdfs:label "VehicleModes" ;
    rdfs:comment "PT MODEs of VEHICLE JOURNEYs in timetable." ;
    netex:xsdType "AllPublicTransportModesListOfEnumerations" .

netex:vehicleService a owl:ObjectProperty ;
    rdfs:label "VehicleService" ;
    netex:xsdType "VehicleService_VersionStructure" .

netex:vehicleServicePart a owl:ObjectProperty ;
    rdfs:label "VehicleServicePart" ;
    netex:xsdType "VehicleServicePart_VersionStructure" .

netex:vehicleServiceParts a owl:ObjectProperty ;
    rdfs:label "vehicleServiceParts" ;
    rdfs:comment "Parts of a VEHICLE SERVICE." ;
    netex:xsdType "vehicleServiceParts_RelStructure" .

netex:vehicleServiceRef a owl:ObjectProperty ;
    rdfs:label "VehicleServiceRef" ;
    rdfs:range netex:VehicleService ;
    netex:isReference true ;
    netex:xsdType "VehicleServiceRefStructure" .

netex:vehicleServices a owl:ObjectProperty ;
    rdfs:label "vehicleServices" ;
    rdfs:comment "VEHICLE SERVICES in frame." ;
    netex:xsdType "vehicleServicesInFrame_RelStructure" .

netex:vehicleStoppingPositionRef a owl:ObjectProperty ;
