netex:AccountableElementRefStructure a owl:Class ;
    rdfs:label "AccountableElement" ;
    rdfs:comment "Type for Reference to an ACCOUNTABLE ELEMENT." ;
    rdfs:subClassOf netex:VersionOfObjectRefStructure .

netex:AccountableElementStructure a owl:Class ;
    rdfs:label "AccountableElement" ;
    rdfs:comment "Type for ACCOUNTABLE ELEMENT." ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:comment "Description of ACCOUNTABLE ELEMENT." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:description ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:accountingTime ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:accountingFactor ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            rdfs:comment "Time to prepare ACCOUNTABLE ELEMENT." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:preparationDuration ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            rdfs:comment "Time to complete ACCOUNTABLE ELEMENT." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:finishingDuration ;
            netex:xsdSequenceOrder 5 ],
        netex:DataManagedObjectStructure .

netex:BlockPartRefStructure a owl:Class ;
    rdfs:label "BlockPart" ;
    rdfs:comment "Type for Reference to a BLOCK PART." ;
    rdfs:subClassOf netex:VersionOfObjectRefStructure .

netex:BlockPart_VersionStructure a owl:Class ;
    rdfs:label "BlockPart" ;
    rdfs:comment "Type for a BLOCK PART." ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:comment "Name of BLOCK PART." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:name ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            rdfs:comment "Description of BLOCK PART." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:description ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:blockRef ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:vehicleTypeRef ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:compoundBlockRef ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:journeyPartCoupleRef ;
            netex:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            rdfs:comment "JOURNEY PARTs in BLOCK PART." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:journeyParts ;
            netex:xsdSequenceOrder 7 ],
        netex:DataManagedObjectStructure .

netex:BlockRefStructure a owl:Class ;
    rdfs:label "Block" ;
    rdfs:comment "Type for Reference to a BLOCK." ;
    rdfs:subClassOf netex:VersionOfObjectRefStructure .

netex:Block_VersionStructure a owl:Class ;
    rdfs:label "Block" ;
    rdfs:comment "Type for BLOCK." ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:comment "Name of BLOCK." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:name ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            rdfs:comment "DAY TYPEs for BLOCK." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:dayTypes ;
            netex:xsdSequenceOrder 10 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:vehicleServicePartRef ;
            netex:xsdSequenceOrder 11 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:vehicleTypeRef ;
            netex:xsdSequenceOrder 12 ],
        [ a owl:Restriction ;
            rdfs:comment "Point at which BLOCK starts Should be a PARKING POINT but might be of unknown type." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:startPointRef ;
            netex:xsdSequenceOrder 13 ],
        [ a owl:Restriction ;
            rdfs:comment "Point at which BLOCK ends Point at which BLOCK starts Should be a PARKING POINT but might be of unknown type." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:endPointRef ;
            netex:xsdSequenceOrder 14 ],
        [ a owl:Restriction ;
            rdfs:comment "JOURNEYS making up BLOCK." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:journeys ;
            netex:xsdSequenceOrder 15 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:coursesOfJourneys ;
            netex:xsdSequenceOrder 16 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:blockParts ;
            netex:xsdSequenceOrder 17 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:reliefOpportunities ;
            netex:xsdSequenceOrder 18 ],
        [ a owl:Restriction ;
            rdfs:comment "Description of BLOCK." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:description ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:privateCode ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            rdfs:comment "Preparation time before starting BLOCK." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:preparationDuration ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            rdfs:comment "Start time of BLOCK. In principle this can be derived from the Start time of the first journey and the preparation duration but may be stated explicitly as well." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:startTime ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            rdfs:comment "Day offset of Start time from current OPERATING DAY." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:startTimeDayOffset ;
            netex:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            rdfs:comment "Time to complete BLOCK." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:finishingDuration ;
            netex:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            rdfs:comment "End time of BLOCK. In principle this can be derived from the Start time of the last journey and the finishing duration but may be stated explicitly as well." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:endTime ;
            netex:xsdSequenceOrder 8 ],
        [ a owl:Restriction ;
            rdfs:comment "Day offset of end time from current OPERATING DAY." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:endTimeDayOffset ;
            netex:xsdSequenceOrder 9 ],
        netex:DataManagedObjectStructure .

netex:ConnectingServiceJourney_DerivedViewStructure a owl:Class ;
    rdfs:label "ConnectingServiceJourney" ;
    rdfs:comment "Type for CONNECTING SERVICE JOURNEY VIEW." ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:comment "Service Journey to which srevice connects." ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:serviceJourneyRef ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            rdfs:comment "Time of Departure." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:departureTime ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            rdfs:comment "Frequency of departure." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:frequency ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            rdfs:comment "Name of journey." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:name ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:destinationDisplayView ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:dayTypeRef ;
            netex:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            rdfs:comment "Reference to a JOURNEY PATTERN." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:journeyPatternRef ;
            netex:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:connectingOrder ;
            netex:xsdSequenceOrder 8 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:connectingVisitNumber ;
            netex:xsdSequenceOrder 9 ],
        netex:DerivedViewStructure .

netex:DatedPassingTime_VersionedChildStructure a owl:Class ;
    rdfs:label "DatedPassingTime" ;
    rdfs:comment "Type for DATED PASSING TIME." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:datedJourneyRef ;
            netex:xsdSequenceOrder 1 ],
        netex:PassingTime_VersionedChildStructure ;
    netex:abstract true .

netex:ServiceJourneyRefStructure a owl:Class ;
    rdfs:label "ServiceJourney" ;
    rdfs:comment "Type for a reference to a SERVICE JOURNEY." ;
    rdfs:subClassOf netex:JourneyRefStructure .

netex:SpecialServiceRefStructure a owl:Class ;
    rdfs:label "SpecialService" ;
    rdfs:comment "Type for a reference to a SPECIAL SERVICE." ;
    rdfs:subClassOf netex:JourneyRefStructure .

netex:SpecialService_VersionStructure a owl:Class ;
    rdfs:label "SpecialService" ;
    rdfs:comment "Type for SPECIAL SERVICE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:comment "Time of departure." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:departureTime ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:destination ;
            netex:xsdSequenceOrder 10 ],
        [ a owl:Restriction ;
            rdfs:comment "Whether the journey is included in printed media. Default is true." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:print ;
            netex:xsdSequenceOrder 11 ],
        [ a owl:Restriction ;
            rdfs:comment "When SERVICE JOURNEY is to be publicised in dynamic media. Default is always." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:dynamic ;
            netex:xsdSequenceOrder 12 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:typeOfFlexibleServiceRef ;
            netex:xsdSequenceOrder 13 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:flexibleServiceType ;
            netex:xsdSequenceOrder 14 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:cancellationPossible ;
            netex:xsdSequenceOrder 15 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:changeOfTimePossible ;
            netex:xsdSequenceOrder 16 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:bookingArrangements ;
            netex:xsdSequenceOrder 17 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:bookingContact ;
            netex:xsdSequenceOrder 18 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:bookingMethods ;
            netex:xsdSequenceOrder 19 ],
        [ a owl:Restriction ;
            rdfs:comment "Day offset if day of departure time of VEHICLE JOURNEY differs from the current OPERATING DAY." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:departureDayOffset ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:bookingAccess ;
            netex:xsdSequenceOrder 20 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:bookWhen ;
            netex:xsdSequenceOrder 21 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:buyWhen ;
            netex:xsdSequenceOrder 22 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:latestBookingTime ;
            netex:xsdSequenceOrder 23 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:minimumBookingPeriod ;
            netex:xsdSequenceOrder 24 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:maximumBookingPeriod ;
            netex:xsdSequenceOrder 25 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:bookingUrl ;
            netex:xsdSequenceOrder 26 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:bookingNote ;
            netex:xsdSequenceOrder 27 ],
        [ a owl:Restriction ;
            rdfs:comment "Frequency of Journey." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:frequency ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:journeyDuration ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:client ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            rdfs:comment "DAY TYPEs for Journey." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:dayTypes ;
            netex:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            rdfs:comment "Reference to a JOURNEY PATTERN." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:journeyPatternRef ;
            netex:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:vehicleTypeRef ;
            netex:xsdSequenceOrder 8 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:origin ;
            netex:xsdSequenceOrder 9 ],
        netex:Journey_VersionStructure .

netex:VehicleJourneyStopAssignmentRefStructure a owl:Class ;
    rdfs:label "VehicleJourneyStopAssignment" ;
    rdfs:comment "Type for a reference to a VEHICLE JOURNEY STOP ASSIGNMENT." ;
    rdfs:subClassOf netex:PassengerStopAssignmentRefStructure .

netex:VehicleJourneyStopAssignment_VersionStructure a owl:Class ;
    rdfs:label "VehicleJourneyStopAssignment" ;
    rdfs:comment "Type for VEHICLE JOURNEY STOP ASSIGNMENT." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty netex:vehicleJourneyRef ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:passengerStopAssignmentRef ;
            netex:xsdSequenceOrder 2 ],
        netex:PassengerStopAssignment_VersionStructure .

