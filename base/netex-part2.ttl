netex:InterchangeRuleFilter_VersionedChildStructure a owl:Class ;
    rdfs:label "InterchangeRuleFilter" ;
    rdfs:comment "Type for INTERCHANGE RULE PARAMETER." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:operatorRef ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:adjacentPointRef ;
            netex:xsdSequenceOrder 10 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:endStopPointRef ;
            netex:xsdSequenceOrder 11 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:timeDemandTypeRef ;
            netex:xsdSequenceOrder 12 ],
        [ a owl:Restriction ;
            rdfs:comment "Reference to a connecting VEHICLE JOURNEY to whom INTERCHANGE RULE applies. If absent applies to all journeys." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:serviceJourneyRef ;
            netex:xsdSequenceOrder 13 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:serviceDesignator ;
            netex:xsdSequenceOrder 14 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:maximumInterchangeWindow ;
            netex:xsdSequenceOrder 15 ],
        [ a owl:Restriction ;
            rdfs:comment "Identifier of PT MODE of end Point of TRANSFER . Default is all modes." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:transportMode ;
            netex:xsdSequenceOrder 16 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:stopAreaRef ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:stopPlaceRef ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:allLines ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:linesInDirectionRefs ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:onProperty netex:lineInDirectionRef ;
            netex:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:scheduledStopPointRef ;
            netex:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
