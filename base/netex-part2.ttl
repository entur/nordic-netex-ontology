netex:TimetableFrameRefStructure a owl:Class ;
    rdfs:label "TimetableFrame" ;
    rdfs:comment "Type for Reference to a TIMETABLE FRAME." ;
    rdfs:subClassOf netex:VersionFrameRefStructure .

netex:Timetable_VersionFrameStructure a owl:Class ;
    rdfs:label "Timetable_VersionFrame" ;
    rdfs:comment "Type for TIMETABLE FRAME." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:vehicleModes ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:bookingTimes ;
            netex:xsdSequenceOrder 10 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:accessibilityAssessment ;
            netex:xsdSequenceOrder 11 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:transportTypeRef ;
            netex:xsdSequenceOrder 12 ],
        [ a owl:Restriction ;
            rdfs:comment "TIME DEMAND TYPEs in frame." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:timeDemandTypes ;
            netex:xsdSequenceOrder 13 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:timeDemandTypeAssignments ;
            netex:xsdSequenceOrder 14 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:timingLinkGroups ;
            netex:xsdSequenceOrder 15 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:vehicleJourneys ;
            netex:xsdSequenceOrder 16 ],
        [ a owl:Restriction ;
            rdfs:comment "FREQUENCY GROUPs In frame. Can be used to template VEHICLE JOURNEYs." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:frequencyGroups ;
            netex:xsdSequenceOrder 17 ],
        [ a owl:Restriction ;
            rdfs:comment "Groupings of Journeys In frame. Can be used to define inbound and outbound beds for a matrix presentation of the JORUNEYs in the TIMETABLE." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:groupsOfServices ;
            netex:xsdSequenceOrder 18 ],
        [ a owl:Restriction ;
            rdfs:comment "TRAIN NUMBERs in frame." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:trainNumbers ;
            netex:xsdSequenceOrder 19 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:headwayService ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:journeyPartCouples ;
            netex:xsdSequenceOrder 20 ],
        [ a owl:Restriction ;
            rdfs:comment "COUPLED JOURNEYs in frame." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:coupledJourneys ;
            netex:xsdSequenceOrder 21 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:serviceFacilitySets ;
            netex:xsdSequenceOrder 22 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:restrictedServiceFacilitySets ;
            netex:xsdSequenceOrder 23 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:deckPlanAssignments ;
            netex:xsdSequenceOrder 24 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:typesOfService ;
            netex:xsdSequenceOrder 25 ],
        [ a owl:Restriction ;
            rdfs:comment "FLEXIBLE SERVICE PROPERTIES in frame." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:flexibleServiceProperties ;
            netex:xsdSequenceOrder 26 ],
        [ a owl:Restriction ;
            rdfs:comment "VEHICLE JOURNEY STOP ASSIGNMENTs in frame." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:vehicleJourneyStopAssignments ;
            netex:xsdSequenceOrder 27 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:notices ;
            netex:xsdSequenceOrder 28 ],
        [ a owl:Restriction ;
            rdfs:comment "NOTICE ASSIGNMENTs in frame." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:noticeAssignments ;
            netex:xsdSequenceOrder 29 ],
        [ a owl:Restriction ;
            rdfs:comment "Whether VEHICLE JOURNEYs of line are normally monitored. Provides a default value for the Monitored element on individual journeys of the timetable." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:monitored ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            rdfs:comment "JOURNEY MEETINGs in frame." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:journeyMeetings ;
            netex:xsdSequenceOrder 30 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:journeyInterchanges ;
            netex:xsdSequenceOrder 31 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:defaultInterchanges ;
            netex:xsdSequenceOrder 32 ],
        [ a owl:Restriction ;
            rdfs:comment "INTERCHANGE RULEs in frame." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:interchangeRules ;
            netex:xsdSequenceOrder 33 ],
        [ a owl:Restriction ;
            rdfs:comment "VEHICLE TYPEs in frame." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:vehicleTypes ;
            netex:xsdSequenceOrder 34 ],
        [ a owl:Restriction ;
            rdfs:comment "Default JOURNEY ACCOUNTING values for JOURNEYs in frame." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:journeyAccountings ;
            netex:xsdSequenceOrder 35 ],
        [ a owl:Restriction ;
            rdfs:comment "OCCUPANCYs in frame." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:occupancies ;
            netex:xsdSequenceOrder 36 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:networkView ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:lineView ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:operatorView ;
            netex:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:serviceCalendarFrameRef ;
            netex:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:defaultMode ;
            netex:xsdSequenceOrder 8 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:journeyAccountingRef ;
            netex:xsdSequenceOrder 9 ],
        netex:Common_VersionFrameStructure .

netex:TimetabledPassingTimeRefStructure a owl:Class ;
    rdfs:label "TimetabledPassingTime" ;
    rdfs:comment "Type for a reference to a TIMETABLED PASSING TIME." ;
    rdfs:subClassOf netex:PassingTimeRefStructure .

netex:TimetabledPassingTime_VersionedChildStructure a owl:Class ;
    rdfs:label "TimetabledPassingTime" ;
    rdfs:comment "Type for TIMETABLED PASSING TIME." ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:comment "Timetabled arrival time." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:arrivalTime ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:earliestDepartureDayOffset ;
            netex:xsdSequenceOrder 10 ],
        [ a owl:Restriction ;
            rdfs:comment "OCCUPANCYs associated with this journey. +v2.0" ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:occupancies ;
            netex:xsdSequenceOrder 11 ],
        [ a owl:Restriction ;
            rdfs:comment "Number of days after the starting time of the journey if not same calendar day. Default is 0 for same day." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:arrivalDayOffset ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            rdfs:comment "Timetabled departure time." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:departureTime ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            rdfs:comment "Number of days after the starting time of the journey if not same calendar day. Default is 0 for same day." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:departureDayOffset ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:waitingTime ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:headway ;
            netex:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:latestArrivalTime ;
            netex:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:latestArrivalDayOffset ;
            netex:xsdSequenceOrder 8 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:earliestDepartureTime ;
            netex:xsdSequenceOrder 9 ],
        netex:PassingTime_VersionedChildStructure .

netex:TimetabledPassingTime_ViewStructure a owl:Class ;
    rdfs:label "TimetabledPassingTime_View" ;
    rdfs:comment "Type for Simplified TIMETABLED PASSING TIME." ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:comment "Timetabled Arrival time." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:arrivalTime ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            rdfs:comment "Arrival Day Offset from Start of Journey." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:arrivalDayOffset ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            rdfs:comment "Timetabled departure time." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:departureTime ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            rdfs:comment "Number of days after the starting departure time of the journey if not same calendar day. Default is 0 for same day." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:departureDayOffset ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:waitingTime ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:headway ;
            netex:xsdSequenceOrder 6 ],
        netex:PassingTime_ViewStructure .

