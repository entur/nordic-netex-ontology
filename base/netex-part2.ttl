            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:endTime ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            rdfs:comment "Day offset of end time from current OPERATING DAY." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:endTimeDayOffset ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:typeOfCoupling ;
            netex:xsdSequenceOrder 5 ],
        netex:BlockPart_VersionStructure .

