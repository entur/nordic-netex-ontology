@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix netex: <https://netex-cen.eu/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

netex:AccountableElement a owl:Class ;
    rdfs:label "AccountableElement" ;
    rdfs:subClassOf netex:AccountableElementStructure ;
    netex:xsdElement true .

netex:AccountableElementRef a owl:Class ;
    rdfs:label "AccountableElementRef" ;
    rdfs:subClassOf netex:AccountableElementRefStructure ;
    netex:xsdElement true .

netex:ArrivalStructure a owl:Class ;
    rdfs:label "Arrival" ;
    rdfs:comment "Reorganisation of Passing times as arrival." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:time ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:timebandRef ;
            netex:xsdSequenceOrder 10 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:dutyPartRef ;
            netex:xsdSequenceOrder 11 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:passengerStopAssignmentRef ;
            netex:xsdSequenceOrder 12 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:quayAssignmentView ;
            netex:xsdSequenceOrder 13 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:dynamicStopAssignment ;
            netex:xsdSequenceOrder 14 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:accessibilityAssessment ;
            netex:xsdSequenceOrder 15 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:checkConstraint ;
            netex:xsdSequenceOrder 16 ],
        [ a owl:Restriction ;
            rdfs:comment "NOTICEs of a CALL that apply only to the Arrival or departure." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:noticeAssignments ;
            netex:xsdSequenceOrder 17 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:passengerAtStopTimes ;
            netex:xsdSequenceOrder 18 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:dayOffset ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:forAlighting ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:isFlexible ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:journeyPartRef ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:journeyMeetings ;
            netex:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:interchanges ;
            netex:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:interchangeRules ;
            netex:xsdSequenceOrder 8 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:timeDemandTypeRef ;
            netex:xsdSequenceOrder 9 ] .

netex:BlockPartRef a owl:Class ;
    rdfs:label "BlockPartRef" ;
    rdfs:subClassOf netex:BlockPartRefStructure ;
    netex:xsdElement true .

netex:BlockRef a owl:Class ;
    rdfs:label "BlockRef" ;
    rdfs:subClassOf netex:BlockRefStructure ;
    netex:xsdElement true .

netex:Call a owl:Class ;
    rdfs:label "Call" ;
    rdfs:subClassOf netex:Call_VersionedChildStructure ;
    netex:xsdElement true .

netex:CallRef a owl:Class ;
    rdfs:label "CallRef" ;
    rdfs:subClassOf netex:CallRefStructure ;
    netex:xsdElement true .

netex:CompoundBlockRef a owl:Class ;
    rdfs:label "CompoundBlockRef" ;
    rdfs:subClassOf netex:CompoundBlockRefStructure ;
    netex:xsdElement true .

netex:ConnectingJourneyView a owl:Class ;
    rdfs:label "ConnectingJourneyView" ;
    rdfs:subClassOf netex:ConnectingServiceJourney_DerivedViewStructure ;
    netex:xsdElement true .

netex:ConnectingServiceJourneyView a owl:Class ;
    rdfs:label "ConnectingServiceJourneyView" ;
    rdfs:subClassOf netex:ConnectingServiceJourney_DerivedViewStructure ;
    netex:xsdElement true .

netex:ConnectionCertaintyEnumeration a rdfs:Datatype ;
    rdfs:label "ConnectionCertaintyEnumeration" ;
    rdfs:comment "Allowed values for Guaranteed." ;
    owl:oneOf ( "guaranteed" "normallyGuaranteed" "notGuaranteed" "neverGuaranteed" ) .

netex:CoupledJourneyRef a owl:Class ;
    rdfs:label "CoupledJourneyRef" ;
    rdfs:subClassOf netex:CoupledJourneyRefStructure ;
    netex:xsdElement true .

netex:CourseOfJourneysRef a owl:Class ;
    rdfs:label "CourseOfJourneysRef" ;
    rdfs:subClassOf netex:CourseOfJourneysRefStructure ;
    netex:xsdElement true .

netex:DatedPassingTime a owl:Class ;
    rdfs:label "DatedPassingTime" ;
    rdfs:subClassOf netex:DatedPassingTime_VersionedChildStructure ;
    netex:xsdElement true .

netex:DatedServiceJourney a owl:Class ;
    rdfs:label "DatedServiceJourney" ;
    rdfs:subClassOf netex:DatedServiceJourney_VersionStructure ;
    netex:xsdElement true .

netex:DatedSpecialServiceRef a owl:Class ;
    rdfs:label "DatedSpecialServiceRef" ;
    rdfs:subClassOf netex:DatedSpecialServiceRefStructure ;
    netex:xsdElement true .

netex:DatedSpecialServiceRefs_RelStructure a owl:Class ;
    rdfs:label "DatedSpecialServiceRefs_Rel" ;
    rdfs:comment "Type for a list references to a DATED SPECIAL SERVICE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:datedSpecialServiceRef ;
            netex:xsdSequenceOrder 1 ],
        netex:oneToManyRelationshipStructure .

netex:DatedVehicleJourneyRef a owl:Class ;
    rdfs:label "DatedVehicleJourneyRef" ;
    rdfs:subClassOf netex:VehicleJourneyRefStructure ;
    netex:xsdElement true .

netex:DatedVehicleJourneyRefStructure a owl:Class ;
    rdfs:label "DatedVehicleJourney" ;
    rdfs:comment "Type for a reference to a DATED VEHICLE JOURNEY." ;
    rdfs:subClassOf netex:VehicleJourneyRefStructure .

netex:DeadRunCallPartStructure a owl:Class ;
    rdfs:label "DeadRunCallPart" ;
    rdfs:comment "Type for DEAD RUN CALL part." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:time ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            rdfs:comment "Number of days of arrival time after the starting day journey if not same calendar day. Default is 0 for same day." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:dayOffset ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:waitTime ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:journeyPartRef ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:timeDemandTypeRef ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:dutyPartRef ;
            netex:xsdSequenceOrder 6 ] .

netex:DeadRunCall_VersionedChildStructure a owl:Class ;
    rdfs:label "DeadRunCall" ;
    rdfs:comment "Data type for DEAD RUN CALL." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:pointRef ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:changeOfDestinationDisplay ;
            netex:xsdSequenceOrder 10 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:changeOfServiceRequirements ;
            netex:xsdSequenceOrder 11 ],
        [ a owl:Restriction ;
            rdfs:comment "NOTICEs for POINT IN JOURNEY PATTERN." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:noticeAssignments ;
            netex:xsdSequenceOrder 12 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:requestStop ;
            netex:xsdSequenceOrder 13 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:requestMethod ;
            netex:xsdSequenceOrder 14 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:boardingRequestMethod ;
            netex:xsdSequenceOrder 15 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:alightingRequestMethod ;
            netex:xsdSequenceOrder 16 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:stopUse ;
            netex:xsdSequenceOrder 17 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:bookingArrangements ;
            netex:xsdSequenceOrder 18 ],
        [ a owl:Restriction ;
            rdfs:comment "Booking Arrangements for stop if different from those for SERVICE JOURNEY. DEPRECATED: use bookingArrangements instead" ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:bookingArrangements ;
            netex:xsdSequenceOrder 19 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:scheduledStopPointView ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:print ;
            netex:xsdSequenceOrder 20 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:dynamic ;
            netex:xsdSequenceOrder 21 ],
        [ a owl:Restriction ;
            rdfs:comment "Text annotation that applies to this DEAD RUN CALL. This is for internal use. Customer facing should be added to footnote." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:note ;
            netex:xsdSequenceOrder 22 ],
        [ a owl:Restriction ;
            rdfs:comment "Point in JOURNEY PATTERN upon which this DEAD RUN CALL is based. Can be used to obtain full association sets." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:pointInJourneyPatternRef ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            rdfs:comment "Arrival at DEAD RUN CALL." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:arrival ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            rdfs:comment "Departure from a DEAD RUN CALL." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:departure ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:destinationDisplayRef ;
            netex:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:destinationDisplayView ;
            netex:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:vias ;
            netex:xsdSequenceOrder 8 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:flexiblePointProperties ;
            netex:xsdSequenceOrder 9 ],
        netex:VersionedChildStructure .

netex:DeadRunEndpointStructure a owl:Class ;
    rdfs:label "DeadRunEndpoint" ;
    rdfs:comment "Type for DEAD RUN ENDPOINT (Production Timetable Service). Should not Contradict EDEAD RUN JOURNEY PATTERN." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:pointRef ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:typeOfPointRef ;
            netex:xsdSequenceOrder 2 ] .

netex:DeadRunRef a owl:Class ;
    rdfs:label "DeadRunRef" ;
    rdfs:subClassOf netex:DeadRunRefStructure ;
    netex:xsdElement true .

netex:DeadRunTypeEnumeration a rdfs:Datatype ;
    rdfs:label "DeadRunTypeEnumeration" ;
    rdfs:comment "Allowed values for DEAD RUN. type." ;
    owl:oneOf ( "garageRunOut" "garageRunIn" "turningManoeuvre" "other" ) .

netex:DeckEntranceAssignment a owl:Class ;
    rdfs:label "DeckEntranceAssignment" ;
    rdfs:subClassOf netex:DeckEntranceAssignment_VersionStructure ;
    netex:xsdElement true .

netex:DeckPlanAssignmentRef a owl:Class ;
    rdfs:label "DeckPlanAssignmentRef" ;
    rdfs:subClassOf netex:DeckPlanAssignmentRefStructure ;
    netex:xsdElement true .

netex:DefaultDeadRunRunTime a owl:Class ;
    rdfs:label "DefaultDeadRunRunTime" ;
    rdfs:subClassOf netex:DefaultDeadRunRunTime_VersionedChildStructure ;
    netex:xsdElement true .

netex:DefaultInterchange a owl:Class ;
    rdfs:label "DefaultInterchange" ;
    rdfs:subClassOf netex:DefaultInterchange_VersionStructure ;
    netex:xsdElement true .

netex:DefaultInterchangeRef a owl:Class ;
    rdfs:label "DefaultInterchangeRef" ;
    rdfs:subClassOf netex:DefaultInterchangeRefStructure ;
    netex:xsdElement true .

netex:DefaultServiceJourneyRunTime a owl:Class ;
    rdfs:label "DefaultServiceJourneyRunTime" ;
    rdfs:subClassOf netex:DefaultServiceJourneyRunTime_VersionedChildStructure ;
    netex:xsdElement true .

netex:DepartureStructure a owl:Class ;
    rdfs:label "Departure" ;
    rdfs:comment "Reorganisation of Passing times as Departure." ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:comment "Timetabled departure time - Earliest time to depart." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:time ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:timeDemandTypeRef ;
            netex:xsdSequenceOrder 10 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:timebandRef ;
            netex:xsdSequenceOrder 11 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:dutyPartRef ;
            netex:xsdSequenceOrder 12 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:passengerStopAssignmentRef ;
            netex:xsdSequenceOrder 13 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:quayAssignmentView ;
            netex:xsdSequenceOrder 14 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:dynamicStopAssignment ;
            netex:xsdSequenceOrder 15 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:accessibilityAssessment ;
            netex:xsdSequenceOrder 16 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:checkConstraint ;
            netex:xsdSequenceOrder 17 ],
        [ a owl:Restriction ;
            rdfs:comment "NOTICEs of a CALL that apply only to the Arrival or departure." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:noticeAssignments ;
            netex:xsdSequenceOrder 18 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:passengerAtStopTimes ;
            netex:xsdSequenceOrder 19 ],
        [ a owl:Restriction ;
            rdfs:comment "Number of days of departure time after the starting day of the journey, if not same calendar day. Default is 0 for same dayi." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:dayOffset ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            rdfs:comment "OCCUPANCYs associated with this journey. +v2.0" ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:occupancies ;
            netex:xsdSequenceOrder 20 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:forBoarding ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:isFlexible ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:waitTime ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:journeyPartRef ;
            netex:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:journeyMeetings ;
            netex:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:interchanges ;
            netex:xsdSequenceOrder 8 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:interchangeRules ;
            netex:xsdSequenceOrder 9 ] .

netex:DriverRef a owl:Class ;
    rdfs:label "DriverRef" ;
    rdfs:subClassOf netex:DriverRefStructure ;
    netex:xsdElement true .

netex:DriverScheduleFrame a owl:Class ;
    rdfs:label "DriverScheduleFrame" ;
    rdfs:subClassOf netex:DriverSchedule_VersionFrameStructure ;
    netex:xsdElement true .

netex:DriverScheduleFrameRef a owl:Class ;
    rdfs:label "DriverScheduleFrameRef" ;
    rdfs:subClassOf netex:DriverScheduleFrameRefStructure ;
    netex:xsdElement true .

netex:DriverTripRef a owl:Class ;
    rdfs:label "DriverTripRef" ;
    rdfs:subClassOf netex:DriverTripRefStructure ;
    netex:xsdElement true .

netex:DriverTripTimeRef a owl:Class ;
    rdfs:label "DriverTripTimeRef" ;
    rdfs:subClassOf netex:DriverTripTimeRefStructure ;
    netex:xsdElement true .

netex:DutyPartRef a owl:Class ;
    rdfs:label "DutyPartRef" ;
    rdfs:subClassOf netex:DutyPartRefStructure ;
    netex:xsdElement true .

netex:DutyRef a owl:Class ;
    rdfs:label "DutyRef" ;
    rdfs:subClassOf netex:DutyRefStructure ;
    netex:xsdElement true .

netex:DynamicStopAssignment a owl:Class ;
    rdfs:label "DynamicStopAssignment" ;
    rdfs:subClassOf netex:DynamicStopAssignment_VersionStructure ;
    netex:xsdElement true .

netex:DynamicStopAssignmentRef a owl:Class ;
    rdfs:label "DynamicStopAssignmentRef" ;
    rdfs:subClassOf netex:DynamicStopAssignmentRefStructure ;
    netex:xsdElement true .

netex:EstimatedPassingTimeRef a owl:Class ;
    rdfs:label "EstimatedPassingTimeRef" ;
    rdfs:subClassOf netex:EstimatedPassingTimeRefStructure ;
    netex:xsdElement true .

netex:FlexibleServiceAssignmentRef a owl:Class ;
    rdfs:label "FlexibleServiceAssignmentRef" ;
    rdfs:subClassOf netex:FlexibleServiceAssignmentRefStructure ;
    netex:xsdElement true .

netex:FlexibleServiceEnumeration a rdfs:Datatype ;
    rdfs:label "FlexibleServiceEnumeration" ;
    rdfs:comment "Allowed values for flexible service type: FixedPassingTimes, DynamicPassingTimes, FixedHeadwayFrequency." ;
    owl:oneOf ( "dynamicPassingTimes" "fixedHeadwayFrequency" "fixedPassingTimes" "notFlexible" "other" ) .

netex:FlexibleServicePropertiesRef a owl:Class ;
    rdfs:label "FlexibleServicePropertiesRef" ;
    rdfs:subClassOf netex:FlexibleServicePropertiesRefStructure ;
    netex:xsdElement true .

netex:FlexibleStopAssignment a owl:Class ;
    rdfs:label "FlexibleStopAssignment" ;
    rdfs:subClassOf netex:FlexibleStopAssignment_VersionStructure ;
    netex:xsdElement true .

netex:FrequencyStructure a owl:Class ;
    rdfs:label "Frequency" ;
    rdfs:comment "Type for a HEADWAY INTERVAL." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:scheduledHeadwayInterval ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:minimumHeadwayInterval ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:maximumHeadwayInterval ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:headwayDisplay ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:frequencyRegulated ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            rdfs:comment "Descriptive phrase to use for frequency. e.g. \"Every x minus\" If not specified generate from individual elements." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:description ;
            netex:xsdSequenceOrder 6 ] .

netex:GroupOfServicesEndPoint_DerivedViewStructure a owl:Class ;
    rdfs:label "GroupOfServicesEndPoint" ;
    rdfs:comment "Type for SIMPLE SCHEDULED STOP POINT VIEW." ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:comment "Name of Stop Point." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:name ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:scheduledStopPointRef ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:destinationDisplayRef ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:topographicPlaceView ;
            netex:xsdSequenceOrder 4 ],
        netex:DerivedViewStructure .

netex:GroupOfServicesMemberStructure a owl:Class ;
    rdfs:label "GroupOfServicesMember" ;
    rdfs:comment "Type for a Member of GROUP OF SERVICE Member." ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:comment "Parent GROUP OF SERVICEs to which this GROUP OF SERVICEs MEMBER assigns a JOURNEY." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:groupOfServicesRef ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:journeyRef ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:trainNumberRef ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:journeyDesignator ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:serviceDesignator ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            rdfs:comment "NOTICEs Relevant for this grouping." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:noticeAssignments ;
            netex:xsdSequenceOrder 6 ],
        netex:AbstractGroupMember_VersionedChildStructure .

