netex:VehicleServiceRefStructure a owl:Class ;
    rdfs:label "VehicleService" ;
    rdfs:comment "Type for Reference to a VEHICLE SERVICE." ;
    rdfs:subClassOf netex:VersionOfObjectRefStructure .

netex:VehicleService_VersionStructure a owl:Class ;
    rdfs:label "VehicleService" ;
    rdfs:comment "Type for VEHICLE SERVICE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:comment "Name of VEHICLE SERVICE." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:name ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            rdfs:comment "Description of VEHICLE SERVICE." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:description ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:vehicleServiceParts ;
            netex:xsdSequenceOrder 3 ],
        netex:DataManagedObjectStructure .

netex:VehicleTypeStopAssignment a owl:Class ;
    rdfs:label "VehicleTypeStopAssignment" ;
    rdfs:subClassOf netex:VehicleTypeStopAssignment_VersionStructure ;
    netex:xsdElement true .

netex:VehicleTypeStopAssignmentRefStructure a owl:Class ;
    rdfs:label "VehicleTypeStopAssignment" ;
    rdfs:comment "Type for a reference to a VEHICLE TYPE STOP ASSIGNMENT." ;
    rdfs:subClassOf netex:StopAssignmentRefStructure .

netex:VehicleTypeStopAssignment_VersionStructure a owl:Class ;
    rdfs:label "VehicleTypeStopAssignment" ;
    rdfs:comment "Type for VEHICLE TYPE STOP ASSIGNMENT." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:vehicleOrientation ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:vehicleStoppingPositionRef ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:vehicleJourneyRef ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:transportTypeRef ;
            netex:xsdSequenceOrder 4 ],
        netex:StopAssignment_VersionStructure .

