    rdfs:label "SpecialServiceRef" ;
    rdfs:range netex:SpecialService ;
    netex:isReference true ;
    netex:xsdType "SpecialServiceRefStructure" .

netex:stopAreaRef a owl:ObjectProperty ;
    rdfs:label "StopAreaRef" ;
    rdfs:comment "Identifier of a Place at end point of transfer." ;
    rdfs:range netex:StopArea ;
    netex:isReference true ;
    netex:xsdType "StopAreaRefStructure" .

netex:stopPlaceRef a owl:ObjectProperty ;
    rdfs:label "StopPlaceRef" ;
    rdfs:range netex:StopPlace ;
    netex:isReference true ;
    netex:xsdType "StopPlaceRefStructure" .

netex:stopUse a owl:DatatypeProperty ;
    rdfs:label "StopUse" ;
    rdfs:comment "Nature of use of stop, e.g. access, interchange only, or pass through. Default is Access." ;
    rdfs:range xsd:NMTOKEN ;
    netex:xsdType "StopUseEnumeration" .

netex:templateServiceJourney a owl:ObjectProperty ;
    rdfs:label "TemplateServiceJourney" ;
    netex:xsdType "TemplateServiceJourney_VersionStructure" .

netex:templateVehicleJourneyType a owl:DatatypeProperty ;
    rdfs:label "TemplateVehicleJourneyType" ;
    rdfs:comment "Type of TEMPLATE VEHICLE JOURNEY." ;
    rdfs:range xsd:NMTOKEN ;
    netex:xsdType "TemplateVehicleJourneyTypeEnumeration" .

netex:timeDemandTypeAssignments a owl:ObjectProperty ;
    rdfs:label "timeDemandTypeAssignments" ;
    rdfs:comment "TIME DEMAND TYPE ASSIGNMENTs in frame." ;
    netex:xsdType "timeDemandTypeAssignmentsInFrame_RelStructure" .

netex:timingAlgorithmTypeRef a owl:ObjectProperty ;
    rdfs:label "TimingAlgorithmTypeRef" ;
    rdfs:range netex:TimingAlgorithmType ;
    netex:isReference true ;
    netex:xsdType "TimingAlgorithmTypeRefStructure" .

netex:timingLinkGroups a owl:ObjectProperty ;
    rdfs:label "timingLinkGroups" ;
    rdfs:comment "TIMING LINK GROUPs in frame." ;
    netex:xsdType "groupOfLinksInFrame_RelStructure" .

netex:toJourneyRef a owl:ObjectProperty ;
    rdfs:label "ToJourneyRef" ;
    rdfs:comment "DEPRECATE: JOURNEY that distributes from JOURNEY MEETING. -v2.0" ;
    netex:isReference true ;
    netex:xsdType "JourneyRefStructure" .

netex:toServiceJourneyRef a owl:ObjectProperty ;
    rdfs:label "ToServiceJourneyRef" ;
    rdfs:comment "SERVICE JOURNEY that distributes from JOURNEY MEETING. +v2.0" ;
    netex:isReference true ;
    netex:xsdType "ServiceJourneyRefStructure" .

netex:toVisitNumber a owl:DatatypeProperty ;
    rdfs:label "ToVisitNumber" ;
    rdfs:comment "Visit number to distinguish which visit to TO SCHEDULED STOP POINT this is. Default is one. Only needed for circular routes with connections at the same stop on different visits." ;
    rdfs:range xsd:nonNegativeInteger ;
    netex:xsdType "xsd:nonNegativeInteger" .

netex:trainComponentLabelAssignmentRef a owl:ObjectProperty ;
    rdfs:label "TrainComponentLabelAssignmentRef" ;
    rdfs:range netex:TrainComponentLabelAssignment ;
    netex:isReference true ;
    netex:xsdType "TrainComponentLabelAssignmentRefStructure" .

netex:trainComponentRef a owl:ObjectProperty ;
    rdfs:label "TrainComponentRef" ;
    rdfs:range netex:TrainComponent ;
    netex:isReference true ;
    netex:xsdType "TrainComponentRefStructure" .

netex:trainElementTypeRef a owl:ObjectProperty ;
    rdfs:label "TrainElementTypeRef" ;
    netex:isReference true ;
    netex:xsdType "TrainElementTypeRefStructure" .

netex:trainSize a owl:ObjectProperty ;
    rdfs:label "TrainSize" ;
    netex:xsdType "TrainSizeStructure" .

netex:transportOrganisationRef a owl:ObjectProperty ;
    rdfs:label "TransportOrganisationRef" ;
    rdfs:range netex:TransportOrganisation ;
    netex:isReference true ;
    netex:xsdType "TransportOrganisationRefStructure" .

netex:typeOfFlexibleServiceRef a owl:ObjectProperty ;
    rdfs:label "TypeOfFlexibleServiceRef" ;
    rdfs:range netex:TypeOfFlexibleService ;
    netex:isReference true ;
    netex:xsdType "TypeOfFlexibleServiceRefStructure" .

netex:typeOfProductCategoryRef a owl:ObjectProperty ;
    rdfs:label "TypeOfProductCategoryRef" ;
    rdfs:range netex:TypeOfProductCategory ;
    netex:isReference true ;
    netex:xsdType "TypeOfProductCategoryRefStructure" .

netex:vehicleEquipmentProfileRef a owl:ObjectProperty ;
    rdfs:label "VehicleEquipmentProfileRef" ;
    rdfs:range netex:VehicleEquipmentProfile ;
    netex:isReference true ;
    netex:xsdType "VehicleEquipmentProfileRefStructure" .

netex:vehicleJourneyStopAssignments a owl:ObjectProperty ;
    rdfs:label "vehicleJourneyStopAssignments" ;
    rdfs:comment "Normal VEHICLE STOP ASSIGNMENTs for VEHICLE JOURNEY, +v1.1" ;
    netex:xsdType "vehicleJourneyStopAssignments_RelStructure" .

netex:vehicleOrientation a owl:DatatypeProperty ;
    rdfs:label "VehicleOrientation" ;
    rdfs:comment "Relative orientation of vehicle - Default is forwards." ;
    rdfs:range xsd:normalizedString ;
    netex:xsdType "VehicleOrientationEnumeration" .

netex:vehicleRef a owl:ObjectProperty ;
    rdfs:label "VehicleRef" ;
    rdfs:comment "VehicleTypeRef is the normally used field, as in many cases only the VEHICLE TYPE is known in advance. VehicleRef is then the exception and used only when the concrete VEHICLE is known in advance. Then also only one vehicle is possible." ;
    rdfs:range netex:Vehicle ;
    netex:isReference true ;
    netex:xsdType "VehicleRefStructure" .

netex:vehicleServicePartRef a owl:ObjectProperty ;
    rdfs:label "VehicleServicePartRef" ;
    rdfs:range netex:VehicleServicePart ;
    netex:isReference true ;
    netex:xsdType "VehicleServicePartRefStructure" .

netex:vehicleTypes a owl:ObjectProperty ;
    rdfs:label "vehicleTypes" ;
    rdfs:comment "TYPES OF VEHICLE possibly compatible with this recharging plan and step." ;
    netex:xsdType "vehicleTypeRefs_RelStructure" .

netex:vias a owl:ObjectProperty ;
    rdfs:label "vias" ;
    rdfs:comment "Destinations that the SERVICE goes via." ;
    netex:xsdType "vias_RelStructure" .

netex:waitTime a owl:DatatypeProperty ;
    rdfs:label "WaitTime" ;
    rdfs:comment "Timetabled waiting interval." ;
    rdfs:range xsd:duration ;
    netex:xsdType "xsd:duration" .

netex:waitTimes a owl:ObjectProperty ;
    rdfs:label "waitTimes" ;
    rdfs:comment "WAIT TIMEs for VEHICLE JOURNEY at different TIMING POINTs." ;
    netex:xsdType "vehicleJourneyWaitTimes_RelStructure" .

netex:waitingTime a owl:DatatypeProperty ;
    rdfs:label "WaitingTime" ;
    rdfs:comment "Timetabled waiting interval." ;
    rdfs:range xsd:duration ;
    netex:xsdType "xsd:duration" .

netex:JourneyFrequencyGroupRefStructure a owl:Class ;
    rdfs:label "JourneyFrequencyGroup" ;
    rdfs:comment "Type for a reference to a JOURNEY FREQUENCY GROUP." ;
    rdfs:subClassOf netex:GroupOfEntitiesRefStructure .

netex:JourneyFrequencyGroup_VersionStructure a owl:Class ;
    rdfs:label "JourneyFrequencyGroup" ;
    rdfs:comment "Type for JOURNEY FREQUENCY GROUP." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:firstDepartureTime ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:journeys ;
            netex:xsdSequenceOrder 10 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:firstDayOffset ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:lastDepartureTime ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:lastDayOffset ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:firstArrivalTime ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            rdfs:comment "Offset days for the first arrival time. Number of days after the first arrival time of the journey if not same calendar day. Default is 0 for the same day." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:firstDayOffset ;
            netex:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:lastArrivalTime ;
            netex:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            rdfs:comment "Offset days for the last arrival time. Number of days after the last arrival time of the journey if not same calendar day. Default is 0 for the same day." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:lastDayOffset ;
            netex:xsdSequenceOrder 8 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:timeDemandTypes ;
            netex:xsdSequenceOrder 9 ],
        netex:GroupOfEntities_VersionStructure ;
    netex:abstract true .

netex:PassingTime_ViewStructure a owl:Class ;
    rdfs:label "PassingTime_View" ;
    rdfs:comment "Type for Simplified TARGET PASSING TIME." ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:comment "Number of days after the starting departure time of the journey if not same calendar day. Default is 0 for same day." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:dayOffset ;
            netex:xsdSequenceOrder 1 ],
        netex:DataManagedObject_ViewStructure .

netex:ServiceJourney_VersionStructure a owl:Class ;
    rdfs:label "ServiceJourney" ;
    rdfs:comment "Data type for a planned VEHICLE JOURNEY (Production Timetable Service)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:serviceAlteration ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:timingAlgorithmTypeRef ;
            netex:xsdSequenceOrder 10 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:journeyFrequencyGroupRef ;
            netex:xsdSequenceOrder 11 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:vehicleTypeRef ;
            netex:xsdSequenceOrder 12 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:vehicleEquipmentProfileRef ;
            netex:xsdSequenceOrder 13 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:vehicleRef ;
            netex:xsdSequenceOrder 14 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:operationalContextRef ;
            netex:xsdSequenceOrder 15 ],
        [ a owl:Restriction ;
            rdfs:comment "Reference to a BLOCK." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:blockRef ;
            netex:xsdSequenceOrder 16 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:courseOfJourneysRef ;
            netex:xsdSequenceOrder 17 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:publicCode ;
            netex:xsdSequenceOrder 18 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:operatorRef ;
            netex:xsdSequenceOrder 19 ],
        [ a owl:Restriction ;
            rdfs:comment "Time of departure." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:departureTime ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:operatorView ;
            netex:xsdSequenceOrder 20 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:lineRef ;
            netex:xsdSequenceOrder 21 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:lineView ;
            netex:xsdSequenceOrder 22 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:flexibleLineView ;
            netex:xsdSequenceOrder 23 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:directionType ;
            netex:xsdSequenceOrder 24 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:journeyPatternView ;
            netex:xsdSequenceOrder 25 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:groupsOfServices ;
            netex:xsdSequenceOrder 26 ],
        [ a owl:Restriction ;
            rdfs:comment "Other TIME DEMAND TYPEs used in journey." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:timeDemandTypes ;
            netex:xsdSequenceOrder 27 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:trainNumbers ;
            netex:xsdSequenceOrder 28 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:origin ;
            netex:xsdSequenceOrder 29 ],
        [ a owl:Restriction ;
            rdfs:comment "Day offset if day of departure time of VEHICLE JOURNEY differs from the current OPERATING DAY." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:departureDayOffset ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:destination ;
            netex:xsdSequenceOrder 30 ],
        [ a owl:Restriction ;
            rdfs:comment "Whether the journey is included in printed media. Default is true." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:print ;
            netex:xsdSequenceOrder 31 ],
        [ a owl:Restriction ;
            rdfs:comment "When SERVICE JOURNEY is to be publicised in dynamic media. Default is always." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:dynamic ;
            netex:xsdSequenceOrder 32 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:waitTimes ;
            netex:xsdSequenceOrder 33 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:runTimes ;
            netex:xsdSequenceOrder 34 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:layovers ;
            netex:xsdSequenceOrder 35 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:passingTimes ;
            netex:xsdSequenceOrder 36 ],
        [ a owl:Restriction ;
            rdfs:comment "Times for passenger to be at stop if earlier than departure time. +v2.0" ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:passengerAtStopTimes ;
            netex:xsdSequenceOrder 37 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:parts ;
            netex:xsdSequenceOrder 38 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:calls ;
            netex:xsdSequenceOrder 39 ],
        [ a owl:Restriction ;
            rdfs:comment "Frequency of Journey." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:frequency ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            rdfs:comment "FACILITies available associated with JOURNEY." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:facilities ;
            netex:xsdSequenceOrder 40 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:checkConstraints ;
            netex:xsdSequenceOrder 41 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:passengerCarryingRequirementRef ;
            netex:xsdSequenceOrder 42 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:passengerCarryingRequirementsView ;
            netex:xsdSequenceOrder 43 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:trainSize ;
            netex:xsdSequenceOrder 44 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:equipments ;
            netex:xsdSequenceOrder 45 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:flexibleServicePropertiesRef ;
            netex:xsdSequenceOrder 46 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:flexibleServiceProperties ;
            netex:xsdSequenceOrder 47 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:journeyDuration ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            rdfs:comment "DAY TYPEs for Journey." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:dayTypes ;
            netex:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:routeRef ;
            netex:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            rdfs:comment "Reference to a JOURNEY PATTERN." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:journeyPatternRef ;
            netex:xsdSequenceOrder 8 ],
        [ a owl:Restriction ;
            rdfs:comment "Reference to a TIME DEMAND TYPE used at start of JOURNEY." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:timeDemandTypeRef ;
            netex:xsdSequenceOrder 9 ],
        netex:Journey_VersionStructure .

netex:advertised a owl:DatatypeProperty ;
    rdfs:label "Advertised" ;
    rdfs:comment "Whether INTERCHANGE is advertised as an interchange. Default is true." ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:connectingJourneyView a owl:ObjectProperty ;
    rdfs:label "ConnectingJourneyView" ;
    netex:xsdType "ConnectingServiceJourney_DerivedViewStructure" .

netex:connectingLineView a owl:ObjectProperty ;
    rdfs:label "ConnectingLineView" ;
    rdfs:comment "Simplified view of connecting LINE." ;
    netex:xsdType "Line_DerivedViewStructure" .

netex:connectionCertainty a owl:DatatypeProperty ;
    rdfs:label "ConnectionCertainty" ;
    rdfs:comment "Nature of gurantee to conenction." ;
    rdfs:range xsd:NMTOKEN ;
    netex:xsdType "ConnectionCertaintyEnumeration" .

netex:connectionRef a owl:ObjectProperty ;
    rdfs:label "ConnectionRef" ;
    rdfs:comment "Reference to CONNECTION at which JOURNEY MEETING takes place." ;
    rdfs:range netex:Connection ;
    netex:isReference true ;
    netex:xsdType "ConnectionRefStructure" .

netex:controlCentreNotifyThreshold a owl:DatatypeProperty ;
    rdfs:label "ControlCentreNotifyThreshold" ;
    rdfs:comment "Interval before CONTROL CENTRE should be notified associated with SERVICE JOURNEY INTERCHANGE." ;
    rdfs:range xsd:duration ;
    netex:xsdType "xsd:duration" .

netex:controlled a owl:DatatypeProperty ;
    rdfs:label "Controlled" ;
    rdfs:comment "Whether INTERCHANGE is controlled in real-time. Default is true." ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:courseOfJourneysRef a owl:ObjectProperty ;
    rdfs:label "CourseOfJourneysRef" ;
    rdfs:range netex:CourseOfJourneys ;
    netex:isReference true ;
    netex:xsdType "CourseOfJourneysRefStructure" .

netex:crossBorder a owl:DatatypeProperty ;
    rdfs:label "CrossBorder" ;
    rdfs:comment "Whether INTERCHANGE involves crossing an international border. Default is false." ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:datedCalls a owl:ObjectProperty ;
    rdfs:label "datedCalls" ;
    rdfs:comment "CALLs for JOURNEY." ;
    netex:xsdType "calls_RelStructure" .

netex:datedPassingTimes a owl:ObjectProperty ;
    rdfs:label "datedPassingTimes" ;
    rdfs:comment "PASSING TIMEs for JOURNEY." ;
    netex:xsdType "targetPassingTimes_RelStructure" .

netex:dayTypeRef a owl:ObjectProperty ;
    rdfs:label "DayTypeRef" ;
    rdfs:range netex:DayType ;
    netex:isReference true ;
    netex:xsdType "DayTypeRefStructure" .

netex:destinationDisplayView a owl:ObjectProperty ;
    rdfs:label "DestinationDisplayView" ;
    netex:xsdType "DestinationDisplay_DerivedViewStructure" .

netex:directionRef a owl:ObjectProperty ;
    rdfs:label "DirectionRef" ;
    rdfs:range netex:Direction ;
    netex:isReference true ;
    netex:xsdType "DirectionRefStructure" .

netex:directionType a owl:DatatypeProperty ;
    rdfs:label "DirectionType" ;
    rdfs:range xsd:normalizedString ;
    netex:xsdType "DirectionTypeEnumeration" .

netex:earliestTime a owl:DatatypeProperty ;
    rdfs:label "EarliestTime" ;
    rdfs:comment "Earliest time that passenger should be at stop for specified process, e.g. baggage check in, customs etc." ;
    rdfs:range xsd:time ;
    netex:xsdType "xsd:time" .

netex:flexiblePointProperties a owl:ObjectProperty ;
    rdfs:label "FlexiblePointProperties" ;
    netex:xsdType "FlexiblePointProperties_VersionedChildStructure" .

netex:frequencyGroups a owl:ObjectProperty ;
    rdfs:label "frequencyGroups" ;
    rdfs:comment "frequency groups defining Template journey. Can only be of one type." ;
    netex:xsdType "frequencyGroups_RelStructure" .

netex:fromStopPointRef a owl:ObjectProperty ;
    rdfs:label "FromStopPointRef" ;
    rdfs:comment "SCHEDULED STOP POINT feeding INTERCHANGE. If absent apply to all STOP POINTs." ;
    netex:isReference true ;
    netex:xsdType "ScheduledStopPointRefStructure" .

netex:groupsOfServices a owl:ObjectProperty ;
    rdfs:label "groupsOfServices" ;
    rdfs:comment "Grouping of services of a journey - for a multi-part journey only." ;
    netex:xsdType "groupOfServicesRefs_RelStructure" .

netex:guaranteed a owl:DatatypeProperty ;
    rdfs:label "Guaranteed" ;
    rdfs:comment "Whether INTERCHANGE is guaranteed. Default is false." ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:interchangeRules a owl:ObjectProperty ;
    rdfs:label "interchangeRules" ;
    rdfs:comment "INTERCHANGE RULEs for visit." ;
    netex:xsdType "interchangeRules_RelStructure" .

netex:journeyDesignator a owl:ObjectProperty ;
    rdfs:label "JourneyDesignator" ;
    rdfs:comment "Value reference to a JOURNEY or DEAD RUN. Provides an alternative way of identifying a Journey." ;
    netex:xsdType "JourneyDesignatorStructure" .

netex:journeyDuration a owl:DatatypeProperty ;
    rdfs:label "JourneyDuration" ;
    rdfs:comment "Total length of Journey. Can be computed from individual times. Add to Departure time to obtain JOURNEY arrival time." ;
    rdfs:range xsd:duration ;
    netex:xsdType "xsd:duration" .

netex:journeyMeetings a owl:ObjectProperty ;
    rdfs:label "journeyMeetings" ;
    rdfs:comment "JOURNEY MEETINGs for visit." ;
    netex:xsdType "journeyMeetingViews_RelStructure" .

netex:journeyPartCoupleRef a owl:ObjectProperty ;
    rdfs:label "JourneyPartCoupleRef" ;
    rdfs:range netex:JourneyPartCouple ;
    netex:isReference true ;
    netex:xsdType "JourneyPartCoupleRefStructure" .

netex:latestTime a owl:DatatypeProperty ;
    rdfs:label "LatestTime" ;
    rdfs:comment "Latest time that passenger should be at stop for specified process." ;
    rdfs:range xsd:time ;
    netex:xsdType "xsd:time" .

netex:parts a owl:ObjectProperty ;
    rdfs:label "parts" ;
    rdfs:comment "JOURNEY PARTs of a journey - for a multi-part journey only." ;
    netex:xsdType "journeyParts_RelStructure" .

netex:passengerStopAssignmentRef a owl:ObjectProperty ;
    rdfs:label "PassengerStopAssignmentRef" ;
    rdfs:range netex:PassengerStopAssignment ;
    netex:isReference true ;
    netex:xsdType "PassengerStopAssignmentRefStructure" .

netex:planned a owl:DatatypeProperty ;
    rdfs:label "Planned" ;
    rdfs:comment "Whether INTERCHANGE is planned in a timetable. Default is true." ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:privateCode a owl:ObjectProperty ;
    rdfs:label "PrivateCode" ;
    rdfs:comment "DEPRECATED - use privateCodes. -v2.0" ;
    netex:xsdType "PrivateCodeStructure" .

netex:serviceAlterationType a owl:DatatypeProperty ;
    rdfs:label "ServiceAlterationType" ;
    rdfs:comment "Type of Service alteration. Default is planned. +v2.0" ;
    rdfs:range xsd:NMTOKEN ;
    netex:xsdType "ServiceAlterationEnumeration" .

netex:specialService a owl:ObjectProperty ;
    rdfs:label "SpecialService" ;
    netex:xsdType "SpecialService_VersionStructure" .

netex:staySeated a owl:DatatypeProperty ;
    rdfs:label "StaySeated" ;
    rdfs:comment "Whether the passenger can remain in vehicle (i.e. block linking). Default is false: the passenger must change vehicles for this INTERCHANGE. Default is false." ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:timebandRef a owl:ObjectProperty ;
    rdfs:label "TimebandRef" ;
    rdfs:range netex:Timeband ;
    netex:isReference true ;
    netex:xsdType "TimebandRefStructure" .

netex:toStopPointRef a owl:ObjectProperty ;
    rdfs:label "ToStopPointRef" ;
    rdfs:comment "SCHEDULED STOP POINT distributing from INTERCHANGE. If absent apply to all STOP POINTs." ;
    netex:isReference true ;
    netex:xsdType "ScheduledStopPointRefStructure" .

netex:trainNumbers a owl:ObjectProperty ;
    rdfs:label "trainNumbers" ;
    rdfs:comment "TRAIN NUMBERs -= derived through JOURNEY PARTs of a journey - for a multi-part journey only." ;
    netex:xsdType "trainNumberRefs_RelStructure" .

netex:transportTypeRef a owl:ObjectProperty ;
    rdfs:label "TransportTypeRef" ;
    rdfs:range netex:TransportType ;
    netex:isReference true ;
    netex:xsdType "TransportTypeRefStructure" .

netex:Interchange_VersionStructure a owl:Class ;
    rdfs:label "Interchange" ;
    rdfs:comment "Type for INTERCHANGE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:comment "Name of INTERCHANGE." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:name ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:guaranteed ;
            netex:xsdSequenceOrder 10 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:advertised ;
            netex:xsdSequenceOrder 11 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:controlled ;
            netex:xsdSequenceOrder 12 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:connectionCertainty ;
            netex:xsdSequenceOrder 13 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:standardWaitTime ;
            netex:xsdSequenceOrder 14 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:maximumWaitTime ;
            netex:xsdSequenceOrder 15 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:maximumAutomaticWaitTime ;
            netex:xsdSequenceOrder 16 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:standardTransferTime ;
            netex:xsdSequenceOrder 17 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:minimumTransferTime ;
            netex:xsdSequenceOrder 18 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:maximumTransferTime ;
            netex:xsdSequenceOrder 19 ],
        [ a owl:Restriction ;
            rdfs:comment "Description of SCHEDULED STOP POINT feeding INTERCHANGE." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:description ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:controlCentreNotifyThreshold ;
            netex:xsdSequenceOrder 20 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:transferModes ;
            netex:xsdSequenceOrder 21 ],
        [ a owl:Restriction ;
            rdfs:comment "NOTICEs of an interchange." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:noticeAssignments ;
            netex:xsdSequenceOrder 22 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:privateCode ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:externalInterchangeRef ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            rdfs:comment "Reference to a CONNECTION Link over which the INTERCHANGE takes place." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:connectionRef ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:priority ;
            netex:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:staySeated ;
            netex:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:crossBorder ;
            netex:xsdSequenceOrder 8 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:planned ;
            netex:xsdSequenceOrder 9 ],
        netex:DataManagedObjectStructure ;
    netex:abstract true .

netex:JourneyRefStructure a owl:Class ;
    rdfs:label "Journey" ;
    rdfs:comment "Type for a reference to a JOURNEY." ;
    rdfs:subClassOf netex:LinkSequenceRefStructure .

netex:PassingTime_VersionedChildStructure a owl:Class ;
    rdfs:label "PassingTime" ;
    rdfs:comment "Type for PASSING TIME." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:journeyRef ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:alightAndReboard ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:pointInJourneyPatternRef ;
            netex:xsdSequenceOrder 3 ],
        netex:VersionedChildStructure ;
    netex:abstract true .

netex:VehicleJourney_VersionStructure a owl:Class ;
    rdfs:label "VehicleJourney" ;
    rdfs:comment "Type for VEHICLE JOURNEY." ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:comment "Time of departure." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:departureTime ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:journeyFrequencyGroupRef ;
            netex:xsdSequenceOrder 10 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:vehicleTypeRef ;
            netex:xsdSequenceOrder 11 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:vehicleEquipmentProfileRef ;
            netex:xsdSequenceOrder 12 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:vehicleRef ;
            netex:xsdSequenceOrder 13 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:operationalContextRef ;
            netex:xsdSequenceOrder 14 ],
        [ a owl:Restriction ;
            rdfs:comment "Reference to a BLOCK." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:blockRef ;
            netex:xsdSequenceOrder 15 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:courseOfJourneysRef ;
            netex:xsdSequenceOrder 16 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:publicCode ;
            netex:xsdSequenceOrder 17 ],
        [ a owl:Restriction ;
            rdfs:comment "Other TIME DEMAND TYPEs used in JOURNEY." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:timeDemandTypes ;
            netex:xsdSequenceOrder 18 ],
        [ a owl:Restriction ;
            rdfs:comment "JOURNEY PARTs of a JOURNEY - for a multi part JOURNEY only." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:parts ;
            netex:xsdSequenceOrder 19 ],
        [ a owl:Restriction ;
            rdfs:comment "Day offset if day of departure time of VEHICLE JOURNEY differs from the current OPERATING DAY." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:departureDayOffset ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:trainComponentLabelAssignments ;
            netex:xsdSequenceOrder 20 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:vehicleJourneyStopAssignments ;
            netex:xsdSequenceOrder 21 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:waitTimes ;
            netex:xsdSequenceOrder 22 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:runTimes ;
            netex:xsdSequenceOrder 23 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:layovers ;
            netex:xsdSequenceOrder 24 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:passingTimes ;
            netex:xsdSequenceOrder 25 ],
        [ a owl:Restriction ;
            rdfs:comment "Times for passenger to be at stop if earlier than departure time. +v2.0" ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:passengerAtStopTimes ;
            netex:xsdSequenceOrder 26 ],
        [ a owl:Restriction ;
            rdfs:comment "Frequency of Journey." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:frequency ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:journeyDuration ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            rdfs:comment "DAY TYPEs for Journey." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:dayTypes ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:routeRef ;
            netex:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            rdfs:comment "Reference to a JOURNEY PATTERN." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:journeyPatternRef ;
            netex:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            rdfs:comment "Reference to a TIME DEMAND TYPE used at start of JOURNEY." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:timeDemandTypeRef ;
            netex:xsdSequenceOrder 8 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:timingAlgorithmTypeRef ;
            netex:xsdSequenceOrder 9 ],
        netex:Journey_VersionStructure .

netex:accessibilityAssessment a owl:ObjectProperty ;
    rdfs:label "AccessibilityAssessment" ;
    netex:xsdType "AccessibilityAssessment_VersionedChildStructure" .

netex:arrivalTime a owl:DatatypeProperty ;
    rdfs:label "ArrivalTime" ;
    rdfs:comment "Time of arrival of JOURNEY at destination POINT." ;
    rdfs:range xsd:time ;
    netex:xsdType "xsd:time" .

netex:datedJourneyPatternRef a owl:ObjectProperty ;
    rdfs:label "DatedJourneyPatternRef" ;
    rdfs:comment "Reference to a JOURNEY PATTERN." ;
    netex:isReference true ;
    netex:xsdType "JourneyPatternRefStructure" .

netex:destination a owl:ObjectProperty ;
    rdfs:label "Destination" ;
    rdfs:comment "Destination for JOURNEY." ;
    netex:xsdType "JourneyEndpointStructure" .

netex:destinationDisplayRef a owl:ObjectProperty ;
    rdfs:label "DestinationDisplayRef" ;
    rdfs:range netex:DestinationDisplay ;
    netex:isReference true ;
    netex:xsdType "DestinationDisplayRefStructure" .

netex:driverRef a owl:ObjectProperty ;
    rdfs:label "DriverRef" ;
    rdfs:comment "** DEPRECATED ** not to be used - It is expected that the driver's DUTY refer the DatedJourneyPattern, not the way arround ! -v2.0" ;
    netex:isReference true ;
    netex:xsdType "DriverRefStructure" .

netex:dutyPartRef a owl:ObjectProperty ;
    rdfs:label "DutyPartRef" ;
    rdfs:range netex:DutyPart ;
    netex:isReference true ;
    netex:xsdType "DutyPartRefStructure" .

netex:dynamic a owl:DatatypeProperty ;
    rdfs:label "Dynamic" ;
    rdfs:comment "When STOP POINT IN JOURNEY PATTERN is to be publicised in dynamic media. Default is always. +v1.1" ;
    rdfs:range xsd:NMTOKEN ;
    netex:xsdType "DynamicAdvertisementEnumeration" .

netex:endTimeDayOffset a owl:DatatypeProperty ;
    rdfs:label "EndTimeDayOffset" ;
    rdfs:comment "Number of days after journey start time that end time is." ;
    rdfs:range xsd:integer ;
    netex:xsdType "DayOffsetType" .

netex:externalDatedVehicleJourneyRef a owl:ObjectProperty ;
    rdfs:label "ExternalDatedVehicleJourneyRef" ;
    rdfs:comment "An alternative code that uniquely identifies theDATED VEHICLE JOURNEY. Specifically for use in AVMS systems. For VDV compatibility. DEPRECATED. -v2.0" ;
    netex:isReference true ;
    netex:xsdType "ExternalObjectRefStructure" .

netex:finishingDuration a owl:DatatypeProperty ;
    rdfs:label "FinishingDuration" ;
    rdfs:comment "Time to complete DUTY." ;
    rdfs:range xsd:duration ;
    netex:xsdType "xsd:duration" .

netex:flexibleServiceProperties a owl:ObjectProperty ;
    rdfs:label "FlexibleServiceProperties" ;
    netex:xsdType "FlexibleServiceProperties_VersionStructure" .

netex:fromPointRef a owl:ObjectProperty ;
    rdfs:label "FromPointRef" ;
    rdfs:comment "Origin of Journey." ;
    netex:isReference true ;
    netex:xsdType "TimingPointRefStructure" .

netex:journeys a owl:ObjectProperty ;
    rdfs:label "journeys" ;
    rdfs:comment "TIME DEMAND TYPES associated with JOURNEY FREQUENCY GROUP." ;
    netex:xsdType "explicitJourneyRefs_RelStructure" .

netex:maximumAutomaticWaitTime a owl:DatatypeProperty ;
    rdfs:label "MaximumAutomaticWaitTime" ;
    rdfs:comment "Maximum automatic wait time for INTERCHANGE." ;
    rdfs:range xsd:duration ;
    netex:xsdType "xsd:duration" .

netex:maximumTransferTime a owl:DatatypeProperty ;
    rdfs:label "MaximumTransferTime" ;
    rdfs:comment "Maximum transfer duration for INTERCHANGE." ;
    rdfs:range xsd:duration ;
    netex:xsdType "xsd:duration" .

netex:minimumTransferTime a owl:DatatypeProperty ;
    rdfs:label "MinimumTransferTime" ;
    rdfs:comment "Maximum transfer duration for INTERCHANGE." ;
    rdfs:range xsd:duration ;
    netex:xsdType "xsd:duration" .

netex:operatingDayRef a owl:ObjectProperty ;
    rdfs:label "OperatingDayRef" ;
    rdfs:comment "EXPECTED TO BE MANDATORY - left with minOccurs=\"0\" only to avoid breaking compatibility with old rail datasets and also in the case when OperatingDayView is used. +v2.0" ;
    rdfs:range netex:OperatingDay ;
    netex:isReference true ;
    netex:xsdType "OperatingDayRefStructure" .

netex:operatingDayView a owl:ObjectProperty ;
    rdfs:label "OperatingDayView" ;
    rdfs:comment "Used in some cases, when no OperatingDayRef is used. At least the OPERATING DAY must be provided as date. +v2.0" ;
    netex:xsdType "OperatingDay_DerivedViewStructure" .

netex:operatorRef a owl:ObjectProperty ;
    rdfs:label "OperatorRef" ;
    rdfs:range netex:Operator ;
    netex:isReference true ;
    netex:xsdType "OperatorRefStructure" .

netex:origin a owl:ObjectProperty ;
    rdfs:label "Origin" ;
    rdfs:comment "Origin for JOURNEY." ;
    netex:xsdType "JourneyEndpointStructure" .

netex:passengerAtStopTimes a owl:ObjectProperty ;
    rdfs:label "passengerAtStopTimes" ;
    rdfs:comment "Times by which passenger should be at stop for specific processes such as baggage checking, passport control and security - may be earlier than the departure time for departures, or later than arrival time for arrivals. +v2.0" ;
    netex:xsdType "passengerAtStopTimes_RelStructure" .

netex:pointInJourneyPatternRef a owl:ObjectProperty ;
    rdfs:label "PointInJourneyPatternRef" ;
    rdfs:comment "Point in JOURNEY PATTERN upon which this call is based. Can be used to obtain full association sets." ;
    rdfs:range netex:PointInJourneyPattern ;
    netex:isReference true ;
    netex:xsdType "PointInJourneyPatternRefStructure" .

netex:print a owl:DatatypeProperty ;
    rdfs:label "Print" ;
    rdfs:comment "Whether the stop is included in printed media. Default is true. +v1.1" ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:replacedJourneys a owl:ObjectProperty ;
    rdfs:label "replacedJourneys" ;
    rdfs:comment "DATED VEHICLE JOURNEYs for which current VEHICLE JOURNEY is an alteration (i.e. change, replacement, supplement). +v2.0" ;
    netex:xsdType "replacedJourneys_RelStructure" .

netex:serviceDesignator a owl:ObjectProperty ;
    rdfs:label "ServiceDesignator" ;
    netex:xsdType "ServiceDesignatorStructure" .

netex:standardTransferTime a owl:DatatypeProperty ;
    rdfs:label "StandardTransferTime" ;
    rdfs:comment "Standard transfer duration for INTERCHANGE." ;
    rdfs:range xsd:duration ;
    netex:xsdType "xsd:duration" .

netex:standardWaitTime a owl:DatatypeProperty ;
    rdfs:label "StandardWaitTime" ;
    rdfs:comment "Standard wait time for INTERCHANGE." ;
    rdfs:range xsd:duration ;
    netex:xsdType "xsd:duration" .

netex:time a owl:DatatypeProperty ;
    rdfs:label "Time" ;
    rdfs:comment "Latest Arrival time." ;
    rdfs:range xsd:time ;
    netex:xsdType "xsd:time" .

netex:toPointRef a owl:ObjectProperty ;
    rdfs:label "ToPointRef" ;
    rdfs:comment "Destination of Journey." ;
    netex:isReference true ;
    netex:xsdType "TimingPointRefStructure" .

netex:transportMode a owl:DatatypeProperty ;
    rdfs:label "TransportMode" ;
    rdfs:comment "PT MODE of JOURNEY." ;
    rdfs:range xsd:NMTOKEN ;
    netex:xsdType "AllPublicTransportModesEnumeration" .

netex:uicOperatingPeriod a owl:ObjectProperty ;
    rdfs:label "UicOperatingPeriod" ;
    rdfs:comment "** DEPRECATED ** not to be used - left available only to avoid breaking compatibility with old rail datasets -v2.0" ;
    netex:xsdType "UicOperatingPeriod_VersionStructure" .

netex:InterchangeRefStructure a owl:Class ;
    rdfs:label "Interchange" ;
    rdfs:comment "Type for a reference to an INTERCHANGE." ;
    rdfs:subClassOf netex:VersionOfObjectRefStructure .

netex:endPointRef a owl:ObjectProperty ;
    rdfs:label "EndPointRef" ;
    rdfs:comment "TIMING POINT at which DUTY PART starts." ;
    netex:isReference true ;
    netex:xsdType "TimingPointRefStructure" .

netex:endTime a owl:DatatypeProperty ;
    rdfs:label "EndTime" ;
    rdfs:comment "End time of JOURNEY PART." ;
    rdfs:range xsd:time ;
    netex:xsdType "xsd:time" .

netex:frequency a owl:ObjectProperty ;
    rdfs:label "Frequency" ;
    rdfs:comment "Frequency of service at CALL." ;
    netex:xsdType "FrequencyStructure" .

netex:maximumWaitTime a owl:DatatypeProperty ;
    rdfs:label "MaximumWaitTime" ;
    rdfs:comment "Maximum wait time for INTERCHANGE." ;
    rdfs:range xsd:duration ;
    netex:xsdType "xsd:duration" .

netex:occupancies a owl:ObjectProperty ;
    rdfs:label "occupancies" ;
    rdfs:comment "OCCUPANCYs associated with this JOURNEY. +v2.0" ;
    netex:xsdType "OccupancyView_RelStructure" .

netex:preparationDuration a owl:DatatypeProperty ;
    rdfs:label "PreparationDuration" ;
    rdfs:comment "Time to prepare DUTY." ;
    rdfs:range xsd:duration ;
    netex:xsdType "xsd:duration" .

netex:startPointRef a owl:ObjectProperty ;
    rdfs:label "StartPointRef" ;
    rdfs:comment "TIMING POINT at which DUTY PART starts." ;
    netex:isReference true ;
    netex:xsdType "TimingPointRefStructure" .

netex:startTime a owl:DatatypeProperty ;
    rdfs:label "StartTime" ;
    rdfs:comment "Start time of JOURNEY PART." ;
    rdfs:range xsd:time ;
    netex:xsdType "xsd:time" .

netex:startTimeDayOffset a owl:DatatypeProperty ;
    rdfs:label "StartTimeDayOffset" ;
    rdfs:comment "Number of days after journey start time that start time is." ;
    rdfs:range xsd:integer ;
    netex:xsdType "DayOffsetType" .

netex:timeDemandTypes a owl:ObjectProperty ;
    rdfs:label "timeDemandTypes" ;
    rdfs:comment "TIME DEMAND TYPES associated with JOURNEY FREQUENCY GROUP." ;
    netex:xsdType "timeDemandTypeRefs_RelStructure" .

netex:trainNumberRef a owl:ObjectProperty ;
    rdfs:label "TrainNumberRef" ;
    rdfs:range netex:TrainNumber ;
    netex:isReference true ;
    netex:xsdType "TrainNumberRefStructure" .

netex:PassingTimeRefStructure a owl:Class ;
    rdfs:label "PassingTime" ;
    rdfs:comment "Type for a reference to a PASSING TIME." ;
    rdfs:subClassOf netex:JourneyTimingRefStructure ;
    netex:abstract true .

netex:VehicleJourneyRefStructure a owl:Class ;
    rdfs:label "VehicleJourney" ;
    rdfs:comment "Type for a reference to a VEHICLE JOURNEY." ;
    rdfs:subClassOf netex:JourneyRefStructure .

netex:arrivalDayOffset a owl:DatatypeProperty ;
    rdfs:label "ArrivalDayOffset" ;
    rdfs:comment "Daya offset if Time of arrival of JOURNEY at destination POINT." ;
    rdfs:range xsd:integer ;
    netex:xsdType "DayOffsetType" .

netex:bookingArrangements a owl:ObjectProperty ;
    rdfs:label "bookingArrangements" ;
    rdfs:comment "Set of possible Booking Arrangements for stop if different from those for SERVICE JOURNEY. +v2.0" ;
    netex:xsdType "bookingArrangements_RelStructure" .

netex:dayOffset a owl:DatatypeProperty ;
    rdfs:label "DayOffset" ;
    rdfs:comment "Number of days after the starting day of the journey. Default is 0 for same day." ;
    rdfs:range xsd:integer ;
    netex:xsdType "DayOffsetType" .

netex:dayTypes a owl:ObjectProperty ;
    rdfs:label "dayTypes" ;
    rdfs:comment "Reusable DAY TYPE in SERVICE CALENDAR FRAME." ;
    netex:xsdType "dayTypes_RelStructure" .

netex:journeyPartRef a owl:ObjectProperty ;
    rdfs:label "JourneyPartRef" ;
    rdfs:range netex:JourneyPart ;
    netex:isReference true ;
    netex:xsdType "JourneyPartRefStructure" .

netex:journeyPatternRef a owl:ObjectProperty ;
    rdfs:label "JourneyPatternRef" ;
    rdfs:range netex:JourneyPattern ;
    netex:isReference true ;
    netex:xsdType "JourneyPatternRefStructure" .

netex:scheduledStopPointRef a owl:ObjectProperty ;
    rdfs:label "ScheduledStopPointRef" ;
    rdfs:range netex:ScheduledStopPoint ;
    netex:isReference true ;
    netex:xsdType "ScheduledStopPointRefStructure" .

netex:serviceJourneyRef a owl:ObjectProperty ;
    rdfs:label "ServiceJourneyRef" ;
    rdfs:range netex:ServiceJourney ;
    netex:isReference true ;
    netex:xsdType "ServiceJourneyRefStructure" .

netex:vehicleTypeRef a owl:ObjectProperty ;
    rdfs:label "VehicleTypeRef" ;
    rdfs:range netex:VehicleType ;
    netex:isReference true ;
    netex:xsdType "VehicleTypeRefStructure" .

netex:Journey_VersionStructure a owl:Class ;
    rdfs:label "Journey" ;
    rdfs:comment "Type for JOURNEY." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:transportMode ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:journeyAccountings ;
            netex:xsdSequenceOrder 10 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:noticeAssignments ;
            netex:xsdSequenceOrder 11 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:occupancies ;
            netex:xsdSequenceOrder 12 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:transportSubmode ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:externalVehicleJourneyRef ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:typeOfProductCategoryRef ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:typeOfServiceRef ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:linkSequenceProjectionRef ;
            netex:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:linkSequenceProjection ;
            netex:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:monitored ;
            netex:xsdSequenceOrder 8 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:accessibilityAssessment ;
            netex:xsdSequenceOrder 9 ],
        netex:LinkSequence_VersionStructure .

netex:blockRef a owl:ObjectProperty ;
    rdfs:label "BlockRef" ;
    rdfs:range netex:Block ;
    netex:isReference true ;
    netex:xsdType "BlockRefStructure" .

netex:lineRef a owl:ObjectProperty ;
    rdfs:label "LineRef" ;
    rdfs:range netex:Line ;
    netex:isReference true ;
    netex:xsdType "LineRefStructure" .

netex:departureTime a owl:DatatypeProperty ;
    rdfs:label "DepartureTime" ;
    rdfs:comment "Time of departure of JOURNEY from POINT." ;
    rdfs:range xsd:time ;
    netex:xsdType "xsd:time" .

netex:departureDayOffset a owl:DatatypeProperty ;
    rdfs:label "DepartureDayOffset" ;
    rdfs:comment "Daya offset if Time of departure of JOURNEY from origin POINT from current OPERATING DAY." ;
    rdfs:range xsd:integer ;
    netex:xsdType "DayOffsetType" .

netex:timeDemandTypeRef a owl:ObjectProperty ;
    rdfs:label "TimeDemandTypeRef" ;
    rdfs:range netex:TimeDemandType ;
    netex:isReference true ;
    netex:xsdType "TimeDemandTypeRefStructure" .

netex:vehicleJourneyRef a owl:ObjectProperty ;
    rdfs:label "VehicleJourneyRef" ;
    rdfs:range netex:VehicleJourney ;
    netex:isReference true ;
    netex:xsdType "VehicleJourneyRefStructure" .

netex:noticeAssignments a owl:ObjectProperty ;
    rdfs:label "noticeAssignments" ;
    rdfs:comment "NOTICEs relevant for the whole GROUP OF SERVICEs." ;
    netex:xsdType "noticeAssignments_RelStructure" .

netex:journeyRef a owl:ObjectProperty ;
    rdfs:label "JourneyRef" ;
    rdfs:range netex:Journey ;
    netex:isReference true ;
    netex:xsdType "JourneyRefStructure" .

netex:name a owl:ObjectProperty ;
    rdfs:label "Name" ;
    rdfs:comment "Name of Journey meeting." ;
    netex:xsdType "MultilingualString" .

netex:description a owl:ObjectProperty ;
    rdfs:label "Description" ;
    rdfs:comment "Description of TRAIN COMPONENT." ;
    netex:xsdType "MultilingualString" .

