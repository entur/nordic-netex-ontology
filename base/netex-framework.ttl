netex:AllPublicTransportModesEnumeration a rdfs:Datatype ;
    rdfs:label "AllPublicTransportModesEnumeration" ;
    rdfs:comment "PUBLIC TRANSPORT MODE: A MODE used for public transport services (e.g., by bus, by tram, by metro, by train, by ferry, by ship, by shared taxi car, by shared car) under either a CONVENTIONAL MODE OF OPERATION or an ALTERNATIVE MODE OF OPERATION (i.e., excluding a PERSONAL MODE OF OPERATION). Note: Prior to TM 6.2 this was named VEHICLE MODE." ;
    owl:oneOf ( "all" "unknown" "bus" "trolleyBus" "tram" "coach" "rail" "intercityRail" "urbanRail" "metro" "air" "water" "cableway" "funicular" "snowAndIce" "taxi" "ferry" "lift" "selfDrive" "anyMode" "other" ) .

