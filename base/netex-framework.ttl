netex:AbstractGroupMember_VersionedChildStructure a owl:Class ;
    rdfs:label "AbstractGroupMember" ;
    rdfs:comment "Type for a GROUP OF ENTITY MEMBERs. Subclass this for specific member types." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:description ;
            netex:xsdSequenceOrder 1 ],
        netex:VersionedChildStructure ;
    netex:abstract true .

netex:ActualVehicleEquipment_VersionStructure a owl:Class ;
    rdfs:label "ActualVehicleEquipment" ;
    rdfs:comment "Abstract Type for an ACTUAL VEHICLE EQUIPMENT." ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:comment "Units of EQUIPMENT." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:units ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:vehicleTypeRef ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:equipmentRef ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:accessibilityAssessment ;
            netex:xsdSequenceOrder 4 ],
        netex:PassengerEquipment_VersionStructure .

netex:AddressRefStructure a owl:Class ;
    rdfs:label "Address" ;
    rdfs:comment "Type for a reference to an ADDRESS." ;
