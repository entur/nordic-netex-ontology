netex:AccessEndStructure a owl:Class ;
    rdfs:label "AccessEnd" ;
    rdfs:comment "Type for ACCESS link end." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:transportMode ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            rdfs:comment "Identifier of a PLACE at end point of ACCESS link." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:placeRef ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            rdfs:comment "Identifier of end point of ACCESS link." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:pointRef ;
            netex:xsdSequenceOrder 3 ] .

netex:AccessFacilityEnumeration a rdfs:Datatype ;
    rdfs:label "AccessFacilityEnumeration" ;
    rdfs:comment "Allowed values for Site Access Facility. NB. These are the properties of access to a fixed SITE, not to a VEHICLE." ;
    owl:oneOf ( "unknown" "lift" "wheelchairLift" "escalator" "travelator" "ramp" "automaticRamp" "steps" "stairs" "slidingStep" "shuttle" "narrowEntrance" "barrier" "lowFloorAccess" "validator" ) .

netex:AccessFeatureEnumeration a rdfs:Datatype ;
    rdfs:label "AccessFeatureEnumeration" ;
    rdfs:comment "Allowed values for an access feature." ;
    owl:oneOf ( "lift" "escalator" "freightElevator" "travelator" "ramp" "stairs" "seriesOfStairs" "ladder" "shuttle" "crossing" "barrier" "narrowEntrance" "hall" "concourse" "confinedSpace" "queueManagement" "none" "unknown" "other" "openSpace" "street" "pavement" "footpath" "passage" ) .

netex:AccessModeEnumeration a rdfs:Datatype ;
    rdfs:label "AccessModeEnumeration" ;
    rdfs:comment "Allowed values for Access MODEs for SITEs, VEHICLE MEETING POINTS and TRANSFER and for monomodal non-public transport OTHER LEG in TRIP." ;
    owl:oneOf ( "foot" "bicycle" "boat" "car" "taxi" "shuttle" "ski" "skate" "motorcycle" "scooter" "wheelchair" "animalRide" ) .

