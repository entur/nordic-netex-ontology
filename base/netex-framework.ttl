netex:PrintPresentationStructure a owl:Class ;
    rdfs:label "PrintPresentation" ;
    rdfs:comment "Types describing common presentation properties for Print." ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:comment "Default colour value for printed graphics associated with ENTITY - e.g. of a LINE. This may be, e.g., a CMYK or RAL code, not intended to be machine-readable." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:colour ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            rdfs:comment "Default language for printed text." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:textLanguage ;
            netex:xsdSequenceOrder 10 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:fontSize ;
            netex:xsdSequenceOrder 11 ],
        [ a owl:Restriction ;
            rdfs:comment "Name of default colour value for printed graphics associated with entity., eg Pentone name" ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:colourName ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            rdfs:comment "Name of colour system used for printed ColourName and TextColourName: for example, - RAL, https://en.wikipedia.org/wiki/RAL_colour_standard; - DIN 6164 http://www.dtpstudio.de/atlas/farbsysteme/DIN%206164_bs00_3.htm; - Pantone (be aware that Pantone is proprietary), etc." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:colourSystem ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            rdfs:comment "Default background colour value for printed text and graphics associated with ENTITY. This may be, e.g., a CMYK or RAL code, not intended to be machine-readable." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:backgroundColour ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            rdfs:comment "Name of the backgropund colour value (in ColourSystem) for printed text and graphics associated with entity." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:backgroundColourName ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            rdfs:comment "Default colour value for printed text associated with entity. This may be, e.g., a CMYK or RAL code, not intended to be machine-readable." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:textColour ;
            netex:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            rdfs:comment "Name of default colour value for printed text associated with entity, in specified ColourSystem." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:textColourName ;
            netex:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            rdfs:comment "Identifier of font for printed text." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:textFont ;
            netex:xsdSequenceOrder 8 ],
        [ a owl:Restriction ;
            rdfs:comment "Name of font for printed text." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:textFontName ;
            netex:xsdSequenceOrder 9 ] .

