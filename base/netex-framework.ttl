            owl:onProperty netex:typeOfEquipmentRef ;
            netex:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:purposeOfEquipmentProfileRef ;
            netex:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:vehicleEquipmentProfileMembers ;
            netex:xsdSequenceOrder 8 ],
        netex:DataManagedObjectStructure .

netex:VehicleRefStructure a owl:Class ;
    rdfs:label "Vehicle" ;
    rdfs:comment "Type for a reference to a VEHICLE." ;
    rdfs:subClassOf netex:VersionOfObjectRefStructure .

netex:Vehicle_VersionStructure a owl:Class ;
    rdfs:label "Vehicle" ;
    rdfs:comment "Type for a VEHICLE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:comment "Name of VEHICLE." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:name ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:transportOrganisationRef ;
            netex:xsdSequenceOrder 10 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:contactRef ;
            netex:xsdSequenceOrder 11 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:transportTypeRef ;
            netex:xsdSequenceOrder 12 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:vehicleModelRef ;
            netex:xsdSequenceOrder 13 ],
        [ a owl:Restriction ;
            rdfs:comment "Equipment profiles associated with model. +v1.2.2" ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:equipmentProfiles ;
            netex:xsdSequenceOrder 14 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:vehicleModelProfileRef ;
            netex:xsdSequenceOrder 15 ],
        [ a owl:Restriction ;
            rdfs:comment "ACTUAL EQUIPMENT found in VEHICLE." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:actualVehicleEquipments ;
            netex:xsdSequenceOrder 16 ],
        [ a owl:Restriction ;
            rdfs:comment "Whether real-time data is available for the VEHICLE (this can be the vehicle position, but also the speed, charging level, passenger counting, etc.). Overrides the corresponding value in VehicleType." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:monitored ;
            netex:xsdSequenceOrder 17 ],
        [ a owl:Restriction ;
            rdfs:comment "Short Name of VEHICLE or item" ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:shortName ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            rdfs:comment "Description +V1.2.2" ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:description ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:buildDate ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:chassisNumber ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:registrationNumber ;
            netex:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:registrationDate ;
            netex:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:operationalNumber ;
            netex:xsdSequenceOrder 8 ],
        [ a owl:Restriction ;
            rdfs:comment "Private code of the vehicle. DEPRECATED - use privateCodes. -v2.0" ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:privateCode ;
            netex:xsdSequenceOrder 9 ],
        netex:DataManagedObjectStructure .

netex:VersionFrame_VersionStructure a owl:Class ;
    rdfs:label "VersionFrame" ;
    rdfs:comment "Type for a VERSION FRAME." ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:comment "Name of VERSION FRAME." ;
