    rdfs:comment "Type for a reference to a VEHICLE SHARING MODE OF OPERATION." ;
    rdfs:subClassOf netex:AlternativeModeOfOperationRefStructure .

netex:VehicleSharingModeOfOperation_ValueStructure a owl:Class ;
    rdfs:label "VehicleSharingModeOfOperation" ;
    rdfs:comment "Type for a VEHICLE SHARING MODE OF OPERATION." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:vehicleSharingType ;
            netex:xsdSequenceOrder 1 ],
        netex:AlternativeModeOfOperation_ValueStructure .

netex:VehicleType a owl:Class ;
    rdfs:label "VehicleType" ;
    rdfs:subClassOf netex:VehicleType_VersionStructure ;
    netex:xsdElement true .

netex:Version a owl:Class ;
    rdfs:label "Version" ;
    rdfs:subClassOf netex:Version_VersionStructure ;
    netex:xsdElement true .

netex:VersionFrame a owl:Class ;
    rdfs:label "VersionFrame" ;
    rdfs:subClassOf netex:VersionFrame_VersionStructure ;
    netex:xsdElement true .

netex:VersionRefStructure a owl:Class ;
    rdfs:label "Version" ;
    rdfs:comment "Type for a VERSION reference." ;
    rdfs:subClassOf netex:VersionOfObjectRefStructure .

netex:Version_VersionStructure a owl:Class ;
    rdfs:label "Version" ;
    rdfs:comment "DEPRECATED: Type for a VERSION. -v2.0" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:startDate ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:endDate ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:status ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:description ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:versionType ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:typeOfVersionRef ;
            netex:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:derivedFromVersionRef ;
            netex:xsdSequenceOrder 7 ],
        netex:DataManagedObjectStructure .

netex:WheelchairVehicleEquipment_VersionStructure a owl:Class ;
    rdfs:label "WheelchairVehicleEquipment" ;
    rdfs:comment "Type for a WHEELCHAIR VEHICLE EQUIPMENT." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:hasWheelchairSpaces ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:numberOfWheelchairAreas ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            rdfs:comment "Width of Access Area." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:widthOfAccessArea ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:lengthOfAccessArea ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            rdfs:comment "Height of Access Area." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:heightOfAccessArea ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:wheelchairTurningCircle ;
            netex:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:companionSeat ;
            netex:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            rdfs:comment "Wheelchair types for which EQUIPMENT is suitable. v2.0" ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:suitableFor ;
            netex:xsdSequenceOrder 8 ],
        netex:ActualVehicleEquipment_VersionStructure .

netex:Whitelist a owl:Class ;
    rdfs:label "Whitelist" ;
    rdfs:subClassOf netex:Whitelist_VersionStructure ;
    netex:xsdElement true .

netex:WhitelistRefStructure a owl:Class ;
    rdfs:label "Whitelist" ;
    rdfs:comment "Type for Reference to a WHITELIST." ;
    rdfs:subClassOf netex:SecurityListRefStructure .

netex:Whitelist_VersionStructure a owl:Class ;
    rdfs:label "Whitelist" ;
    rdfs:comment "Type for WHITELIST. +v1.1" ;
    rdfs:subClassOf netex:SecurityList_VersionStructure .

netex:Zone a owl:Class ;
    rdfs:label "Zone" ;
    rdfs:subClassOf netex:Zone_VersionStructure ;
    netex:xsdElement true .

netex:ZoneProjection_VersionStructure a owl:Class ;
    rdfs:label "ZoneProjection" ;
    rdfs:comment "Type for a ZONE PROJECTION." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:projectedZoneRef ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:projectToZoneRef ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            rdfs:comment "Reference to POINT to which centre of ZONE projects." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:projectToPointRef ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            rdfs:comment "Sequence of points making up PROJECTION." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:points ;
            netex:xsdSequenceOrder 4 ],
        netex:Projection_VersionStructure .

netex:Zone_DerivedViewStructure a owl:Class ;
    rdfs:label "Zone" ;
    rdfs:comment "Type for SCHEDULED STOP POINT VIEW." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:zoneRef ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            rdfs:comment "Name of Stop Point." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:name ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:typeOfZoneRef ;
            netex:xsdSequenceOrder 3 ],
        netex:DerivedViewStructure .

