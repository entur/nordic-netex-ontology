netex:OpenTimeRangeStructure a owl:Class ;
    rdfs:label "OpenTimeRange" ;
    rdfs:comment "Data Type for a range of times. Start time must be specified, end time is optional." ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:comment "The (inclusive) start time." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:startTime ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            rdfs:comment "The (inclusive) end time. If omitted, the range end is open-ended, that is, it should be interpreted as \"forever\"." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:endTime ;
            netex:xsdSequenceOrder 2 ] .

netex:OpenTimestampRangeStructure a owl:Class ;
    rdfs:label "OpenTimestampRange" ;
    rdfs:comment "Data Type for a range of date times. Start time must be specified, end time is optional." ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:comment "The (inclusive) start time stamp." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:startTime ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            rdfs:comment "The (inclusive) end time stamp. If omitted, the range end is open-ended; that is, it should be interpreted as \"forever\"." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:endTime ;
            netex:xsdSequenceOrder 2 ] .

