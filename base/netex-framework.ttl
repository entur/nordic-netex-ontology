    rdfs:label "MultilingualString" ;
    rdfs:comment "*Either* use with simple text (as in NeTEx prior to v2.0) or use *only* Text elements within the MultilingualString. The old version (simple text) will be deprecated. As this is a mixed type this is not currently enforced by the schema." ;
