    netex:abstract true .

netex:Point_VersionStructure a owl:Class ;
    rdfs:label "Point" ;
    rdfs:comment "Type for a POINT." ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:comment "Name of POINT." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:name ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            rdfs:comment "The position of a POINT with a reference to a given LOCATING SYSTEM (e. g. coordinates)." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:location ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:pointNumber ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            rdfs:comment "Types of POINT. Used for arbitrary documentation - Specific types of POINTs and LINKs such as ROUTE POINT, TIMING POINT, etc are also proper subtypes of POINT." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:types ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            rdfs:comment "PROJECTIONs of POINT onto another ENTITY or layer." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:projections ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:groupMemberships ;
            netex:xsdSequenceOrder 6 ],
        netex:DataManagedObjectStructure .

