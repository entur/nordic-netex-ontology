@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix netex: <https://netex-cen.eu/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

netex:AbstractGroupMember a owl:Class ;
    rdfs:label "AbstractGroupMember" ;
    rdfs:subClassOf netex:AbstractGroupMember_VersionedChildStructure ;
    netex:xsdElement true .

netex:AcceptedDriverPermit a owl:Class ;
    rdfs:label "AcceptedDriverPermit" ;
    rdfs:subClassOf netex:AcceptedDriverPermit_VersionStructure ;
    netex:xsdElement true .

