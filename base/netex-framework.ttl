    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:railSubmode a owl:DatatypeProperty ;
    rdfs:label "RailSubmode" ;
    rdfs:range xsd:NMTOKEN ;
    netex:xsdType "RailSubmodeEnumeration" .

netex:selfDriveSubmode a owl:DatatypeProperty ;
    rdfs:label "SelfDriveSubmode" ;
    rdfs:range xsd:NMTOKEN ;
    netex:xsdType "SelfDriveSubmodeEnumeration" .

netex:serviceCalendarRef a owl:ObjectProperty ;
    rdfs:label "ServiceCalendarRef" ;
    rdfs:comment "Reference to parent SERVICE CALENDAR. If given by context, does not need to be given." ;
    rdfs:range netex:ServiceCalendar ;
    netex:isReference true ;
    netex:xsdType "ServiceCalendarRefStructure" .

netex:snowAndIceSubmode a owl:DatatypeProperty ;
    rdfs:label "SnowAndIceSubmode" ;
    rdfs:comment "Extra: Snow and Ice Submode. +v1.1" ;
    rdfs:range xsd:NMTOKEN ;
    netex:xsdType "SnowAndIceSubmodeEnumeration" .

netex:taxiSubmode a owl:DatatypeProperty ;
    rdfs:label "TaxiSubmode" ;
    rdfs:range xsd:NMTOKEN ;
    netex:xsdType "TaxiSubmodeEnumeration" .

netex:telecabinSubmode a owl:DatatypeProperty ;
    rdfs:label "TelecabinSubmode" ;
    rdfs:range xsd:NMTOKEN ;
    netex:xsdType "TelecabinSubmodeEnumeration" .

netex:tramSubmode a owl:DatatypeProperty ;
    rdfs:label "TramSubmode" ;
    rdfs:range xsd:NMTOKEN ;
    netex:xsdType "TramSubmodeEnumeration" .

netex:transportMode a owl:DatatypeProperty ;
    rdfs:label "TransportMode" ;
    rdfs:comment "Identifier of MODE of end point of ACCESS link. Default is all modes." ;
    rdfs:range xsd:NMTOKEN ;
    netex:xsdType "AllModesEnumeration" .

netex:versionOfObjectRef a owl:ObjectProperty ;
    rdfs:label "VersionOfObjectRef" ;
    netex:isReference true ;
    netex:xsdType "VersionOfObjectRefStructure" .

netex:waterSubmode a owl:DatatypeProperty ;
    rdfs:label "WaterSubmode" ;
    rdfs:range xsd:NMTOKEN ;
    netex:xsdType "WaterSubmodeEnumeration" .

netex:width a owl:DatatypeProperty ;
    rdfs:label "Width" ;
    rdfs:comment "Width of SPOT EQUIPMENT" ;
    rdfs:range xsd:decimal ;
    netex:xsdType "LengthType" .

netex:DeckComponent_VersionStructure a owl:Class ;
    rdfs:label "DeckComponent" ;
    rdfs:comment "Type for a DECK COMPONENT." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:publicUse ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:deckLevelRef ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:classOfUseRef ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            rdfs:comment "Edit care class for which capacity is specifyed. Default is any, i.e. capacity is for all classes." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:fareClass ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:accessibilityAssessment ;
            netex:xsdSequenceOrder 5 ],
        netex:OnboardSpace_VersionStructure .

netex:InstalledEquipmentRefStructure a owl:Class ;
    rdfs:label "InstalledEquipment" ;
    rdfs:comment "Type for a reference to an INSTALLED EQUIPMENT." ;
    rdfs:subClassOf netex:EquipmentRefStructure ;
    netex:abstract true .

netex:OrderedVersionOfObjectRefStructure a owl:Class ;
    rdfs:label "OrderedVersionOfObject" ;
    rdfs:comment "Type for a versioned reference to a NeTEx Object. -v2.0" ;
    rdfs:subClassOf netex:VersionOfObjectRefStructure .

netex:ProjectionRefStructure a owl:Class ;
    rdfs:label "Projection" ;
    rdfs:comment "Type for a reference to a PROJECTION." ;
    rdfs:subClassOf netex:VersionOfObjectRefStructure .

netex:distance a owl:DatatypeProperty ;
    rdfs:label "Distance" ;
    rdfs:comment "Length of LINK." ;
    rdfs:range xsd:decimal ;
    netex:xsdType "LengthType" .

netex:fareClass a owl:DatatypeProperty ;
    rdfs:label "FareClass" ;
    rdfs:comment "Fare class of ACCOMMODATION." ;
    rdfs:range xsd:NMTOKEN ;
    netex:xsdType "FareClassEnumeration" .

netex:organisationRef_Dummy a owl:ObjectProperty ;
    rdfs:label "OrganisationRef_Dummy" ;
    netex:isReference true ;
    netex:xsdType "OrganisationRefStructure" .

netex:projections a owl:ObjectProperty ;
    rdfs:label "projections" ;
    rdfs:comment "Projections of ZONE onto another layer." ;
    netex:xsdType "projections_RelStructure" .

netex:timebands a owl:ObjectProperty ;
    rdfs:label "timebands" ;
    rdfs:comment "TIME BANDs for AVAILABILITY CONDITION." ;
    netex:xsdType "timebands_RelStructure" .

netex:InstalledEquipment_VersionStructure a owl:Class ;
    rdfs:label "InstalledEquipment" ;
    rdfs:comment "Type for INSTALLED EQUIPMENT." ;
    rdfs:subClassOf netex:Equipment_VersionStructure ;
    netex:abstract true .

netex:LinkSequence_VersionStructure a owl:Class ;
    rdfs:label "LinkSequence" ;
    rdfs:comment "Type for an Abstract LINK SEQUENCE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:comment "Name of LINK SEQUENCE." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:name ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            rdfs:comment "Short Name of LINK SEQUENCE." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:shortName ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            rdfs:comment "Further Description of a LINKSEQUENCE." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:description ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            rdfs:comment "Overall distance of LINK SEQUENCE. Can be derived from component LINKs." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:distance ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:privateCode ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            rdfs:comment "PROJECTIONs of LINK SEQUENCE onto another ENTITY or layer." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:projections ;
            netex:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            rdfs:comment "Hyperlinks associated with JOURNEY." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:infoLinks ;
            netex:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:sectionsInSequence ;
            netex:xsdSequenceOrder 8 ],
        netex:DataManagedObjectStructure ;
    netex:abstract true .

netex:PlaceRefStructure a owl:Class ;
    rdfs:label "Place" ;
    rdfs:comment "Type for a reference to a PLACE." ;
    rdfs:subClassOf netex:GroupOfEntitiesRefStructure .

netex:Projection_VersionStructure a owl:Class ;
    rdfs:label "Projection" ;
    rdfs:comment "Type for a PROJECTION." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:typeOfProjectionRef ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            rdfs:comment "Description of PROJECTION." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:name ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:spatialFeatureRef ;
            netex:xsdSequenceOrder 3 ],
        netex:DataManagedObjectStructure .

netex:endTime a owl:DatatypeProperty ;
    rdfs:label "EndTime" ;
    rdfs:comment "The (inclusive) end date and time." ;
    rdfs:range xsd:dateTime ;
    netex:xsdType "xsd:dateTime" .

netex:publicCode a owl:ObjectProperty ;
    rdfs:label "PublicCode" ;
    rdfs:comment "Public code to use for ORGANISATION." ;
    netex:xsdType "PublicCodeStructure" .

netex:startTime a owl:DatatypeProperty ;
    rdfs:label "StartTime" ;
    rdfs:comment "The (inclusive) start date and time." ;
    rdfs:range xsd:dateTime ;
    netex:xsdType "xsd:dateTime" .

netex:countryRef a owl:ObjectProperty ;
    rdfs:label "CountryRef" ;
    rdfs:comment "Reference to COUNTRY for Holiday." ;
    rdfs:range netex:Country ;
    netex:isReference true ;
    netex:xsdType "CountryRefStructure" .

netex:Zone_VersionStructure a owl:Class ;
    rdfs:label "Zone" ;
    rdfs:comment "Type for a ZONE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:types ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:centroid ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:polygon ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:multiSurface ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:projections ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:parentZoneRef ;
            netex:xsdSequenceOrder 6 ],
        netex:GroupOfPoints_VersionStructure .

netex:DerivedViewStructure a owl:Class ;
    rdfs:label "DerivedView" ;
    rdfs:comment "Type for MANAGED OBJECT VIEW." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:brandingRef ;
            netex:xsdSequenceOrder 1 ] ;
    netex:abstract true .

netex:label a owl:ObjectProperty ;
    rdfs:label "Label" ;
    rdfs:comment "Label on step." ;
    netex:xsdType "MultilingualString" .

netex:members a owl:ObjectProperty ;
    rdfs:label "members" ;
    rdfs:comment "TARIFF ZONEs in GROUP OF TARIFF ZONEs." ;
    netex:xsdType "tariffZoneRefs_RelStructure" .

netex:GroupOfEntitiesRefStructure a owl:Class ;
    rdfs:label "GroupOfEntities" ;
    rdfs:comment "Extending Type for a reference to a GROUP OF ENTITies." ;
    rdfs:subClassOf netex:GroupOfEntitiesRefStructure_Dummy ;
    netex:abstract true .

netex:GroupOfEntities_VersionStructure a owl:Class ;
    rdfs:label "GroupOfEntities" ;
    rdfs:comment "Type for a GROUP OF ENTITies." ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:comment "Name of GROUP OF ENTITies." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:name ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            rdfs:comment "Short Name of GROUP OF ENTITies." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:shortName ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            rdfs:comment "Further Description of a GROUP OF ENTITies." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:description ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:purposeOfGroupingRef ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:privateCode ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            rdfs:comment "Hyperlinks associated with GROUP OF ENTITIES." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:infoLinks ;
            netex:xsdSequenceOrder 6 ],
        netex:DataManagedObjectStructure ;
    netex:abstract true .

netex:privateCode a owl:ObjectProperty ;
    rdfs:label "PrivateCode" ;
    rdfs:comment "DEPRECATED - use privateCodes. -v2.0" ;
    netex:xsdType "PrivateCodeStructure" .

netex:TypeOfValue_VersionStructure a owl:Class ;
    rdfs:label "TypeOfValue" ;
    rdfs:comment "Type for a TYPE OF VALUE. Abstract supertype used to define open classifications of value types." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:name ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:shortName ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:description ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:image ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:url ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:privateCode ;
            netex:xsdSequenceOrder 6 ],
        netex:DataManagedObjectStructure ;
    netex:abstract true .

netex:shortName a owl:ObjectProperty ;
    rdfs:label "ShortName" ;
    rdfs:comment "Short Name for TYPE OF VALUE." ;
    netex:xsdType "MultilingualString" .

netex:TypeOfEntity_VersionStructure a owl:Class ;
    rdfs:label "TypeOfEntity" ;
    rdfs:comment "Type for a TYPE OFENTITY. Abstract supertype used to define open classifications of value types." ;
    rdfs:subClassOf netex:TypeOfValue_VersionStructure .

netex:VersionedChildStructure a owl:Class ;
    rdfs:label "VersionedChild" ;
    rdfs:comment "Type for VERSIONED CHILD." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:extensions ;
            netex:xsdSequenceOrder 1 ],
        netex:EntityInVersionStructure .

netex:strictContainmentAggregationStructure a owl:Class ;
    rdfs:label "strictContainmentAggregation" ;
    rdfs:comment "Type for an Implementation of a strict aggregate relationship by value, where the contained element is a child of the parent. A one to many relationship from the source, the containing parent, to the child instance." ;
    rdfs:subClassOf netex:relationshipStructure .

netex:description a owl:ObjectProperty ;
    rdfs:label "Description" ;
    rdfs:comment "Description of TYPE OF VALUE." ;
    netex:xsdType "MultilingualString" .

netex:TypeOfValueRefStructure a owl:Class ;
    rdfs:label "TypeOfValue" ;
    rdfs:comment "Type for a reference to a TYPE OF VALUE." ;
    rdfs:subClassOf netex:VersionOfObjectRefStructure .

netex:name a owl:ObjectProperty ;
    rdfs:label "Name" ;
    rdfs:comment "Name of TYPE OF VALUE." ;
    netex:xsdType "MultilingualString" .

netex:oneToManyRelationshipStructure a owl:Class ;
    rdfs:label "oneToManyRelationship" ;
    rdfs:comment "Type for an Implementation of a one to many relationship . A one to many relationship from the source (one) to the target (many)" ;
    rdfs:subClassOf netex:relationshipStructure .

netex:DataManagedObjectStructure a owl:Class ;
    rdfs:label "DataManagedObject" ;
    rdfs:comment "Abstract Type for a MANAGED OBJECT." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:keyList ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:privateCodes ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:extensions ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:brandingRef ;
            netex:xsdSequenceOrder 4 ],
        netex:EntityInVersionStructure ;
    netex:abstract true .

netex:VersionOfObjectRefStructure a owl:Class ;
    rdfs:label "VersionOfObject" ;
    rdfs:comment "Type for a versioned reference to a NeTEx Object." .

netex:containmentAggregationStructure a owl:Class ;
    rdfs:label "containmentAggregation" ;
    rdfs:comment "Type for an Implementation of an aggregate relationship by reference or value, where the contained element or reference is included in the XML as a child of the parent." ;
    rdfs:subClassOf netex:relationshipStructure .

