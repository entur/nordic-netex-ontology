netex:exchangableUntilAnyTime a owl:DatatypeProperty ;
    rdfs:label "ExchangableUntilAnyTime" ;
    rdfs:comment "Can be resold anyTime." ;
    rdfs:range xsd:string ;
    netex:xsdType "EmptyType" .

netex:exchangableUntilDuration a owl:DatatypeProperty ;
    rdfs:label "ExchangableUntilDuration" ;
    rdfs:comment "Duration to end of period before (negative) or after (positive) the trigger point (i.e. either Start of Validity or First Use ) or that ticket." ;
    rdfs:range xsd:duration ;
    netex:xsdType "xsd:duration" .

netex:exchangableUntilIntervalRef a owl:ObjectProperty ;
    rdfs:label "ExchangableUntilIntervalRef" ;
    rdfs:comment "Reference to arbitrary TimeInterval determining period up until which reselling can be done relative to trigger point." ;
    netex:isReference true ;
    netex:xsdType "TimeIntervalRefStructure" .

netex:exchangableUntilPercentUse a owl:DatatypeProperty ;
    rdfs:label "ExchangableUntilPercentUse" ;
    rdfs:comment "Can be resold until a certain percentage of duration or use has been achieved. +v1.1" ;
    rdfs:range xsd:decimal ;
    netex:xsdType "xsd:decimal" .

