            owl:onProperty netex:toFarePointInPatternRef ;
            netex:xsdSequenceOrder 18 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:seriesConstraints ;
