        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:thirdPartyProducts ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
