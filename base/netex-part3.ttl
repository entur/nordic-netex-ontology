            netex:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:fareStructureElementRef ;
            netex:xsdSequenceOrder 8 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:fareElementInSequenceRef ;
            netex:xsdSequenceOrder 9 ],
        netex:Assignment_VersionStructure ;
    netex:abstract true .

