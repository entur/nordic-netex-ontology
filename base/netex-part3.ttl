netex:cellRef_Dummy a owl:ObjectProperty ;
    rdfs:label "CellRef_Dummy" ;
    netex:isReference true ;
    netex:xsdType "VersionOfObjectRefStructure" .

netex:name a owl:ObjectProperty ;
