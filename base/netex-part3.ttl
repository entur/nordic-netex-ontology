    rdfs:comment "Destination of Travel. Note that for a point-to-point TARIFF the origin is assigned with a DISTANCE MATRIX ELEMENT." ;
    netex:xsdType "TravelSpecificationSummaryEndpointStructure" .

netex:destinationConstraint a owl:DatatypeProperty ;
    rdfs:label "DestinationConstraint" ;
    rdfs:comment "Constraints on destination SCHEDULED STOP POINT" ;
    rdfs:range xsd:normalizedString ;
    netex:xsdType "SameStopEnumeration" .

netex:directionConstraint a owl:DatatypeProperty ;
    rdfs:label "DirectionConstraint" ;
    rdfs:comment "Constraints on DIRECTION." ;
    rdfs:range xsd:normalizedString ;
    netex:xsdType "SameRouteEnumeration" .

netex:directions a owl:DatatypeProperty ;
    rdfs:label "Directions" ;
    rdfs:comment "Whether use SERIES, or FARE SECTION in forwards, backwards or both directions." ;
    rdfs:range xsd:normalizedString ;
    netex:xsdType "RelativeDirectionEnumeration" .

netex:discountAsPercentage a owl:DatatypeProperty ;
    rdfs:label "DiscountAsPercentage" ;
