netex:exchangableFromDuration a owl:DatatypeProperty ;
    rdfs:label "ExchangableFromDuration" ;
    rdfs:comment "Duration to start of period before (negative) or after (positive) the trigger point (i.e. either Start of Validity or First Use ) after which ticket may be resold." ;
    rdfs:range xsd:duration ;
    netex:xsdType "xsd:duration" .

netex:exchangableFromIntervalRef a owl:ObjectProperty ;
    rdfs:label "ExchangableFromIntervalRef" ;
    rdfs:comment "Reference to arbitrary TimeInterval determining period from which reselling can be done relative to trigger point." ;
    netex:isReference true ;
    netex:xsdType "TimeIntervalRefStructure" .

netex:exchangableFromPercentUse a owl:DatatypeProperty ;
    rdfs:label "ExchangableFromPercentUse" ;
    rdfs:comment "Can be resold once a certain percentage of duration or use has been achieved. +v1.1" ;
    rdfs:range xsd:decimal ;
    netex:xsdType "xsd:decimal" .

netex:exchangableTo a owl:DatatypeProperty ;
    rdfs:label "ExchangableTo" ;
    rdfs:comment "Type of fare for which product can be exchanged." ;
    rdfs:range xsd:normalizedString ;
