<https://netex-cen.eu/ontology/part3> a owl:Ontology ;
    dcterms:created "2026-08-11T10:11:58+02:00" ;
    dcterms:source "NeTEx_publication.xsd" ;
    dcterms:title "NeTEx Part 3 - Fare information" ;
    owl:imports <https://netex-cen.eu/ontology/framework> ;
    owl:versionInfo "482a533" .

netex:AccessLegRefStructure a owl:Class ;
    rdfs:label "AccessLeg" ;
    rdfs:comment "Type for Reference to a ACCESS LEG." ;
    rdfs:subClassOf netex:TransferLegRefStructure .

netex:AccessRightInProduct a owl:Class ;
    rdfs:label "AccessRightInProduct" ;
    rdfs:subClassOf netex:AccessRightInProduct_VersionedChildStructure ;
    netex:xsdElement true .

netex:AccessRightInProductRefStructure a owl:Class ;
    rdfs:label "AccessRightInProduct" ;
    rdfs:comment "Type for Reference to an ACCESS RIGHT IN PRODUCT." ;
    rdfs:subClassOf netex:FareElementInSequenceRefStructure .

netex:AccessRightInProduct_VersionedChildStructure a owl:Class ;
    rdfs:label "AccessRightInProduct" ;
    rdfs:comment "Type for ACCESS RIGHT IN PRODUCT." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:validableElementRef ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:preassignedFareProductRef ;
            netex:xsdSequenceOrder 2 ],
        netex:FareElementInSequence_VersionedChildStructure .

netex:AllDistributionChannelsRefStructureElement a owl:Class ;
    rdfs:label "AllDistributionChannelsRefStructureElement" ;
    rdfs:comment "Type for Reference to a DISTRIBUTION CHANNEL." ;
    rdfs:subClassOf netex:TypeOfValueRefStructure .

netex:AlternativeModeLegRefStructure a owl:Class ;
    rdfs:label "AlternativeModeLeg" ;
    rdfs:comment "Type for Reference to a ALTERNATIVE MODE LEG." ;
    rdfs:subClassOf netex:RideLegRefStructure .

netex:AmountOfPriceUnitProduct a owl:Class ;
    rdfs:label "AmountOfPriceUnitProduct" ;
