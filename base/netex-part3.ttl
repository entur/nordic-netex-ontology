netex:CustomerEligibility_VersionedChildStructure a owl:Class ;
    rdfs:label "CustomerEligibility" ;
    rdfs:comment "Type for CUSTOMER ELIGIBILITY." ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:comment "Name of CUSTOMER ELIGIBILITY." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:name ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:customerRef ;
            netex:xsdSequenceOrder 2 ],
        netex:VersionedChildStructure ;
    netex:abstract true .

netex:FareElementInSequenceRefStructure a owl:Class ;
    rdfs:label "FareElementInSequence" ;
