@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix netex: <https://netex-cen.eu/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

netex:AbstractCapabilitiesStructure a owl:Class ;
    rdfs:label "AbstractCapabilities" ;
    rdfs:comment "Type for Capabilities of StopMonitopring Service." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:generalInteraction ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:transportDescription ;
            netex:xsdSequenceOrder 2 ] .

netex:AbstractDiscoveryDelivery a owl:Class ;
    rdfs:label "AbstractDiscoveryDelivery" ;
    rdfs:subClassOf netex:AbstractDiscoveryDeliveryStructure ;
    netex:xsdElement true .

netex:AbstractDiscoveryRequest a owl:Class ;
    rdfs:label "AbstractDiscoveryRequest" ;
    rdfs:subClassOf netex:AbstractDiscoveryRequestStructure ;
    netex:xsdElement true .

netex:AbstractFunctionalServiceCapabilitiesRequest a owl:Class ;
    rdfs:label "AbstractFunctionalServiceCapabilitiesRequest" ;
    rdfs:subClassOf netex:AbstractServiceRequestStructure ;
    netex:xsdElement true .

netex:AbstractFunctionalServiceCapabilitiesResponse a owl:Class ;
    rdfs:label "AbstractFunctionalServiceCapabilitiesResponse" ;
    rdfs:subClassOf netex:AbstractServiceCapabilitiesResponseStructure ;
    netex:xsdElement true .

netex:AbstractFunctionalServiceDelivery a owl:Class ;
    rdfs:label "AbstractFunctionalServiceDelivery" ;
    rdfs:subClassOf netex:AbstractServiceDeliveryStructure ;
    netex:xsdElement true .

netex:AbstractFunctionalServiceRequest a owl:Class ;
    rdfs:label "AbstractFunctionalServiceRequest" ;
    rdfs:subClassOf netex:AbstractFunctionalServiceRequestStructure ;
    netex:xsdElement true .

netex:AbstractFunctionalServiceSubscriptionRequest a owl:Class ;
    rdfs:label "AbstractFunctionalServiceSubscriptionRequest" ;
    rdfs:subClassOf netex:AbstractSubscriptionStructure ;
    netex:xsdElement true .

netex:AbstractIdentifiedItemStructure a owl:Class ;
    rdfs:label "AbstractIdentifiedItem" ;
    rdfs:comment "Type for an Activity that can be referenced." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:itemIdentifier ;
            netex:xsdSequenceOrder 1 ],
        netex:AbstractItemStructure ;
    netex:abstract true .

netex:AbstractReferencingItemStructure a owl:Class ;
    rdfs:label "AbstractReferencingItem" ;
    rdfs:comment "Type for an Activity that references a previous Activity." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:itemRef ;
            netex:xsdSequenceOrder 1 ],
        netex:AbstractItemStructure ;
    netex:abstract true .

netex:AbstractRequest a owl:Class ;
    rdfs:label "AbstractRequest" ;
    rdfs:subClassOf netex:AbstractRequestStructure ;
    netex:xsdElement true .

netex:AbstractRequiredIdentifiedItemStructure a owl:Class ;
    rdfs:label "AbstractRequiredIdentifiedItem" ;
    rdfs:comment "Type for an Activity that can be referenced." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:itemIdentifier ;
            netex:xsdSequenceOrder 1 ],
        netex:AbstractItemStructure ;
    netex:abstract true .

netex:AbstractRequiredReferencingItemStructure a owl:Class ;
    rdfs:label "AbstractRequiredReferencingItem" ;
    rdfs:comment "Type for an Activity that references a previous Activity." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:itemRef ;
            netex:xsdSequenceOrder 1 ],
        netex:AbstractItemStructure ;
    netex:abstract true .

netex:AbstractResponse a owl:Class ;
    rdfs:label "AbstractResponse" ;
    rdfs:subClassOf netex:ResponseStructure ;
    netex:xsdElement true .

netex:AbstractServiceRequest a owl:Class ;
    rdfs:label "AbstractServiceRequest" ;
    rdfs:subClassOf netex:AbstractServiceRequestStructure ;
    netex:xsdElement true .

netex:AbstractTrackedRequest a owl:Class ;
    rdfs:label "AbstractTrackedRequest" ;
    rdfs:subClassOf netex:RequestStructure ;
    netex:xsdElement true .

netex:AccessNotAllowedError a owl:Class ;
    rdfs:label "AccessNotAllowedError" ;
    rdfs:subClassOf netex:AccessNotAllowedErrorStructure ;
    netex:xsdElement true .

netex:AllowedResourceUsageExceededError a owl:Class ;
    rdfs:label "AllowedResourceUsageExceededError" ;
    rdfs:subClassOf netex:AllowedResourceUsageExceededErrorStructure ;
    netex:xsdElement true .

netex:AuthenticatedRequest a owl:Class ;
    rdfs:label "AuthenticatedRequest" ;
    rdfs:subClassOf netex:AuthenticatedRequestStructure ;
    netex:xsdElement true .

netex:BeyondDataHorizon a owl:Class ;
    rdfs:label "BeyondDataHorizon" ;
    rdfs:subClassOf netex:BeyondDataHorizonErrorStructure ;
    netex:xsdElement true .

netex:BoundingBoxStructure a owl:Class ;
    rdfs:label "BoundingBox" ;
    rdfs:comment "Defines a bounding box using two corner points. GML terminology. +SIRI v2.0" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:upperLeft ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:lowerRight ;
            netex:xsdSequenceOrder 2 ] .

netex:CapabilitiesRequest a owl:Class ;
    rdfs:label "CapabilitiesRequest" ;
    rdfs:subClassOf netex:CapabilitiesRequestStructure ;
    netex:xsdElement true .

netex:CapabilitiesResponse a owl:Class ;
    rdfs:label "CapabilitiesResponse" ;
    rdfs:subClassOf netex:CapabilitiesResponseStructure ;
    netex:xsdElement true .

netex:CapabilityGeneralInteractionStructure a owl:Class ;
    rdfs:label "CapabilityGeneralInteraction" ;
    rdfs:comment "Type for Common Request Policy capabilities." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:interaction ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:delivery ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:multipartDespatch ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:multipleSubscriberFilter ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:hasConfirmDelivery ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:hasHeartbeat ;
            netex:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:visitNumberisOrder ;
            netex:xsdSequenceOrder 7 ] .

netex:CapabilityNotSupportedError a owl:Class ;
    rdfs:label "CapabilityNotSupportedError" ;
    rdfs:subClassOf netex:CapabilityNotSupportedErrorStructure ;
    netex:xsdElement true .

netex:CapabilityRefStructure a owl:Class ;
    rdfs:label "Capability" ;
    rdfs:comment "Type for capability ref." .

netex:CapabilityRequestPolicyStructure a owl:Class ;
    rdfs:label "CapabilityRequestPolicy" ;
    rdfs:comment "Type for Common Request Policy capabilities." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:nationalLanguage ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:translations ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:gmlCoordinateFormat ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:wgsDecimalDegrees ;
            netex:xsdSequenceOrder 4 ] .

netex:CapabilitySubscriptionPolicyStructure a owl:Class ;
    rdfs:label "CapabilitySubscriptionPolicy" ;
    rdfs:comment "Type for Common Subscription capabilities." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:hasIncrementalUpdates ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:hasChangeSensitivity ;
            netex:xsdSequenceOrder 2 ] .

netex:CheckStatusRequest a owl:Class ;
    rdfs:label "CheckStatusRequest" ;
    rdfs:subClassOf netex:CheckStatusRequestStructure ;
    netex:xsdElement true .

netex:CheckStatusResponse a owl:Class ;
    rdfs:label "CheckStatusResponse" ;
    rdfs:subClassOf netex:CheckStatusResponseStructure ;
    netex:xsdElement true .

netex:CheckStatusResponseBodyStructure a owl:Class ;
    rdfs:label "CheckStatusResponseBody" ;
    rdfs:comment "Type for Body of Service Status Check Response. Used in WSDL." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:status ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:dataReady ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            rdfs:comment "Description of any error or warning condition that applies to the status check." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:errorCondition ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:validUntil ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:shortestPossibleCycle ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            rdfs:comment "Time at which current instantiation of service started." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:serviceStartedTime ;
            netex:xsdSequenceOrder 6 ] .

netex:CommunicationsTransportMethodEnumeration a rdfs:Datatype ;
    rdfs:label "CommunicationsTransportMethodEnumeration" ;
    rdfs:comment "Enumeration of communications transport method usage." ;
    owl:oneOf ( "httpPost" "other" "wsdlSoap" "wsdlSoapDocumentLiteral" "httpUrlJSON" "httpUrlProtoBuffers" ) .

netex:CompressionMethodEnumeration a rdfs:Datatype ;
    rdfs:label "CompressionMethodEnumeration" ;
    rdfs:comment "Enumeration of compression usage." ;
    owl:oneOf ( "gzip" "none" "other" ) .

netex:CoordinatesStructure a owl:Class ;
    rdfs:label "Coordinates" ;
    rdfs:comment "Type for GM Coordinates." .

netex:DataNameSpacesStructure a owl:Class ;
    rdfs:label "DataNameSpaces" ;
    rdfs:comment "Name spaces." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:stopPointNameSpace ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:lineNameSpace ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:productCategoryNameSpace ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:serviceFeatureNameSpace ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:vehicleFeatureNameSpace ;
            netex:xsdSequenceOrder 5 ] .

netex:DataObjectCapabilitiesRequest a owl:Class ;
    rdfs:label "DataObjectCapabilitiesRequest" ;
    rdfs:subClassOf netex:ServiceCapabilitiesRequestStructure ;
    netex:xsdElement true .

netex:DataReadyAcknowledgement a owl:Class ;
    rdfs:label "DataReadyAcknowledgement" ;
    rdfs:subClassOf netex:DataReadyResponseStructure ;
    netex:xsdElement true .

netex:DataReadyNotification a owl:Class ;
    rdfs:label "DataReadyNotification" ;
    rdfs:subClassOf netex:DataReadyRequestStructure ;
    netex:xsdElement true .

netex:DataReceivedAcknowledgement a owl:Class ;
    rdfs:label "DataReceivedAcknowledgement" ;
    rdfs:subClassOf netex:DataReceivedResponseStructure ;
    netex:xsdElement true .

netex:DataSupplyRequest a owl:Class ;
    rdfs:label "DataSupplyRequest" ;
    rdfs:subClassOf netex:DataSupplyRequestStructure ;
    netex:xsdElement true .

netex:DataSupplyRequestBodyStructure a owl:Class ;
    rdfs:label "DataSupplyRequestBody" ;
    rdfs:comment "Type for Body of Data Supply Request. Used in WSDL." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:notificationRef ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:allData ;
            netex:xsdSequenceOrder 2 ] .

netex:DeliveryMethodEnumeration a rdfs:Datatype ;
    rdfs:label "DeliveryMethodEnumeration" ;
    rdfs:comment "Delivery Method: Fetched or Direct Delivery." ;
    owl:oneOf ( "direct" "fetched" ) .

netex:EmptyType a rdfs:Datatype ;
    rdfs:label "EmptyType" ;
    rdfs:comment "A type with no allowed content, used when simply the presence of an element is significant." ;
    owl:oneOf ( "" ) .

netex:EndpointDeniedAccessError a owl:Class ;
    rdfs:label "EndpointDeniedAccessError" ;
    rdfs:subClassOf netex:EndpointDeniedAccessStructure ;
    netex:xsdElement true .

netex:EndpointNotAvailableAccessError a owl:Class ;
    rdfs:label "EndpointNotAvailableAccessError" ;
    rdfs:subClassOf netex:EndpointNotAvailableAccessStructure ;
    netex:xsdElement true .

netex:ErrorCode a owl:Class ;
    rdfs:label "ErrorCode" ;
    rdfs:subClassOf netex:ErrorCodeStructure ;
    netex:xsdElement true .

netex:ErrorCondition a owl:Class ;
    rdfs:label "ErrorCondition" ;
    rdfs:subClassOf netex:ErrorConditionStructure ;
    netex:xsdElement true .

netex:ErrorConditionElement a owl:Class ;
    rdfs:label "ErrorConditionElement" ;
    rdfs:subClassOf netex:ErrorConditionElementStructure ;
    netex:xsdElement true .

netex:ErrorDescriptionStructure a owl:Class ;
    rdfs:label "ErrorDescription" ;
    rdfs:comment "Type for Description of an error." .

netex:Extensions a owl:Class ;
    rdfs:label "Extensions" ;
    rdfs:subClassOf netex:ExtensionsStructure ;
    netex:xsdElement true .

netex:HeartbeatNotification a owl:Class ;
    rdfs:label "HeartbeatNotification" ;
    rdfs:subClassOf netex:HeartbeatNotificationStructure ;
    netex:xsdElement true .

netex:InvalidDataReferencesError a owl:Class ;
    rdfs:label "InvalidDataReferencesError" ;
    rdfs:subClassOf netex:InvalidDataReferencesErrorStructure ;
    netex:xsdElement true .

netex:ItemRefStructure a owl:Class ;
    rdfs:label "Item" ;
    rdfs:comment "Type for reference to an Item." .

netex:LineShape a owl:Class ;
    rdfs:label "LineShape" ;
    rdfs:subClassOf netex:LineShapeStructure ;
    netex:xsdElement true .

netex:LocationStructure a owl:Class ;
    rdfs:label "Location" ;
    rdfs:comment "Type for gepspatial Position of a point. May be expressed in concrete WGS 84 Coordinates or any gml compatible point coordinates format." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:longitude ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:latitude ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:coordinates ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:precision ;
            netex:xsdSequenceOrder 4 ] .

netex:MessageRefStructure a owl:Class ;
    rdfs:label "Message" ;
    rdfs:comment "Type for message ref." ;
    rdfs:subClassOf netex:MessageQualifierStructure .

netex:NaturalLanguagePlaceNameStructure a owl:Class ;
    rdfs:label "NaturalLanguagePlaceName" ;
    rdfs:comment "@lang. ISO language code (default is 'en') A string containing a phrase in a natural language name that requires at least one character of text and forbids certain reserved characters." .

netex:NaturalLanguageStringStructure a owl:Class ;
    rdfs:label "NaturalLanguageString" ;
    rdfs:comment "Tyoe for a string in a specified language." .

netex:NoInfoForTopicError a owl:Class ;
    rdfs:label "NoInfoForTopicError" ;
    rdfs:subClassOf netex:NoInfoForTopicErrorStructure ;
    netex:xsdElement true .

netex:OtherError a owl:Class ;
    rdfs:label "OtherError" ;
    rdfs:subClassOf netex:OtherErrorStructure ;
    netex:xsdElement true .

netex:ParametersIgnoredError a owl:Class ;
    rdfs:label "ParametersIgnoredError" ;
    rdfs:subClassOf netex:ParametersIgnoredErrorStructure ;
    netex:xsdElement true .

netex:PredictorsEnumeration a rdfs:Datatype ;
    rdfs:label "PredictorsEnumeration" ;
    rdfs:comment "Allowed values for predictors." ;
    owl:oneOf ( "avmsOnly" "anyone" ) .

netex:ProducerRequest a owl:Class ;
    rdfs:label "ProducerRequest" ;
    rdfs:subClassOf netex:ProducerRequestEndpointStructure ;
    netex:xsdElement true .

netex:ProducerResponse a owl:Class ;
    rdfs:label "ProducerResponse" ;
    rdfs:subClassOf netex:ProducerResponseStructure ;
    netex:xsdElement true .

netex:ProducerResponseEndpointStructure a owl:Class ;
    rdfs:label "ProducerResponseEndpoint" ;
    rdfs:comment "Type for Unique reference to reponse from producer. May be used to reference request in subsequent interactions. Used for WSDL." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:producerRef ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            rdfs:comment "Endpoint Address to which acknowledgements to confirm delivery are to be sent." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:address ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:responseMessageIdentifier ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:requestMessageRef ;
            netex:xsdSequenceOrder 4 ],
        netex:ResponseStructure .

netex:RequestorRef a owl:Class ;
    rdfs:label "RequestorRef" ;
    rdfs:subClassOf netex:ParticipantRefStructure ;
    netex:xsdElement true .

netex:ResponseStatus a owl:Class ;
    rdfs:label "ResponseStatus" ;
    rdfs:subClassOf netex:StatusResponseStructure ;
    netex:xsdElement true .

netex:ServiceDelivery a owl:Class ;
    rdfs:label "ServiceDelivery" ;
    rdfs:subClassOf netex:ServiceDeliveryStructure ;
    netex:xsdElement true .

netex:ServiceDeliveryBodyStructure a owl:Class ;
    rdfs:label "ServiceDeliveryBody" ;
    rdfs:comment "Type for SIRI Service Delivery type." ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:comment "Whether the complerte request could be processed successfully or not. Default is 'true'. If any of the individual requests within the delivery failed, should be set to ' false'." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:status ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            rdfs:comment "Description of any error or warning conditions that appluy to the overall request. More Specific error conditions should be included on each request that fails." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:errorCondition ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:moreData ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:abstractFunctionalServiceDelivery ;
            netex:xsdSequenceOrder 4 ] .

netex:ServiceDeliveryErrorConditionElement a owl:Class ;
    rdfs:label "ServiceDeliveryErrorConditionElement" ;
    rdfs:subClassOf netex:ServiceDeliveryErrorConditionStructure ;
    netex:xsdElement true .

netex:ServiceNotAvailableError a owl:Class ;
    rdfs:label "ServiceNotAvailableError" ;
    rdfs:subClassOf netex:ServiceNotAvailableErrorStructure ;
    netex:xsdElement true .

netex:ServiceRequest a owl:Class ;
    rdfs:label "ServiceRequest" ;
    rdfs:subClassOf netex:ServiceRequestStructure ;
    netex:xsdElement true .

netex:ServiceRequestContextStructure a owl:Class ;
    rdfs:label "ServiceRequestContext" ;
    rdfs:comment "Configurable context for requests. Intended Primarily as a documentation mechanism." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:checkStatusAddress ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:language ;
            netex:xsdSequenceOrder 10 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:wgsDecimalDegrees ;
            netex:xsdSequenceOrder 11 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:gmlCoordinateFormat ;
            netex:xsdSequenceOrder 12 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:distanceUnits ;
            netex:xsdSequenceOrder 13 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:velocityUnits ;
            netex:xsdSequenceOrder 14 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:dataHorizon ;
            netex:xsdSequenceOrder 15 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:requestTimeout ;
            netex:xsdSequenceOrder 16 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:deliveryMethod ;
            netex:xsdSequenceOrder 17 ],
        [ a owl:Restriction ;
            rdfs:comment "Whether multi-part delivery is allowed, i.e. the breaking up of updates into more than one delivery messages with a MoreData flag," ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:multipartDespatch ;
            netex:xsdSequenceOrder 18 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:confirmDelivery ;
            netex:xsdSequenceOrder 19 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:subscribeAddress ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:maximimumNumberOfSubscriptions ;
            netex:xsdSequenceOrder 20 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:allowedPredictors ;
            netex:xsdSequenceOrder 21 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:predictionFunction ;
            netex:xsdSequenceOrder 22 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:manageSubscriptionAddress ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:getDataAddress ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:statusResponseAddress ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:subscriberAddress ;
            netex:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:notifyAddress ;
            netex:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            rdfs:comment "Address to which data is to be sent. If absent, same as NotifyAddress." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:consumerAddress ;
            netex:xsdSequenceOrder 8 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:dataNameSpaces ;
            netex:xsdSequenceOrder 9 ] .

netex:SiriSchema a owl:Class ;
