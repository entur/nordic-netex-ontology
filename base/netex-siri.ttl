    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:communicationsTransportMethod ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:compressionMethod ;
            netex:xsdSequenceOrder 2 ] .

netex:UnapprovedKeyAccessError a owl:Class ;
    rdfs:label "UnapprovedKeyAccessError" ;
    rdfs:subClassOf netex:UnapprovedKeyAccessStructure ;
    netex:xsdElement true .

netex:UnknownEndpointError a owl:Class ;
