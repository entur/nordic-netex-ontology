netex:SubscriptionContextStructure a owl:Class ;
    rdfs:label "SubscriptionContext" ;
    rdfs:comment "Type for Subscription context - Configuration parameters which may be evrriden." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:heartbeatInterval ;
            netex:xsdSequenceOrder 1 ] .

netex:SubscriptionFilterRefStructure a owl:Class ;
    rdfs:label "SubscriptionFilter" ;
    rdfs:comment "Type Unique identifier of Subscription Filter within Participant." .

netex:SubscriptionFilterStructure a owl:Class ;
    rdfs:label "SubscriptionFilter" ;
    rdfs:comment "Type Unique identifier of Subscription Filter within Participant." .

netex:SubscriptionQualifierStructure a owl:Class ;
    rdfs:label "SubscriptionQualifier" ;
    rdfs:comment "Type Unique identifier of Subscription within Participant." .

netex:SubscriptionRequest a owl:Class ;
    rdfs:label "SubscriptionRequest" ;
    rdfs:subClassOf netex:SubscriptionRequestStructure ;
    netex:xsdElement true .

netex:SubscriptionResponse a owl:Class ;
    rdfs:label "SubscriptionResponse" ;
    rdfs:subClassOf netex:SubscriptionResponseStructure ;
    netex:xsdElement true .

netex:SubscriptionResponseBodyStructure a owl:Class ;
    rdfs:label "SubscriptionResponseBody" ;
    rdfs:comment "Type for Body of Subscription Response. Used in WSDL." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:responseStatus ;
