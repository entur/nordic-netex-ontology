            owl:onProperty <https://netex-cen.eu/ontology#@modification> ],
        [ a owl:Restriction ;
            rdfs:comment "Identifier of referenced entity." ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://netex-cen.eu/ontology#@ref> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://netex-cen.eu/ontology#@versionRef> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://netex-cen.eu/ontology#@uri> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://netex-cen.eu/ontology#@created> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://netex-cen.eu/ontology#@changed> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://netex-cen.eu/ontology#@version> ],
        netex:ZoneRefStructure .

netex:VehicleTypeZoneRestriction_VersionStructure a owl:Class ;
    rdfs:label "VehicleTypeZoneRestriction" ;
    rdfs:comment "Type for VEHICLE TYPE ZONE RESTRICTION restricts id." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:zoneUse ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:maximumSpeed ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:transportTypeRef ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            rdfs:comment "If false, a vehicle must be picked up / dropped off at a station rather than anywhere in the ZONE. +v2.0" ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:floatingVehicles ;
            netex:xsdSequenceOrder 4 ],
        netex:VersionedChildStructure .

