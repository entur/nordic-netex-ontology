netex:vehicleRef a owl:ObjectProperty ;
    rdfs:label "VehicleRef" ;
    rdfs:range netex:Vehicle ;
    netex:isReference true ;
    netex:xsdType "VehicleRefStructure" .

netex:CommonVehicleServiceRefStructure a owl:Class ;
    rdfs:label "CommonVehicleService" ;
    rdfs:comment "Type for a reference to an COMMON VEHICLE SERVICE." ;
    rdfs:subClassOf netex:MobilityServiceRefStructure .

netex:CommonVehicleService_VersionStructure a owl:Class ;
    rdfs:label "CommonVehicleService" ;
    rdfs:comment "Type for COMMON VEHICLE SERVICE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:bookingRequired ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:registrationRequired ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:proposedByServices ;
            netex:xsdSequenceOrder 3 ],
        netex:MobilityService_VersionStructure .

netex:MobilityService_VersionStructure a owl:Class ;
    rdfs:label "MobilityService" ;
    rdfs:comment "Type for a MOBILITY SERVICE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:shortName ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:startDate ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:typeOfMobilityServiceRef ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:organisationRef_Dummy ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:topographicPlaceRef ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:serviceBookingArrangements ;
            netex:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            rdfs:comment "Booking Arrangements for service. DEPRECATED: use serviceBookingArrangements" ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:serviceBookingArrangements ;
            netex:xsdSequenceOrder 7 ],
        netex:Equipment_VersionStructure ;
    netex:abstract true .

netex:VehiclePoolingServiceRefStructure a owl:Class ;
    rdfs:label "VehiclePoolingService" ;
    rdfs:comment "Type for a reference to an VEHICLE POOLING SERVICE." ;
    rdfs:subClassOf netex:CommonVehicleServiceRefStructure .

netex:VehiclePoolingService_VersionStructure a owl:Class ;
    rdfs:label "VehiclePoolingService" ;
    rdfs:comment "Type for VEHICLE POOLING SERVICE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:vehiclePoolingRef ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:poolingPolicyUrl ;
            netex:xsdSequenceOrder 2 ],
        netex:CommonVehicleService_VersionStructure .

netex:VehicleServicePlaceAssignmentRefStructure a owl:Class ;
    rdfs:label "VehicleServicePlaceAssignment" ;
    rdfs:comment "Type for a reference to a VEHICLE SERVICE PLACE ASSIGNMENT. +v1.2.2" ;
    rdfs:subClassOf netex:AssignmentRefStructure .

netex:VehicleServicePlaceAssignment_VersionStructure a owl:Class ;
    rdfs:label "VehicleServicePlaceAssignment" ;
    rdfs:comment "Type for VEHICLE SERVICE PLACE ASSIGNMENT restricts id." ;
    rdfs:subClassOf netex:Assignment_VersionStructure .

netex:commonVehicleServiceRef a owl:ObjectProperty ;
    rdfs:label "CommonVehicleServiceRef" ;
    rdfs:range netex:CommonVehicleService ;
    netex:isReference true ;
    netex:xsdType "CommonVehicleServiceRefStructure" .

netex:individualTravellerRef a owl:ObjectProperty ;
    rdfs:label "IndividualTravellerRef" ;
    rdfs:range netex:IndividualTraveller ;
    netex:isReference true ;
    netex:xsdType "IndividualTravellerRefStructure" .

netex:parkingBayRef a owl:ObjectProperty ;
    rdfs:label "ParkingBayRef" ;
    rdfs:range netex:ParkingBay ;
    netex:isReference true ;
    netex:xsdType "ParkingBayRefStructure" .

netex:ranking a owl:DatatypeProperty ;
    rdfs:label "Ranking" ;
    rdfs:comment "Mean rating for traveller" ;
    rdfs:range xsd:decimal ;
    netex:xsdType "GlobalRankingType" .

