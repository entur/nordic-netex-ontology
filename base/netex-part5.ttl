netex:RentalOptionRefStructure a owl:Class ;
    rdfs:label "RentalOption" ;
    rdfs:comment "Type for Reference to a RENTAL OPTION usage parameter." ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:comment "Identifier of a RENTAL OPTION PARAMETER." ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://netex-cen.eu/ontology#@ref> ],
        [ a owl:Restriction ;
            rdfs:comment "Automatic reference class for RentalOptionRefStructure" ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://netex-cen.eu/ontology#@nameOfRefClass> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://netex-cen.eu/ontology#@modification> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://netex-cen.eu/ontology#@versionRef> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://netex-cen.eu/ontology#@uri> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://netex-cen.eu/ontology#@created> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://netex-cen.eu/ontology#@changed> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://netex-cen.eu/ontology#@version> ],
        netex:UsageParameterRefStructure .

netex:RentalOption_VersionStructure a owl:Class ;
    rdfs:label "RentalOption" ;
    rdfs:comment "Type for RENTAL OPTION." ;
    rdfs:subClassOf netex:UsageParameter_VersionStructure .

