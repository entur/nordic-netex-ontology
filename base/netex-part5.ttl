netex:VehicleMeetingPlace_VersionStructure a owl:Class ;
    rdfs:label "VehicleMeetingPlace" ;
    rdfs:comment "Type for VEHICLE MEETING PLACE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:topographicPlaceRef ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:siteElementRef ;
            netex:xsdSequenceOrder 2 ],
        netex:AddressablePlace_VersionStructure .

