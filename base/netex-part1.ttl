    netex:xsdType "scheduledStopPointRefs_RelStructure" .

netex:serviceExclusion a owl:ObjectProperty ;
    rdfs:label "ServiceExclusion" ;
    netex:xsdType "ServiceExclusion_VersionStructure" .

netex:serviceJourneyPatternType a owl:DatatypeProperty ;
    rdfs:label "ServiceJourneyPatternType" ;
    rdfs:comment "Type of SERVICE JOURNEY PATTERN." ;
    rdfs:range xsd:NMTOKEN ;
    netex:xsdType "ServiceJourneyPatternTypeEnumeration" .

netex:serviceLink a owl:ObjectProperty ;
    rdfs:label "ServiceLink" ;
    netex:xsdType "ServiceLink_VersionStructure" .

netex:servicePattern a owl:ObjectProperty ;
    rdfs:label "ServicePattern" ;
    netex:xsdType "ServicePattern_VersionStructure" .

