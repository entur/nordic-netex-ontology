            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:from ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            rdfs:comment "Destination end of CONNECTION." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:to ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:transferOnly ;
            netex:xsdSequenceOrder 4 ],
        netex:Transfer_VersionStructure .

