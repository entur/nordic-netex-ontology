netex:InfrastructureLinkRefStructure a owl:Class ;
    rdfs:label "InfrastructureLink" ;
    rdfs:comment "Type for Reference to an INFRASTRUCTURE POINT." ;
    rdfs:subClassOf netex:LinkRefStructure .

netex:InfrastructureLink_VersionStructure a owl:Class ;
    rdfs:label "InfrastructureLink" ;
    rdfs:comment "Type for INFRASTRUCTURE LINK." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:validityConditions ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:types ;
            netex:xsdSequenceOrder 10 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:lineString ;
            netex:xsdSequenceOrder 11 ],
        [ a owl:Restriction ;
            rdfs:comment "PROJECTIONs of the LINK." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:projections ;
            netex:xsdSequenceOrder 12 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:passingThrough ;
            netex:xsdSequenceOrder 13 ],
        [ a owl:Restriction ;
            owl:onProperty netex:validBetween ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:alternativeTexts ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:keyList ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:privateCodes ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:extensions ;
            netex:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:brandingRef ;
            netex:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            rdfs:comment "Name of LINK." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:name ;
            netex:xsdSequenceOrder 8 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:distance ;
            netex:xsdSequenceOrder 9 ],
        netex:Link_VersionStructure ;
    netex:abstract true .

netex:InfrastructurePointRefStructure a owl:Class ;
    rdfs:label "InfrastructurePoint" ;
    rdfs:comment "Type for Reference to an INFRASTRUCTURE POINT." ;
    rdfs:subClassOf netex:PointRefStructure .

