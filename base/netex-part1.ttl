netex:activationLinks a owl:ObjectProperty ;
    rdfs:label "activationLinks" ;
    rdfs:comment "links in frame." ;
    netex:xsdType "activationLinksInFrame_RelStructure" .

netex:activationPointNumber a owl:DatatypeProperty ;
    rdfs:label "ActivationPointNumber" ;
    rdfs:comment "Identifier of ACTIVATION POINT." ;
