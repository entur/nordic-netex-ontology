netex:ConnectionEndStructure a owl:Class ;
    rdfs:label "ConnectionEnd" ;
    rdfs:comment "Type for a CONNECTION END." ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:comment "MODE of end Point of CONNECTION. Default is all modes, MODE of SCHEDULED STOP POINT can be derived." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:transportMode ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:submode ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            rdfs:comment "TransportOrganisation to which the end of CONNECTION applies. +v1.2.3" ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:transportOrganisationRef ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            rdfs:comment "Specific SCHEDULED STOP POINT at end of CONNECTION." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:scheduledStopPointRef ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:vehicleMeetingPointRef ;
            netex:xsdSequenceOrder 5 ] .

netex:Connection_VersionStructure a owl:Class ;
    rdfs:label "Connection" ;
    rdfs:comment "Type for a CONNECTION link restricts id." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:externalConnectionLinkRef ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
