    rdfs:range xsd:decimal ;
    netex:xsdType "LengthType" .

netex:endPointRef a owl:ObjectProperty ;
    rdfs:label "EndPointRef" ;
    rdfs:comment "Ending stop point within JOURNEY PATTERN for exclusion." ;
    netex:isReference true ;
    netex:xsdType "ScheduledStopPointRefStructure" .

netex:energySaving a owl:DatatypeProperty ;
    rdfs:label "EnergySaving" ;
