    rdfs:label "RemoteControl" ;
    rdfs:comment "Whether the release mechanism is operated off site." ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:representedByGroupRef a owl:ObjectProperty ;
    rdfs:label "RepresentedByGroupRef" ;
    rdfs:comment "GROUPS OF LINEs that can be used to represent LINE." ;
    netex:isReference true ;
    netex:xsdType "GroupOfLinesRefStructure" .

netex:requestMethod a owl:DatatypeProperty ;
    rdfs:label "RequestMethod" ;
    rdfs:comment "Method to Request Stop in this particular service pattern; if none specified, as as per stop. DEPRECATED: USE BoardingRquestMethod OR AlightingRequestMethod INSTEAD. -v2.0" ;
    rdfs:range xsd:NMTOKEN ;
    netex:xsdType "RequestMethodTypeEnumeration" .

netex:requestMethodType a owl:DatatypeProperty ;
    rdfs:label "RequestMethodType" ;
    rdfs:comment "Method of request stop. Default is noneRequired. DEPRECATED: USE BoardingRquestMethod OR AlightingRequestMethod INSTEAD. -v2.0" ;
    rdfs:range xsd:NMTOKEN ;
    netex:xsdType "RequestMethodTypeEnumeration" .

netex:restStopDistance a owl:DatatypeProperty ;
    rdfs:label "RestStopDistance" ;
    rdfs:comment "The maximum distance between two resting levels, in metres rounded to the nearest cm. It is recommended to install a rest platform at the bottom and top of each ramp, as well as every 10 metres in the case of a long ramp." ;
    rdfs:range xsd:decimal ;
    netex:xsdType "LengthType" .

netex:restricted a owl:DatatypeProperty ;
    rdfs:label "Restricted" ;
    rdfs:comment "Whether a NETWORK RESTRICTION is allowed or forbidden. Default is true,, i.e. this is a restriction.." ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:restrictedLine a owl:DatatypeProperty ;
    rdfs:label "RestrictedLine" ;
    rdfs:comment "Whether the LINE is restricted to special groups of passengers and not open to the general public, or restricted by the access modes supported. Default is false. +v2.0" ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:restrictedManoeuvres a owl:DatatypeProperty ;
    rdfs:label "RestrictedManoeuvres" ;
    rdfs:comment "Default sense for RESTRICTED MANOEUVRE in frame. If 'true', manoevres at all points are restricted unless explicitly permittted, If 'false', meeting at all points is allowed, unless explicitly forbidden by a RESTRICTED MANOEUVRE. Default is 'f'alse'." ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:restrictionType a owl:DatatypeProperty ;
    rdfs:label "RestrictionType" ;
    rdfs:comment "Nature of restriction." ;
    rdfs:range xsd:string ;
    netex:xsdType "TransferConstraintTypeEnumeration" .

netex:restrictions a owl:ObjectProperty ;
    rdfs:label "restrictions" ;
    rdfs:comment "restrictions on network." ;
    netex:xsdType "networkRestrictionsInFrame_RelStructure" .

netex:reverseMembers a owl:ObjectProperty ;
    rdfs:label "reverseMembers" ;
    rdfs:comment "DEPRECATED - use reversePoibtsOnSection instead Reverse direction ordered sequence of POINTS Used in the COMMON SECTION." ;
    netex:xsdType "commonSectionPointMembers_RelStructure" .

netex:reversePointsOnSection a owl:ObjectProperty ;
    rdfs:label "reversePointsOnSection" ;
    rdfs:comment "Reverse direction ordered sequence of POINTS Used in the COMMON SECTION. +v1.1" ;
    netex:xsdType "pointOnLineSections_RelStructure" .

netex:revolvingDoor a owl:DatatypeProperty ;
    rdfs:label "RevolvingDoor" ;
    rdfs:comment "Whether door is revolving. Only applies if door is specified." ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

