netex:StopPlaceRefStructure a owl:Class ;
    rdfs:label "StopPlace" ;
    rdfs:comment "Type for a reference to a STOP PLACE." ;
    rdfs:subClassOf netex:SiteRefStructure .

netex:StopPlace_VersionStructure a owl:Class ;
    rdfs:label "StopPlace" ;
    rdfs:comment "Type for a Version of a STOP PLACE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:comment "Short public code for passengers to use when uniquely identifying the stop by SMS and other self-service channels." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:publicCode ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:railSubmode ;
            netex:xsdSequenceOrder 10 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:waterSubmode ;
            netex:xsdSequenceOrder 11 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:snowAndIceSubmode ;
            netex:xsdSequenceOrder 12 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:modeOfOperationRef ;
            netex:xsdSequenceOrder 13 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:otherTransportModes ;
            netex:xsdSequenceOrder 14 ],
        [ a owl:Restriction ;
            rdfs:comment "TARIFF ZONEs into which component falls." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:tariffZones ;
            netex:xsdSequenceOrder 15 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:stopPlaceType ;
            netex:xsdSequenceOrder 16 ],
        [ a owl:Restriction ;
            rdfs:comment "Whether STOP PLACE is a border crossing, that is a point, at which an international boundary between two countries may be crossed." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:borderCrossing ;
            netex:xsdSequenceOrder 17 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:unlocalisedEquipments ;
            netex:xsdSequenceOrder 18 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:servedPlaces ;
            netex:xsdSequenceOrder 19 ],
        [ a owl:Restriction ;
            rdfs:comment "Primary PT MODE associated by this component." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:transportMode ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:mainTerminusForPlaces ;
            netex:xsdSequenceOrder 20 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:limitedUse ;
            netex:xsdSequenceOrder 21 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:weighting ;
            netex:xsdSequenceOrder 22 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:stopPlaceWeight ;
            netex:xsdSequenceOrder 23 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:quays ;
            netex:xsdSequenceOrder 24 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:accessSpaces ;
            netex:xsdSequenceOrder 25 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:pathLinks ;
            netex:xsdSequenceOrder 26 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:pathJunctions ;
            netex:xsdSequenceOrder 27 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:accesses ;
            netex:xsdSequenceOrder 28 ],
        [ a owl:Restriction ;
            rdfs:comment "NAVIGATION PATHs within the SITE and or between the SITE elsewhere." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:navigationPaths ;
            netex:xsdSequenceOrder 29 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:airSubmode ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:vehicleStoppingPlaces ;
            netex:xsdSequenceOrder 30 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:busSubmode ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
