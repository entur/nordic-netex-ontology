    rdfs:range xsd:duration ;
    netex:xsdType "xsd:duration" .

netex:allowedLineDirection a owl:ObjectProperty ;
    rdfs:label "AllowedLineDirection" ;
    netex:xsdType "AllowedLineDirection_VersionStructure" .

netex:alternativeDescriptors a owl:ObjectProperty ;
    rdfs:label "alternativeDescriptors" ;
    rdfs:comment "Alternative descriptors." ;
    netex:xsdType "classificationDescriptors_RelStructure" .

netex:alternativePresentation a owl:ObjectProperty ;
    rdfs:label "AlternativePresentation" ;
    rdfs:comment "Alternative Presentation values to use when rendering LINE, such as a colour." ;
    netex:xsdType "PresentationStructure" .

netex:alternativeTexts a owl:ObjectProperty ;
    rdfs:label "alternativeTexts" ;
    rdfs:comment "Additional Translations of text elements." ;
    netex:xsdType "alternativeTexts_RelStructure" .

netex:alwaysLit a owl:DatatypeProperty ;
    rdfs:label "AlwaysLit" ;
    rdfs:comment "Whether Place is always lit." ;
