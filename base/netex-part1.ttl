netex:Route_VersionStructure a owl:Class ;
    rdfs:label "Route" ;
    rdfs:comment "Type for a ROUTE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:lineRef ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:directionType ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:directionRef ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            rdfs:comment "Ordered set of points making up a ROUTE." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:pointsInSequence ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:inverseRouteRef ;
            netex:xsdSequenceOrder 5 ],
        netex:LinkSequence_VersionStructure .

netex:ScheduledStopPointRefStructure a owl:Class ;
    rdfs:label "ScheduledStopPoint" ;
    rdfs:comment "Type for a reference to a SCHEDULED STOP POINT." ;
    rdfs:subClassOf netex:TimingPointRefStructure .

netex:ScheduledStopPoint_VersionStructure a owl:Class ;
    rdfs:label "ScheduledStopPoint" ;
    rdfs:comment "Type for SCHEDULED STOP POINT restricts id." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:stopAreas ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:externalStopPointRef ;
            netex:xsdSequenceOrder 10 ],
        [ a owl:Restriction ;
            rdfs:comment "URL for SCHEDULED STOP POINT." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:url ;
            netex:xsdSequenceOrder 11 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:stopType ;
            netex:xsdSequenceOrder 12 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:compassBearing ;
            netex:xsdSequenceOrder 13 ],
        [ a owl:Restriction ;
            rdfs:comment "Presentation values to use when rendering STOP POINT such as a colour. and font." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:presentation ;
            netex:xsdSequenceOrder 14 ],
        [ a owl:Restriction ;
            rdfs:comment "PUBLIC TRANSPORT MODEs of STOP POINT." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:vehicleModes ;
            netex:xsdSequenceOrder 15 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:forAlighting ;
            netex:xsdSequenceOrder 16 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:forBoarding ;
            netex:xsdSequenceOrder 17 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:requestStop ;
            netex:xsdSequenceOrder 18 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:requestMethodType ;
            netex:xsdSequenceOrder 19 ],
        [ a owl:Restriction ;
            rdfs:comment "TARIFF ZONEs for SCHEDULED STOP POINT." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:tariffZones ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:boardingRequestMethod ;
            netex:xsdSequenceOrder 20 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:alightingRequestMethod ;
            netex:xsdSequenceOrder 21 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:countryRef ;
            netex:xsdSequenceOrder 22 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:topographicPlaceRef ;
            netex:xsdSequenceOrder 23 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:topographicPlaceView ;
            netex:xsdSequenceOrder 24 ],
        [ a owl:Restriction ;
            rdfs:comment "Whether STOP POINT can be considered as being at the centre of a TOPOGRAPHIC PLACE. Default is false." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:atCentre ;
            netex:xsdSequenceOrder 25 ],
        [ a owl:Restriction ;
            rdfs:comment "Short Name of SCHEDULED STOP POINT." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:shortName ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            rdfs:comment "Optiona l Suffix for Name of SCHEDULED STOP POINT." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:nameSuffix ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            rdfs:comment "Further description of SCHEDULED STOP POINT." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:description ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            rdfs:comment "Label of SCHEDULED STOP POINT." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:label ;
            netex:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:shortStopCode ;
            netex:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            rdfs:comment "A PUBLIC code that uniquely identifies the STOP POINT." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:publicCode ;
            netex:xsdSequenceOrder 8 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:privateCode ;
            netex:xsdSequenceOrder 9 ],
