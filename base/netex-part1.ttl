        [ a owl:Restriction ;
            rdfs:comment "Onward link - used to disambiguate if there are multiple links from the same stop, e.g. as for cloverleaf route topology. If not given explicitly assume there is only one link that connects the two." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:onwardTimingLinkRef ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
