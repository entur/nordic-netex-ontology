<https://netex-cen.eu/ontology/part1> a owl:Ontology ;
    dcterms:created "2026-08-11T10:11:58+02:00" ;
    dcterms:source "NeTEx_publication.xsd" ;
    dcterms:title "NeTEx Part 1 - Network topology" ;
    owl:imports <https://netex-cen.eu/ontology/framework> ;
    owl:versionInfo "482a533" .

netex:AccessSpace a owl:Class ;
    rdfs:label "AccessSpace" ;
    rdfs:subClassOf netex:AccessSpace_VersionStructure ;
    netex:xsdElement true .

netex:AccessSpaceRefStructure a owl:Class ;
    rdfs:label "AccessSpace" ;
    rdfs:comment "Type for reference to an ACCESS SPACE." ;
    rdfs:subClassOf netex:StopPlaceSpaceRefStructure .

netex:AccessSpace_VersionStructure a owl:Class ;
    rdfs:label "AccessSpace" ;
    rdfs:comment "Type for an ACCESS SPACE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:accessSpaceType ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            rdfs:comment "Type of passage associated with ACCESS SPACE." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:passageType ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:parentAccessSpaceRef ;
            netex:xsdSequenceOrder 3 ],
        netex:StopPlaceSpace_VersionStructure .

netex:AccessZone a owl:Class ;
    rdfs:label "AccessZone" ;
    rdfs:subClassOf netex:AccessZone_VersionStructure ;
    netex:xsdElement true .

netex:AccessZoneRefStructure a owl:Class ;
    rdfs:label "AccessZone" ;
    rdfs:comment "Type for reference to an ACCESS ZONE." ;
    rdfs:subClassOf netex:ZoneRefStructure .

netex:AccessZone_VersionStructure a owl:Class ;
    rdfs:label "AccessZone" ;
    rdfs:comment "Type for an ACCESS ZONE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:comment "Accessibility values associated with ACCESS ZONE." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:accessibilityAssessment ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            rdfs:comment "Whether all areas of the ACCESS ZONE are wheelchair accessible." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:allAreasWheelchairAccessible ;
            netex:xsdSequenceOrder 2 ],
        netex:Zone_VersionStructure .

netex:ActivatedEquipmentRefStructure a owl:Class ;
    rdfs:label "ActivatedEquipment" ;
    rdfs:comment "Type for a reference to an ACTIVATED EQUIPMENT." ;
    rdfs:subClassOf netex:EquipmentRefStructure .

netex:ActivatedEquipment_VersionStructure a owl:Class ;
    rdfs:label "ActivatedEquipment" ;
    rdfs:comment "Type for an ACTIVATED EQUIPMENT." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
