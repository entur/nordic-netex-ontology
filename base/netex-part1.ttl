netex:pointsOfInterest a owl:ObjectProperty ;
    rdfs:label "pointsOfInterest" ;
    rdfs:comment "POINTS OF INTEREST in frame." ;
    netex:xsdType "pointsOfInterestInFrame_RelStructure" .

netex:presentationPosition a owl:DatatypeProperty ;
    rdfs:label "PresentationPosition" ;
    rdfs:comment "Relative positiion to be given to name of point when presenting it in a list of stops (Left, right etc). Allows TAP itinerary to be constructed." ;
    rdfs:range xsd:normalizedString ;
    netex:xsdType "SeriesPresentationEnumeration" .

netex:principalCapacity a owl:DatatypeProperty ;
    rdfs:label "PrincipalCapacity" ;
    rdfs:comment "Number of parking places normamally available excluding special spaces, reserved spaces etc." ;
    rdfs:range xsd:nonNegativeInteger ;
    netex:xsdType "xsd:nonNegativeInteger" .

netex:print a owl:DatatypeProperty ;
    rdfs:label "Print" ;
    rdfs:comment "Whether the stop is included in printed media. Default is true. +v1.1" ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:privateCodes a owl:ObjectProperty ;
    rdfs:label "privateCodes" ;
    rdfs:comment "A list of private codes that uniquely identifiy the element. May be used for inter-operating with other (legacy) systems. +v2.0" ;
    netex:xsdType "PrivateCodesStructure" .

netex:prohibitedForHazardousMaterials a owl:DatatypeProperty ;
    rdfs:label "ProhibitedForHazardousMaterials" ;
    rdfs:comment "Whether parking of vehicles containing hazardous materials is prohibited. Default is true." ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:propertyKeptForDuration a owl:DatatypeProperty ;
    rdfs:label "PropertyKeptForDuration" ;
    rdfs:comment "Period for which lost property is kept - after this time it may be disposed of. +V1.1" ;
    rdfs:range xsd:duration ;
    netex:xsdType "xsd:duration" .

netex:public a owl:DatatypeProperty ;
    rdfs:label "Public" ;
    rdfs:comment "Whether private vehicles can use this entrance." ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:purposeOfGrouping a owl:ObjectProperty ;
    rdfs:label "PurposeOfGrouping" ;
    netex:xsdType "PurposeOfGrouping_ValueStructure" .

netex:quayAlignments a owl:ObjectProperty ;
    rdfs:label "quayAlignments" ;
    rdfs:comment "QUAYs with which the VEHICLE STOPPING PLACE aligns." ;
    netex:xsdType "vehicleQuayAlignments_RelStructure" .

netex:quayName a owl:ObjectProperty ;
    rdfs:label "QuayName" ;
    rdfs:comment "Name of QUAY or platform to which the SCHEDULED STOP POINT is assigned." ;
    netex:xsdType "MultilingualString" .

netex:quayType a owl:DatatypeProperty ;
    rdfs:label "QuayType" ;
    rdfs:comment "Type of QUAY." ;
    rdfs:range xsd:string ;
    netex:xsdType "QuayTypeEnumeration" .

netex:quays a owl:ObjectProperty ;
    rdfs:label "quays" ;
    rdfs:comment "QUAYs within the STOP PLACE." ;
    netex:xsdType "quays_RelStructure" .

netex:queueManagement a owl:DatatypeProperty ;
    rdfs:label "QueueManagement" ;
    rdfs:comment "Queue management." ;
    rdfs:range xsd:normalizedString ;
    netex:xsdType "QueueManagementEnumeration" .

netex:queueingEquipment a owl:ObjectProperty ;
    rdfs:label "QueueingEquipment" ;
    netex:xsdType "QueueingEquipment_VersionStructure" .

netex:queuingSeatedPossible a owl:DatatypeProperty ;
    rdfs:label "QueuingSeatedPossible" ;
    rdfs:comment "Whether queuing may be done seated.+v1.1" ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:railedQueue a owl:DatatypeProperty ;
    rdfs:label "RailedQueue" ;
    rdfs:comment "Whether queueing are is controlled by cattle bars." ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:railwayElement a owl:ObjectProperty ;
    rdfs:label "RailwayElement" ;
    netex:xsdType "RailwayElement_VersionStructure" .

netex:railwayJunction a owl:ObjectProperty ;
    rdfs:label "RailwayJunction" ;
    netex:xsdType "RailwayJunction_VersionStructure" .

netex:rampDoorbell a owl:DatatypeProperty ;
    rdfs:label "RampDoorbell" ;
    rdfs:comment "When there is a removable ramp, whether the entrance has a dedicated doorbell to ask for the ramp." ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:rampEquipment a owl:ObjectProperty ;
    rdfs:label "RampEquipment" ;
    netex:xsdType "RampEquipment_VersionStructure" .

netex:rank a owl:DatatypeProperty ;
    rdfs:label "Rank" ;
    rdfs:comment "Relative ranking of this preference." ;
    rdfs:range xsd:positiveInteger ;
    netex:xsdType "xsd:positiveInteger" .

netex:reachedFloorAnnouncement a owl:DatatypeProperty ;
    rdfs:label "ReachedFloorAnnouncement" ;
    rdfs:comment "Whether the elevator car has a visual, tactile or audible display to announce the floor reached. This is different from AudioAnnouncements since AudioAnnouncements can be about different topics than reached floor (closing doors, up-down movement, etc.), and the ReachedFloorAnnouncement can be visual or tactile, and not only audio." ;
    rdfs:range xsd:NMTOKEN ;
    netex:xsdType "ReachedFloorAnnouncementEnumeration" .

netex:realTimeOccupancyAvailable a owl:DatatypeProperty ;
    rdfs:label "RealTimeOccupancyAvailable" ;
    rdfs:comment "Whether Real-time occupancy data is normally available." ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:rechargingBay a owl:ObjectProperty ;
    rdfs:label "RechargingBay" ;
    rdfs:comment "Can be a STOP PLACE, VEHICLE MEETING POINT, TAXI RANK." ;
    netex:xsdType "RechargingBay_VersionStructure" .

netex:rechargingPointAssignment a owl:ObjectProperty ;
    rdfs:label "RechargingPointAssignment" ;
    rdfs:comment "Can be a STOP PLACE, VEHICLE MEETING POINT, TAXI RANK." ;
    netex:xsdType "RechargingPointAssignment_VersionStructure" .

netex:rechargingPointAssignments a owl:ObjectProperty ;
    rdfs:label "rechargingPointAssignments" ;
    rdfs:comment "RECHARGING POINTs in frame. +v2.0" ;
    netex:xsdType "rechargingPointAssignments_RelStructure" .

netex:rechargingStation a owl:ObjectProperty ;
    rdfs:label "RechargingStation" ;
    rdfs:comment "Can be a STOP PLACE, VEHICLE MEETING POINT, TAXI RANK." ;
    netex:xsdType "RechargingStation_VersionStructure" .

netex:recognizable a owl:DatatypeProperty ;
    rdfs:label "Recognizable" ;
    rdfs:comment "Whether the entrance is easily identifiable in its environment taking into account architecture, signage and visual contrast." ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:recycling a owl:DatatypeProperty ;
    rdfs:label "Recycling" ;
    rdfs:comment "Whether there is separation for recycling." ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:relationToVehicle a owl:DatatypeProperty ;
    rdfs:label "RelationToVehicle" ;
    rdfs:comment "Relationship of position to VHEICLE." ;
    rdfs:range xsd:string ;
    netex:xsdType "RelationToVehicleEnumeration" .

netex:relativeLevelOrder a owl:DatatypeProperty ;
    rdfs:label "RelativeLevelOrder" ;
    rdfs:comment "Order of LEVELs. The level numbers are not absolute, but only give a relative order within the SITE. 0 should be the ground floor, even when it is often difficult to determine which one that is in a complex structure. Complex buildings can be modelled with multiple SITEs and referenced by SiteRef. +v2.0" ;
    rdfs:range xsd:integer ;
    netex:xsdType "xsd:integer" .

netex:relativeWeighting a owl:DatatypeProperty ;
    rdfs:label "RelativeWeighting" ;
    rdfs:comment "Relative weighting to be given to this item of EQUIPMENT." ;
    rdfs:range xsd:integer ;
    netex:xsdType "xsd:integer" .

netex:reliefPointRef a owl:ObjectProperty ;
    rdfs:label "ReliefPointRef" ;
    rdfs:range netex:ReliefPoint ;
    netex:isReference true ;
    netex:xsdType "ReliefPointRefStructure" .

netex:reliefPoint_Dummy a owl:ObjectProperty ;
    rdfs:label "ReliefPoint_Dummy" ;
    netex:xsdType "TimingPoint_VersionStructure" .

