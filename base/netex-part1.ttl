netex:tiltType a owl:DatatypeProperty ;
    rdfs:label "TiltType" ;
    rdfs:comment "Coded value of the maximum tilt. See allowed va;ues. +v1.1" ;
    rdfs:range xsd:NMTOKEN ;
    netex:xsdType "TiltTypeEnumeration" .

netex:timingLink a owl:ObjectProperty ;
    rdfs:label "TimingLink" ;
    netex:xsdType "TimingLink_VersionStructure" .

netex:timingPointInJourneyPattern a owl:ObjectProperty ;
    rdfs:label "TimingPointInJourneyPattern" ;
    rdfs:comment "TIMING POINT." ;
    netex:xsdType "TimingPointInJourneyPattern_VersionedChildStructure" .

netex:timingPointStatus a owl:DatatypeProperty ;
    rdfs:label "TimingPointStatus" ;
    rdfs:comment "Default Nature of TIMING POINT. Default is primary TIMING POINT." ;
    rdfs:range xsd:normalizedString ;
    netex:xsdType "TimingPointStatusEnumeration" .

netex:topEnd a owl:ObjectProperty ;
    rdfs:label "TopEnd" ;
    rdfs:comment "Properties of top of staircase." ;
    netex:xsdType "StairEndStructure" .

netex:totalCapacity a owl:DatatypeProperty ;
    rdfs:label "TotalCapacity" ;
    rdfs:comment "Total number of parking places including disabled spaces etc." ;
    rdfs:range xsd:nonNegativeInteger ;
    netex:xsdType "xsd:nonNegativeInteger" .

netex:towards a owl:ObjectProperty ;
    rdfs:label "Towards" ;
    rdfs:comment "Direction heading to show for PATH LINK when travelling in its FROM / TO sense." ;
    netex:xsdType "MultilingualString" .

netex:trainComponentRef a owl:ObjectProperty ;
    rdfs:label "TrainComponentRef" ;
    rdfs:range netex:TrainComponent ;
    netex:isReference true ;
    netex:xsdType "TrainComponentRefStructure" .

netex:trainComponentView a owl:ObjectProperty ;
    rdfs:label "TrainComponentView" ;
    netex:xsdType "TrainComponent_DerivedViewStructure" .

netex:trainRef a owl:ObjectProperty ;
    rdfs:label "TrainRef" ;
    rdfs:range netex:Train ;
    netex:isReference true ;
    netex:xsdType "TrainRefStructure" .

netex:typeOfLineRef a owl:ObjectProperty ;
    rdfs:label "TypeOfLineRef" ;
    rdfs:range netex:TypeOfLine ;
    netex:isReference true ;
    netex:xsdType "TypeOfLineRefStructure" .

netex:vehicleEntranceRef a owl:ObjectProperty ;
    rdfs:label "VehicleEntranceRef" ;
    rdfs:range netex:VehicleEntrance ;
    netex:isReference true ;
    netex:xsdType "VehicleEntranceRefStructure" .

netex:vehicleMeetingPointRef a owl:ObjectProperty ;
    rdfs:label "VehicleMeetingPointRef" ;
    rdfs:comment "VEHICLE MEETING POINT at END OF CONENCTION. +V1.2.2. NB This is typed only to POINT to avoid forward dependency" ;
    rdfs:range netex:VehicleMeetingPoint ;
    netex:isReference true ;
    netex:xsdType "PointRefStructure" .

netex:vehicleStoppingPositionRef a owl:ObjectProperty ;
    rdfs:label "VehicleStoppingPositionRef" ;
    rdfs:range netex:VehicleStoppingPosition ;
    netex:isReference true ;
    netex:xsdType "VehicleStoppingPositionRefStructure" .

netex:visualContrast a owl:DatatypeProperty ;
    rdfs:label "VisualContrast" ;
    rdfs:comment "Whether there is visual contrast compared to the immediate surroundings." ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:visualGuidanceBands a owl:DatatypeProperty ;
    rdfs:label "VisualGuidanceBands" ;
    rdfs:comment "Whether ramp has visual guidance bands or guidance strips." ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:wheelchairPassable a owl:DatatypeProperty ;
    rdfs:label "WheelchairPassable" ;
    rdfs:comment "Whether lift is judged wheelchair passable." ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:wheelchairSuitable a owl:DatatypeProperty ;
    rdfs:label "WheelchairSuitable" ;
    rdfs:comment "Indicates whether equipment may be used while seated in a wheelchair. +v1.1" ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:ConnectionRefStructure a owl:Class ;
    rdfs:label "Connection" ;
    rdfs:comment "Type for a reference to a CONNECTION link." ;
    rdfs:subClassOf netex:TransferRefStructure .

netex:FlexibleQuayRefStructure a owl:Class ;
    rdfs:label "FlexibleQuay" ;
    rdfs:comment "Type for reference to a FLEXIBLE QUAY." ;
    rdfs:subClassOf netex:PlaceRefStructure .

netex:FlexibleQuay_VersionStructure a owl:Class ;
    rdfs:label "FlexibleQuay" ;
    rdfs:comment "Type for FLEXIBLE QUAY." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:nameSuffix ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:alternativeNames ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:flexibleStopPlaceRef ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            rdfs:comment "Primary PT MODE." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:transportMode ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            rdfs:comment "Whether space can be used for boarding or en route to boarding. Default is true." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:boardingUse ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            rdfs:comment "Whether space can be used for alighting or en route to boarding. Default is true." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:alightingUse ;
            netex:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            rdfs:comment "Public identifier code of FLEXIBLE QUAY." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:publicCode ;
            netex:xsdSequenceOrder 7 ],
        netex:Place_VersionStructure .

netex:InfrastructureLinkRestrictionRefStructure a owl:Class ;
    rdfs:label "InfrastructureLinkRestriction" ;
    rdfs:comment "Type for Reference to a an INFRASTRUCTURE LINK RESTRICTION." ;
    rdfs:subClassOf netex:NetworkRestrictionRefStructure .

netex:InfrastructureLinkRestriction_VersionStructure a owl:Class ;
    rdfs:label "InfrastructureLinkRestriction" ;
    rdfs:comment "Type for a NETWORK LINK RESTRICTION." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:fromLinkRef ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:toLinkRef ;
            netex:xsdSequenceOrder 2 ],
        netex:NetworkRestriction_VersionStructure ;
    netex:abstract true .

netex:JourneyPatternRunTimeRefStructure a owl:Class ;
    rdfs:label "JourneyPatternRunTime" ;
    rdfs:comment "Type for a reference to a JOURNEY PATTERN RUN TIME." ;
    rdfs:subClassOf netex:JourneyTimingRefStructure .

netex:JourneyPattern_VersionStructure a owl:Class ;
    rdfs:label "JourneyPattern" ;
    rdfs:comment "Type for JOURNEY PATTERN." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:routeRef ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:timingPatternRef ;
            netex:xsdSequenceOrder 10 ],
        [ a owl:Restriction ;
            rdfs:comment "Booking Arrangements for JOURNEY PATTERN Points" ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:bookingArrangements ;
            netex:xsdSequenceOrder 11 ],
        [ a owl:Restriction ;
            rdfs:comment "Notices for JOURNEY PATTERN Points may be" ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:noticeAssignments ;
            netex:xsdSequenceOrder 12 ],
        [ a owl:Restriction ;
            rdfs:comment "Ordered run times for JOURNEY PATTERN, specific to a TIME DEMAND TYPE." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:runTimes ;
            netex:xsdSequenceOrder 13 ],
        [ a owl:Restriction ;
            rdfs:comment "WAIT TIMEs for JOURNEY PATTERN, specific to a TIME DEMAND TYPE." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:waitTimes ;
            netex:xsdSequenceOrder 14 ],
        [ a owl:Restriction ;
            rdfs:comment "Wait times for TIMING POINT. There may be different times for different time demands." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:headways ;
            netex:xsdSequenceOrder 15 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:layovers ;
            netex:xsdSequenceOrder 16 ],
        [ a owl:Restriction ;
            rdfs:comment "Sequence of points in JOURNEY PATTERN Points may be SCHEDULED STOP POINTs or TIMING POINTs." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:pointsInSequence ;
            netex:xsdSequenceOrder 17 ],
        [ a owl:Restriction ;
            rdfs:comment "Sequence of points in JOURNEY PATTERN Points may be SCHEDULED STOP POINTs or TIMING POINTs." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:linksInSequence ;
            netex:xsdSequenceOrder 18 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:routeView ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            rdfs:comment "DIRECTION of JOURNEY PATTERN. Should be same as for ROUTE on which PATTERN is based." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:directionType ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:directionRef ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:directionView ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:destinationDisplayRef ;
            netex:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            rdfs:comment "Destination / Direction name for JOURNEY PATTERN." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:destinationDisplayView ;
            netex:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:typeOfJourneyPatternRef ;
            netex:xsdSequenceOrder 8 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:operationalContextRef ;
            netex:xsdSequenceOrder 9 ],
        netex:LinkSequence_VersionStructure ;
    netex:abstract true .

netex:ParkingComponent_VersionStructure a owl:Class ;
    rdfs:label "ParkingComponent" ;
    rdfs:comment "Type for a PARKING COMPONENT." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:parkingPaymentCode ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            rdfs:comment "Additional Label of PARKING COMPONENT." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:label ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:maximumLength ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:maximumWidth ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:maximumHeight ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:maximumWeight ;
            netex:xsdSequenceOrder 6 ],
        netex:SiteComponent_VersionStructure .

netex:ParkingEntranceRefStructure a owl:Class ;
    rdfs:label "ParkingEntrance" ;
    rdfs:comment "Type for reference to a PARKING ENTRANCE." ;
    rdfs:subClassOf netex:EntranceRefStructure .

netex:ParkingPoint_VersionStructure a owl:Class ;
    rdfs:label "ParkingPoint" ;
    rdfs:comment "Type for PARKING POINT." ;
    rdfs:subClassOf netex:ReliefPoint_VersionStructure .

netex:ReliefPoint_VersionStructure a owl:Class ;
    rdfs:label "ReliefPoint" ;
    rdfs:comment "Type for RELIEF POINT." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:crewBaseRef ;
            netex:xsdSequenceOrder 1 ],
        netex:TimingPoint_VersionStructure .

netex:SiteElementRefStructure a owl:Class ;
    rdfs:label "SiteElement" ;
    rdfs:comment "Type for reference to a SITE COMPONENT." ;
    rdfs:subClassOf netex:AddressablePlaceRefStructure .

netex:SiteElement_VersionStructure a owl:Class ;
    rdfs:label "SiteElement" ;
    rdfs:comment "Type for a SITE ELEMENT." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:accessibilityAssessment ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:lighting ;
            netex:xsdSequenceOrder 10 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:allAreasWheelchairAccessible ;
            netex:xsdSequenceOrder 11 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:personCapacity ;
            netex:xsdSequenceOrder 12 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:presentation ;
            netex:xsdSequenceOrder 13 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:facilities ;
            netex:xsdSequenceOrder 14 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:accessModes ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:nameSuffix ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:alternativeNames ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:crossRoad ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:landmark ;
            netex:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:publicUse ;
            netex:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:covered ;
            netex:xsdSequenceOrder 8 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:gated ;
            netex:xsdSequenceOrder 9 ],
        netex:AddressablePlace_VersionStructure ;
    netex:abstract true .

netex:StairEquipment_VersionStructure a owl:Class ;
    rdfs:label "StairEquipment" ;
    rdfs:comment "Type for a STAIR EQUIPMENT." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:depth ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:tactileWriting ;
            netex:xsdSequenceOrder 10 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:stairRamp ;
            netex:xsdSequenceOrder 11 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:topEnd ;
            netex:xsdSequenceOrder 12 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:bottomEnd ;
            netex:xsdSequenceOrder 13 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:numberOfSteps ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:stepHeight ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:stepLength ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:stepColourContrast ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:stepCondition ;
            netex:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:handrailType ;
            netex:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:handrailHeight ;
            netex:xsdSequenceOrder 8 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:lowerHandrailHeight ;
            netex:xsdSequenceOrder 9 ],
        netex:AccessEquipment_VersionStructure ;
    netex:abstract true .

netex:StopPlaceComponent_VersionStructure a owl:Class ;
    rdfs:label "StopPlaceComponent" ;
    rdfs:comment "Type for a STOP PLACE COMPONENT." ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:comment "Primary PT MODE associated by this component." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:transportMode ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:waterSubmode ;
            netex:xsdSequenceOrder 10 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:snowAndIceSubmode ;
            netex:xsdSequenceOrder 11 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:modeOfOperationRef ;
            netex:xsdSequenceOrder 12 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:otherTransportModes ;
            netex:xsdSequenceOrder 13 ],
        [ a owl:Restriction ;
            rdfs:comment "TARIFF ZONEs into which component falls." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:tariffZones ;
            netex:xsdSequenceOrder 14 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:airSubmode ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:busSubmode ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:coachSubmode ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:funicularSubmode ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:metroSubmode ;
            netex:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:tramSubmode ;
            netex:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:telecabinSubmode ;
            netex:xsdSequenceOrder 8 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:railSubmode ;
            netex:xsdSequenceOrder 9 ],
        netex:SiteComponent_VersionStructure ;
    netex:abstract true .

netex:accessFeatureType a owl:DatatypeProperty ;
    rdfs:label "AccessFeatureType" ;
    rdfs:comment "Type of physical feature that may slow use of CHECK CONSTRAINT." ;
    rdfs:range xsd:string ;
    netex:xsdType "AccessFeatureEnumeration" .

netex:accessModes a owl:DatatypeProperty ;
    rdfs:label "AccessModes" ;
    rdfs:comment "Allowed MODEs to access SITE ELEMENT." ;
    netex:xsdType "AccessModeListOfEnumerations" .

netex:alightingUse a owl:DatatypeProperty ;
    rdfs:label "AlightingUse" ;
    rdfs:comment "Whether alignment is for alighting use. Default is 'true'." ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:allowedLineDirectionRef a owl:ObjectProperty ;
    rdfs:label "AllowedLineDirectionRef" ;
    rdfs:range netex:AllowedLineDirection ;
    netex:isReference true ;
    netex:xsdType "AllowedLineDirectionRefStructure" .

netex:audioAnnouncements a owl:DatatypeProperty ;
    rdfs:label "AudioAnnouncements" ;
    rdfs:comment "Whether Lift has AudioAnnouncements." ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:boardingUse a owl:DatatypeProperty ;
    rdfs:label "BoardingUse" ;
    rdfs:comment "Whether alignment is for boarding use. Default is 'true'." ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:bookingContact a owl:ObjectProperty ;
    rdfs:label "BookingContact" ;
    rdfs:comment "Contact for Booking. +v1.1" ;
    netex:xsdType "ContactStructure" .

netex:bookingUrl a owl:ObjectProperty ;
    rdfs:label "BookingUrl" ;
    rdfs:comment "URL for booking. +V1.1" ;
    netex:xsdType "InfoLinkStructure" .

netex:checkConstraintDelay a owl:ObjectProperty ;
    rdfs:label "CheckConstraintDelay" ;
    netex:xsdType "CheckConstraintDelay_VersionStructure" .

netex:checkConstraintRef a owl:ObjectProperty ;
    rdfs:label "CheckConstraintRef" ;
    rdfs:range netex:CheckConstraint ;
    netex:isReference true ;
    netex:xsdType "CheckConstraintRefStructure" .

netex:checkConstraints a owl:ObjectProperty ;
    rdfs:label "checkConstraints" ;
    rdfs:comment "Impediments to navigation from processes or barriers. For example security, check in etc." ;
    netex:xsdType "checkConstraints_RelStructure" .

netex:compassBearing a owl:DatatypeProperty ;
    rdfs:label "CompassBearing" ;
    rdfs:comment "Heading of STOP relative to street. Degrees from North. This should be considered as a derived value that can be used for presentation purposes when information about the physical stop is not available. . The definitive value is the compass bearing found on the QUAY (i.e. physical stop) to which a SCHEDULED STOP POINT is assigned." ;
    rdfs:range xsd:float ;
    netex:xsdType "AbsoluteBearingType" .

netex:depth a owl:DatatypeProperty ;
    rdfs:label "Depth" ;
    rdfs:comment "Depth of Stairs." ;
    rdfs:range xsd:decimal ;
    netex:xsdType "LengthType" .

netex:destinations a owl:ObjectProperty ;
    rdfs:label "destinations" ;
    rdfs:comment "Default Destination headings for QUAY." ;
    netex:xsdType "destinationDisplayViews_RelStructure" .

netex:disabledPriority a owl:DatatypeProperty ;
    rdfs:label "DisabledPriority" ;
    rdfs:comment "Whether there is priority access for disabled (no-queue).+v1.1" ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:driverDisplayText a owl:ObjectProperty ;
    rdfs:label "DriverDisplayText" ;
    rdfs:comment "Text to show to Driver or Staff for the DESTINATION DISPLAY." ;
    netex:xsdType "MultilingualString" .

netex:entranceRef a owl:ObjectProperty ;
    rdfs:label "EntranceRef" ;
    rdfs:range netex:Entrance ;
    netex:isReference true ;
    netex:xsdType "EntranceRefStructure" .

netex:equipmentPlaces a owl:ObjectProperty ;
    rdfs:label "equipmentPlaces" ;
