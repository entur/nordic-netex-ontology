            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:assignments ;
            netex:xsdSequenceOrder 3 ],
        netex:Equipment_VersionStructure .

netex:ActivationAssignment a owl:Class ;
    rdfs:label "ActivationAssignment" ;
    rdfs:subClassOf netex:ActivationAssignment_VersionStructure ;
    netex:xsdElement true .

netex:ActivationAssignmentRefStructure a owl:Class ;
    rdfs:label "ActivationAssignment" ;
    rdfs:comment "Type for a reference to an ACTIVATION ASSIGNMENT." ;
    rdfs:subClassOf netex:AssignmentRefStructure .

netex:ActivationAssignment_VersionStructure a owl:Class ;
    rdfs:label "ActivationAssignment" ;
    rdfs:comment "Type for an ACTIVATION ASSIGNMENT." ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:comment "ACTIVATED EQUIPMENT for which this is the assignment - may be omitted if given by context." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:equipmentRef ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:linkRef ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:pointRef ;
            netex:xsdSequenceOrder 3 ],
        netex:Assignment_VersionStructure .

netex:ActivationLinkRefByValueStructure a owl:Class ;
    rdfs:label "ActivationLinkRefByValue" ;
    rdfs:comment "Type for a reference to a ACTIVATION LINK BY VALUE." ;
    rdfs:subClassOf netex:LinkRefByValueStructure .

netex:ActivationLinkRefStructure a owl:Class ;
