            netex:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:platformHeight ;
            netex:xsdSequenceOrder 8 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:edgeToTrackCenterDistance ;
            netex:xsdSequenceOrder 9 ],
        netex:StopPlaceSpace_VersionStructure .

netex:ReliefPointRefStructure a owl:Class ;
    rdfs:label "ReliefPoint" ;
