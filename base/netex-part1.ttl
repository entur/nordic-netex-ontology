netex:QuayRefStructure a owl:Class ;
    rdfs:label "Quay" ;
    rdfs:comment "Type for reference to a QUAY." ;
    rdfs:subClassOf netex:StopPlaceSpaceRefStructure .

netex:Quay_VersionStructure a owl:Class ;
    rdfs:label "Quay" ;
    rdfs:comment "Type for QUAY." ;
