            owl:onProperty netex:deckEntranceAssignments ;
            netex:xsdSequenceOrder 9 ],
        netex:StopAssignment_VersionStructure .

netex:PassengerStopAssignment_DerivedViewStructure a owl:Class ;
    rdfs:label "PassengerStopAssignment" ;
