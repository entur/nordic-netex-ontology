            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:supportPhoneNumber ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:paymentUrl ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:paymentAppDownloadUrl ;
            netex:xsdSequenceOrder 4 ] .

