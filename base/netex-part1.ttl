    netex:xsdType "Point_VersionStructure" .

netex:activationPoints a owl:ObjectProperty ;
    rdfs:label "activationPoints" ;
    rdfs:comment "points in frame." ;
    netex:xsdType "activationPointsInFrame_RelStructure" .

netex:additionalOperators a owl:ObjectProperty ;
    rdfs:label "additionalOperators" ;
    rdfs:comment "Additional OPERATORs for LINE." ;
    netex:xsdType "transportOrganisationRefs_RelStructure" .

netex:additionalTopographicPlaces a owl:ObjectProperty ;
    rdfs:label "additionalTopographicPlaces" ;
