netex:RampEquipment_VersionStructure a owl:Class ;
    rdfs:label "RampEquipment" ;
    rdfs:comment "Type for a RAMP EQUIPMENT." ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:comment "Length of ramp in metres. In the case of a mobile ramp associated with a vehicle this element is used to convey the length the ramp needs to be extended from the vehicle. This indicates the minimally necessary width of the Quay." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:length ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:tactileGuidanceStrips ;
            netex:xsdSequenceOrder 10 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:visualGuidanceBands ;
            netex:xsdSequenceOrder 11 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:temporary ;
            netex:xsdSequenceOrder 12 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:suitableForCycles ;
            netex:xsdSequenceOrder 13 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:restStopDistance ;
            netex:xsdSequenceOrder 14 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:safetyEdge ;
            netex:xsdSequenceOrder 15 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:turningSpace ;
            netex:xsdSequenceOrder 16 ],
        [ a owl:Restriction ;
            rdfs:comment "Maximum load in kilograms. Mainly used for mobile ramps." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:maximumLoad ;
            netex:xsdSequenceOrder 2 ],
