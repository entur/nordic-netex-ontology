netex:AliasStructure a owl:Class ;
    rdfs:label "Alias" ;
    rdfs:comment "Alternative Private Code for a STOP PLACE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:privateCode ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:identifierType ;
            netex:xsdSequenceOrder 2 ] .

