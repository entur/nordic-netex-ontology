            owl:onProperty netex:fontSize ;
            netex:xsdSequenceOrder 12 ],
        [ a owl:Restriction ;
            rdfs:comment "Width of sign in metres." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:width ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
