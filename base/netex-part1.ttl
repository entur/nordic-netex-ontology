    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:arrivesForwards a owl:DatatypeProperty ;
    rdfs:label "ArrivesForwards" ;
    rdfs:comment "Whether VEHICLE or TRAIN arrives at stop travelling in a forwards direction, i.e. operational orientation. Default is true. +v2.0" ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:arrivesFromLeft a owl:DatatypeProperty ;
    rdfs:label "ArrivesFromLeft" ;
    rdfs:comment "Whether VEHICLE or TRAIN is expected to arrive at the QUAY from the left of a bystander facing the track edge of the platform. Default is true. +v2.0" ;
    rdfs:range xsd:boolean ;
