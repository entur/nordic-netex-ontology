    rdfs:label "Route_Dummy" ;
    netex:xsdType "LinkSequence_VersionStructure" .

netex:routes a owl:ObjectProperty ;
    rdfs:label "routes" ;
    rdfs:comment "Routes that follow the LINE." ;
    netex:xsdType "routeRefs_RelStructure" .

netex:routingConstraintZone a owl:ObjectProperty ;
    rdfs:label "RoutingConstraintZone" ;
    netex:xsdType "RoutingConstraintZone_VersionStructure" .

netex:rubbishDisposalEquipment a owl:ObjectProperty ;
    rdfs:label "RubbishDisposalEquipment" ;
    rdfs:comment "Specialisation of EQUIPMENT for Rubbish disposal, describing bins, rubbish types, etc." ;
    netex:xsdType "RubbishDisposalEquipment_VersionStructure" .

netex:safeForGuideDog a owl:DatatypeProperty ;
    rdfs:label "SafeForGuideDog" ;
    rdfs:comment "Whether the access is safe for a guide dog. +v1.1" ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:safetyEdge a owl:DatatypeProperty ;
    rdfs:label "SafetyEdge" ;
    rdfs:comment "Whether there is a wheel guard (side border intended to block the wheel of the wheelchair to prevent falls)." ;
    rdfs:range xsd:string ;
    netex:xsdType "SafetyEdgeEnumeration" .

