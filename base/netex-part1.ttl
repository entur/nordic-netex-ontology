    netex:xsdType "topographicPlaceRefs_RelStructure" .

netex:addresses a owl:ObjectProperty ;
    rdfs:label "addresses" ;
    rdfs:comment "ADDRESSes in frame." ;
    netex:xsdType "addressesInFrame_RelStructure" .

netex:adjacentSites a owl:ObjectProperty ;
    rdfs:label "adjacentSites" ;
    rdfs:comment "Any references to another SITE of which this STOP PLACE is deemed to be a nearby but distinct." ;
    netex:xsdType "siteRefs_RelStructure" .

netex:againstVehicleTypeRef a owl:ObjectProperty ;
    rdfs:label "AgainstVehicleTypeRef" ;
    rdfs:comment "Type of vehicle that may use backwards direction of INFRASTRUCTURE LINK. For a meeting restriction this is for the vehicle going in the reveser sense of the link. For overtaking possibility this is for the vehicle being overtaken." ;
    netex:isReference true ;
    netex:xsdType "TransportTypeRefStructure" .

netex:airConditioned a owl:DatatypeProperty ;
    rdfs:label "AirConditioned" ;
    rdfs:comment "Whether shelter has air conditioining." ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:airlock a owl:DatatypeProperty ;
    rdfs:label "Airlock" ;
    rdfs:comment "Whether there is an airlock. +v1.1" ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:alarmButton a owl:DatatypeProperty ;
    rdfs:label "AlarmButton" ;
    rdfs:comment "Whether lift has alarm button." ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:alightingSideInDirectionOfTravel a owl:DatatypeProperty ;
    rdfs:label "AlightingSideInDirectionOfTravel" ;
