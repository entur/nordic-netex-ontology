netex:assistanceBookingServiceRef a owl:ObjectProperty ;
    rdfs:label "AssistanceBookingServiceRef" ;
    rdfs:range netex:AssistanceBookingService ;
    netex:isReference true ;
    netex:xsdType "AssistanceBookingServiceRefStructure" .

netex:assistanceFacilityList a owl:DatatypeProperty ;
    rdfs:label "AssistanceFacilityList" ;
    netex:xsdType "AssistanceFacilityListOfEnumerations" .

netex:attendant a owl:DatatypeProperty ;
    rdfs:label "Attendant" ;
