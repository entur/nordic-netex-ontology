netex:points a owl:ObjectProperty ;
    rdfs:label "points" ;
    rdfs:comment "List of points used in TIMING PATTERN. May also be defined elsewhere. Can be used to encapsulate TIMING PATTERN with its component POINTS." ;
    netex:xsdType "timingPoints_RelStructure" .

netex:pointsInPattern a owl:ObjectProperty ;
    rdfs:label "pointsInPattern" ;
