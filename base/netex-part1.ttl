    netex:isReference true ;
    netex:xsdType "FareScheduledStopPointRefStructure" .

netex:accousticAnnouncements a owl:DatatypeProperty ;
    rdfs:label "AccousticAnnouncements" ;
    rdfs:comment "DEPRECATED - Spelling correction renamed to audio announcements. THis value will be dropped at - so" ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:acousticAnnouncements a owl:DatatypeProperty ;
    rdfs:label "AcousticAnnouncements" ;
    rdfs:comment "DEPRECATED - Renamed to AudioAnnouncements for consistency. Old value kept for backwards compatibility - will be dropped in future release." ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:acousticCrossingAids a owl:DatatypeProperty ;
    rdfs:label "AcousticCrossingAids" ;
    rdfs:comment "Whether crossing has Acoustic Crossing aids." ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:acousticDeviceSensors a owl:DatatypeProperty ;
    rdfs:label "AcousticDeviceSensors" ;
    rdfs:comment "Whether crossing has Acoustic Device sensors." ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:acousticSensor a owl:DatatypeProperty ;
    rdfs:label "AcousticSensor" ;
    rdfs:comment "Whether door has acoustic sensors." ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

