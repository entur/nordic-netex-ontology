    rdfs:label "AccessSpace" ;
    netex:xsdType "AccessSpace_VersionStructure" .

netex:accessSpaces a owl:ObjectProperty ;
    rdfs:label "accessSpaces" ;
    rdfs:comment "ACCESS SPACEs within the STOP PLACE." ;
    netex:xsdType "accessSpaces_RelStructure" .

netex:accessZone a owl:ObjectProperty ;
    rdfs:label "AccessZone" ;
    rdfs:comment "ACCESS ZONE of a building or SITE." ;
