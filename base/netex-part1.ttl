            netex:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:tramSubmode ;
            netex:xsdSequenceOrder 8 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:telecabinSubmode ;
            netex:xsdSequenceOrder 9 ],
        netex:Site_VersionStructure .

netex:TimingLinkRefStructure a owl:Class ;
    rdfs:label "TimingLink" ;
    rdfs:comment "Type for a reference to a TIMING LINK." ;
    rdfs:subClassOf netex:LinkRefStructure .

netex:VehicleEntrance_VersionStructure a owl:Class ;
    rdfs:label "VehicleEntrance" ;
    rdfs:comment "Type for a VEHICLE ENTRANCE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:public ;
            netex:xsdSequenceOrder 1 ],
        netex:SiteEntrance_VersionStructure .

netex:accessSpaceRef a owl:ObjectProperty ;
    rdfs:label "AccessSpaceRef" ;
    rdfs:range netex:AccessSpace ;
    netex:isReference true ;
    netex:xsdType "AccessSpaceRefStructure" .

netex:accessSpaceType a owl:DatatypeProperty ;
    rdfs:label "AccessSpaceType" ;
    rdfs:comment "Type of ACCESS SPACE." ;
    rdfs:range xsd:string ;
    netex:xsdType "AccessSpaceTypeEnumeration" .

netex:accessibilityAssessmentRef a owl:ObjectProperty ;
    rdfs:label "AccessibilityAssessmentRef" ;
    rdfs:range netex:AccessibilityAssessment ;
    netex:isReference true ;
    netex:xsdType "AccessibilityAssessmentRefStructure" .

netex:alightingRequestMethod a owl:DatatypeProperty ;
    rdfs:label "AlightingRequestMethod" ;
    rdfs:comment "Methods to Request Stop for alighting in this particular service pattern; Default is noneRequired. +v2.0" ;
    netex:xsdType "RequestMethodTypeListOfEnumerations" .

netex:allowedUse a owl:DatatypeProperty ;
    rdfs:label "AllowedUse" ;
    rdfs:comment "Allowed direction of use: one way or two way. Default is two way." ;
    rdfs:range xsd:NMTOKEN ;
    netex:xsdType "PathDirectionEnumeration" .

netex:assistanceAvailability a owl:DatatypeProperty ;
    rdfs:label "AssistanceAvailability" ;
    rdfs:comment "Availability of assistance service." ;
    rdfs:range xsd:string ;
    netex:xsdType "AssistanceAvailabilityEnumeration" .

netex:atCentre a owl:DatatypeProperty ;
    rdfs:label "AtCentre" ;
    rdfs:comment "Whether SITE is at centre of TOPOGRAPHIC PLACE." ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:audioInterfaceAvailable a owl:DatatypeProperty ;
    rdfs:label "AudioInterfaceAvailable" ;
    rdfs:comment "Indicates whether there is an accessible audio interface (allowing a use closed eyes). +v1.1" ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:back a owl:ObjectProperty ;
    rdfs:label "Back" ;
    rdfs:comment "Direction heading to show for PATH LINK when travelling in its TO / FROM sense." ;
    netex:xsdType "MultilingualString" .

netex:bayGeometry a owl:DatatypeProperty ;
    rdfs:label "BayGeometry" ;
    rdfs:comment "Relative positioning of Parking bays. +v1.2.2" ;
    rdfs:range xsd:string ;
    netex:xsdType "BayGeometryEnumeration" .

netex:bearing a owl:DatatypeProperty ;
    rdfs:label "Bearing" ;
    rdfs:comment "Compass Bearing for Instruction." ;
    rdfs:range xsd:float ;
    netex:xsdType "AbsoluteBearingType" .

netex:boardingPosition a owl:ObjectProperty ;
    rdfs:label "BoardingPosition" ;
    netex:xsdType "BoardingPosition_VersionStructure" .

netex:boardingRequestMethod a owl:DatatypeProperty ;
    rdfs:label "BoardingRequestMethod" ;
    rdfs:comment "Methods to Request Stop for boarding in this particular service pattern; Default is noneRequired. +v2.0" ;
    netex:xsdType "RequestMethodTypeListOfEnumerations" .

netex:bookWhen a owl:DatatypeProperty ;
    rdfs:label "BookWhen" ;
    rdfs:comment "When Booking can be made. +V1.1" ;
    rdfs:range xsd:normalizedString ;
    netex:xsdType "PurchaseWhenEnumeration" .

netex:bookingAccess a owl:DatatypeProperty ;
    rdfs:label "BookingAccess" ;
    rdfs:comment "Who can make a booking. Default is public." ;
    rdfs:range xsd:string ;
    netex:xsdType "BookingAccessEnumeration" .

netex:bookingMethods a owl:DatatypeProperty ;
    rdfs:label "BookingMethods" ;
    rdfs:comment "Allowed Ways of Making a BOOKING." ;
    netex:xsdType "BookingMethodListOfEnumerations" .

netex:bookingNote a owl:ObjectProperty ;
    rdfs:label "BookingNote" ;
    rdfs:comment "Note about booking the FLEXIBLE LINE." ;
    netex:xsdType "MultilingualString" .

netex:borderCrossing a owl:DatatypeProperty ;
    rdfs:label "BorderCrossing" ;
    rdfs:comment "Whether ROUTE POINT is a border crossing, that is a point at which an international boundary between two countries may be crossed." ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:bottomEnd a owl:ObjectProperty ;
    rdfs:label "BottomEnd" ;
    rdfs:comment "Properties of bottom of staircase." ;
    netex:xsdType "StairEndStructure" .

netex:brailleButtons a owl:DatatypeProperty ;
    rdfs:label "BrailleButtons" ;
    rdfs:comment "Whether buttons have braille (inside and outside the cabin)." ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:buyWhen a owl:DatatypeProperty ;
    rdfs:label "BuyWhen" ;
    rdfs:comment "When purchase can be made. +V1.1" ;
    netex:xsdType "PurchaseMomentListOfEnumerations" .

netex:callButtonHeight a owl:DatatypeProperty ;
    rdfs:label "CallButtonHeight" ;
    rdfs:comment "Height of call button from ground (outside the cabin)." ;
    rdfs:range xsd:decimal ;
    netex:xsdType "LengthType" .

netex:centroid a owl:ObjectProperty ;
    rdfs:label "Centroid" ;
    rdfs:comment "Centre Coordinates of ZONE." ;
    netex:xsdType "SimplePoint_VersionStructure" .

netex:changeOfDestinationDisplay a owl:DatatypeProperty ;
    rdfs:label "ChangeOfDestinationDisplay" ;
    rdfs:comment "Whether DESTINATION DISPLAY should be updated at this point. If DESTINATION NAME value is different from Previous stop this is implicit." ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:changeOfServiceRequirements a owl:DatatypeProperty ;
    rdfs:label "ChangeOfServiceRequirements" ;
    rdfs:comment "Whether Service Requirements Change at this point." ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:charge a owl:DatatypeProperty ;
    rdfs:label "Charge" ;
    rdfs:comment "Charge for using a trolley." ;
    rdfs:range xsd:decimal ;
    netex:xsdType "CurrencyAmountType" .

netex:checkConstraint a owl:ObjectProperty ;
    rdfs:label "CheckConstraint" ;
    netex:xsdType "CheckConstraint_VersionStructure" .

netex:contactDetails a owl:ObjectProperty ;
    rdfs:label "ContactDetails" ;
    rdfs:comment "CantactDetails for Line +V1.1" ;
    netex:xsdType "ContactStructure" .

netex:continuousHandrail a owl:DatatypeProperty ;
    rdfs:label "ContinuousHandrail" ;
    rdfs:comment "Whether Handrail is continuous across staircase." ;
    rdfs:range xsd:boolean ;
    netex:xsdType "xsd:boolean" .

netex:crewBaseRef a owl:ObjectProperty ;
    rdfs:label "CrewBaseRef" ;
    rdfs:range netex:CrewBase ;
    netex:isReference true ;
    netex:xsdType "CrewBaseRefStructure" .

netex:crewBases a owl:ObjectProperty ;
    rdfs:label "crewBases" ;
    rdfs:comment "CREW BASEs asspicated with GARAGE." ;
    netex:xsdType "crewBaseRefs_RelStructure" .

netex:crossRoad a owl:ObjectProperty ;
    rdfs:label "CrossRoad" ;
    rdfs:comment "Name of a Road that crosses the Road the street near the SITE ELEMENT that can be used to describe its relative location." ;
    netex:xsdType "MultilingualString" .

netex:currency a owl:DatatypeProperty ;
    rdfs:label "Currency" ;
    rdfs:comment "Currency of Charge for using the facility." ;
    rdfs:range xsd:NMTOKEN ;
    netex:xsdType "CurrencyType" .

netex:deckEntranceAssignments a owl:ObjectProperty ;
    rdfs:label "deckEntranceAssignments" ;
    rdfs:comment "DECK ENTRANCE assigned. +v2.0" ;
    netex:xsdType "deckEntranceAssignments_RelStructure" .

netex:displayAssignment a owl:ObjectProperty ;
    rdfs:label "DisplayAssignment" ;
    netex:xsdType "DisplayAssignment_VersionStructure" .

netex:doorOrientation a owl:DatatypeProperty ;
    rdfs:label "DoorOrientation" ;
    rdfs:comment "The direction from which to approach the door(s)." ;
    rdfs:range xsd:string ;
    netex:xsdType "CompassBearing8Enumeration" .

netex:edgeToTrackCenterDistance a owl:DatatypeProperty ;
    rdfs:label "EdgeToTrackCenterDistance" ;
