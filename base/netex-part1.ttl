    rdfs:comment "How to trigger Acoustic Announcements. +v1.1" ;
    rdfs:range xsd:NMTOKEN ;
    netex:xsdType "AudioTriggerMethodEnumeration" .

netex:audioOrVideoIntercom a owl:DatatypeProperty ;
    rdfs:label "AudioOrVideoIntercom" ;
    rdfs:comment "Whether there is an audio or video communication needed for access. +v1.1" ;
