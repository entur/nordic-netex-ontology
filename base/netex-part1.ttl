            owl:onProperty netex:boardingUse ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            rdfs:comment "Whether space can be used for alighting or en route to boarding. Default is true." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:alightingUse ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            rdfs:comment "Label for SPACE." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:label ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            rdfs:comment "ENTRANCEs to SPACE." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:entrances ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            rdfs:comment "Length of SPACE in metres." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:length ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            rdfs:comment "Width of SPACE in metres." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:width ;
            netex:xsdSequenceOrder 6 ],
