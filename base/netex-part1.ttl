    netex:xsdType "ActivationAssignmentRefStructure" .

netex:activationLink a owl:ObjectProperty ;
    rdfs:label "ActivationLink" ;
    rdfs:comment "A LINK where a control process is activated when a vehicle passes it. Activation links are directional - there will be separate links for each direction of a route." ;
