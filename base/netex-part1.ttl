    netex:isReference true ;
    netex:xsdType "RouteInstructionRefStructure" .

netex:routeInstructions a owl:ObjectProperty ;
    rdfs:label "routeInstructions" ;
    rdfs:comment "Instructions for following a route. +v1.1" ;
    netex:xsdType "routeInstructions_RelStructure" .

netex:routeLink a owl:ObjectProperty ;
    rdfs:label "RouteLink" ;
    netex:xsdType "RouteLink_VersionStructure" .

netex:routePoint a owl:ObjectProperty ;
    rdfs:label "RoutePoint" ;
    netex:xsdType "RoutePoint_VersionStructure" .

netex:routePointRef a owl:ObjectProperty ;
    rdfs:label "RoutePointRef" ;
    rdfs:range netex:RoutePoint ;
    netex:isReference true ;
    netex:xsdType "RoutePointRefStructure" .

