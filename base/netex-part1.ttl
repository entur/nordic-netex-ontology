    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:comment "Width of EQUIPMENT or entrance to EQUIPMENT (e.g. Lift)." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:width ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            rdfs:comment "Height of EQUIPMENT or entrance to EQUIPMENT (e.g. Lift)." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:height ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:directionOfUse ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:passengersPerMinute ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:relativeWeighting ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:safeForGuideDog ;
            netex:xsdSequenceOrder 6 ],
        netex:PlaceEquipment_VersionStructure ;
    netex:abstract true .

netex:LocalService_VersionStructure a owl:Class ;
    rdfs:label "LocalService" ;
    rdfs:comment "Type for a LOCAL SERVICE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:typesOfServiceFeature ;
            netex:xsdSequenceOrder 1 ],
        netex:Equipment_VersionStructure ;
    netex:abstract true .

netex:description a owl:ObjectProperty ;
    rdfs:label "Description" ;
    rdfs:comment "Description of LEVEL." ;
    netex:xsdType "MultilingualString" .

netex:destinationDisplayRef a owl:ObjectProperty ;
    rdfs:label "DestinationDisplayRef" ;
    rdfs:range netex:DestinationDisplay ;
    netex:isReference true ;
    netex:xsdType "DestinationDisplayRefStructure" .

netex:label a owl:ObjectProperty ;
    rdfs:label "Label" ;
    rdfs:comment "Label of ENTRANCE." ;
    netex:xsdType "MultilingualString" .

netex:lineRef a owl:ObjectProperty ;
    rdfs:label "LineRef" ;
    rdfs:range netex:Line ;
    netex:isReference true ;
    netex:xsdType "LineRefStructure" .

netex:shortName a owl:ObjectProperty ;
    rdfs:label "ShortName" ;
    rdfs:comment "Short Name of LEVEL." ;
    netex:xsdType "MultilingualString" .

netex:LocalServiceRefStructure a owl:Class ;
    rdfs:label "LocalService" ;
    rdfs:comment "Type for a reference to a LOCAL SERVICE." ;
    rdfs:subClassOf netex:EquipmentRefStructure .

netex:transportMode a owl:DatatypeProperty ;
    rdfs:label "TransportMode" ;
    rdfs:comment "Description of MODE of LINE." ;
    rdfs:range xsd:NMTOKEN ;
    netex:xsdType "AllPublicTransportModesEnumeration" .

netex:publicCode a owl:ObjectProperty ;
    rdfs:label "PublicCode" ;
    rdfs:comment "Alternative identifier of ENTRANCE shown to Public." ;
    netex:xsdType "PublicCodeStructure" .

netex:AccessEquipmentRefStructure a owl:Class ;
    rdfs:label "AccessEquipment" ;
    rdfs:comment "Type for a reference to an ACCESS EQUIPMENT." ;
    rdfs:subClassOf netex:PlaceEquipmentRefStructure .

netex:name a owl:ObjectProperty ;
    rdfs:label "Name" ;
    rdfs:comment "Name of LEVEL." ;
    netex:xsdType "MultilingualString" .

