    rdfs:label "AccessibilityInfoFacilityList" ;
    netex:xsdType "AccessibilityInfoFacilityListOfEnumerations" .

netex:accessibilityToolList a owl:DatatypeProperty ;
    rdfs:label "AccessibilityToolList" ;
    netex:xsdType "AccessibilityToolListOfEnumerations" .

