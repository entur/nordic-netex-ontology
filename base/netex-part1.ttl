            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:infrastructureLinkRef ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:infrastructurePointRef ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:vehicleStoppingPositions ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:quayAlignments ;
            netex:xsdSequenceOrder 4 ],
        netex:StopPlaceSpace_VersionStructure .

netex:VehicleStoppingPosition a owl:Class ;
    rdfs:label "VehicleStoppingPosition" ;
    rdfs:subClassOf netex:VehicleStoppingPosition_VersionStructure ;
    netex:xsdElement true .

netex:VehicleStoppingPositionRefStructure a owl:Class ;
    rdfs:label "VehicleStoppingPosition" ;
    rdfs:comment "Type for reference to a VEHICLE STOPPING POSITION." ;
    rdfs:subClassOf netex:StopPlaceSpaceRefStructure .

netex:VehicleStoppingPosition_VersionStructure a owl:Class ;
    rdfs:label "VehicleStoppingPosition" ;
    rdfs:comment "Type for a VEHICLE STOPPING POSITION." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:vehicleStoppingPlaceRef ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            rdfs:comment "Additional Label of a VEHICLE STOPPING POSITION." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:label ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:relationToVehicle ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            rdfs:comment "Bearing of vehicle in position in absolute degrees against North." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:bearing ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:vehiclePositionAlignments ;
            netex:xsdSequenceOrder 5 ],
        netex:StopPlaceComponent_VersionStructure .

netex:VehicleTypeAtPointRefStructure a owl:Class ;
    rdfs:label "VehicleTypeAtPoint" ;
    rdfs:comment "Type for Reference to a VEHICLE TYPE AT POINT." ;
    rdfs:subClassOf netex:NetworkRestrictionRefStructure .

netex:VehicleTypeAtPoint_VersionStructure a owl:Class ;
    rdfs:label "VehicleTypeAtPoint" ;
    rdfs:comment "Type for a VEHICLE TYPE AT POINT." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:forVehicleTypeRef ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:capacity ;
            netex:xsdSequenceOrder 2 ],
        netex:NetworkRestriction_VersionStructure .

netex:VehicleTypePreferenceRefStructure a owl:Class ;
    rdfs:label "VehicleTypePreference" ;
    rdfs:comment "Type for a reference to a VEHICLE TYPE PREFERENCE." ;
    rdfs:subClassOf netex:JourneyTimingRefStructure .

netex:VehicleTypePreference_VersionedChildStructure a owl:Class ;
    rdfs:label "VehicleTypePreference" ;
    rdfs:comment "Type for a VEHICLE TYPE PREFERENCE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:rank ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:dayTypeRef ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:vehicleTypeRef ;
            netex:xsdSequenceOrder 3 ],
        netex:JourneyTiming_VersionedChildStructure .

netex:WaitingEquipmentRefStructure a owl:Class ;
    rdfs:label "WaitingEquipment" ;
    rdfs:comment "Type for a reference to an WAITING EQUIPMENT." ;
    rdfs:subClassOf netex:SiteEquipmentRefStructure .

netex:WaitingRoomEquipmentRefStructure a owl:Class ;
    rdfs:label "WaitingRoomEquipment" ;
    rdfs:comment "Type for a reference to an WAITING ROOM EQUIPMENT." ;
    rdfs:subClassOf netex:SiteEquipmentRefStructure .

netex:WaitingRoomEquipment_VersionStructure a owl:Class ;
    rdfs:label "WaitingRoomEquipment" ;
    rdfs:comment "Type for a Waiting Room EQUIPMENT." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:fareClass ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:womenOnly ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:sanitary ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:classOfUseRef ;
            netex:xsdSequenceOrder 4 ],
        netex:WaitingEquipment_VersionStructure .

netex:WireElement_VersionStructure a owl:Class ;
    rdfs:label "WireElement" ;
    rdfs:comment "Type for WIRE ELEMENT." ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:comment "Identifier of POINT from which Link starts." ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:fromPointRef ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            rdfs:comment "Identifier of POINT at which Link ends." ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:toPointRef ;
            netex:xsdSequenceOrder 2 ],
        netex:InfrastructureLink_VersionStructure .

netex:WireJunction_VersionStructure a owl:Class ;
    rdfs:label "WireJunction" ;
    rdfs:comment "Type for WIRE JUNCTION." ;
    rdfs:subClassOf netex:InfrastructurePoint_VersionStructure .

netex:WireLinkRefByValueStructure a owl:Class ;
    rdfs:label "WireLinkRefByValue" ;
    rdfs:comment "Type for a reference to a WIRE LINK BY VALUE." ;
    rdfs:subClassOf netex:LinkRefByValueStructure .

netex:WireLinkRefStructure a owl:Class ;
    rdfs:label "WireLink" ;
    rdfs:comment "Type for Reference to a WIRE LINK." ;
    rdfs:subClassOf netex:InfrastructureLinkRefStructure .

netex:WirePointRefStructure a owl:Class ;
    rdfs:label "WirePoint" ;
    rdfs:comment "Type for Reference to a WIRE POINT." ;
    rdfs:subClassOf netex:InfrastructurePointRefStructure .

netex:abridgementRanking a owl:DatatypeProperty ;
