netex:ViaTypeEnumeration a rdfs:Datatype ;
    rdfs:label "ViaTypeEnumeration" ;
    rdfs:comment "Allowed values Classification of Via." ;
    owl:oneOf ( "stopPoint" "name" "other" ) .

netex:Via_VersionedChildStructure a owl:Class ;
    rdfs:label "Via" ;
    rdfs:comment "A secondary heading (e.g. ROUTE POINT or other place) showing intermediate places on the way to a destination." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:destinationDisplayRef ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:destinationDisplayView ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            rdfs:comment "Arbitrary text name of VIA point. May be place name or other string." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:name ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:routePointRef ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:viaType ;
            netex:xsdSequenceOrder 5 ],
        netex:VersionedChildStructure .

