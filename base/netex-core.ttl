<https://netex-cen.eu/ontology/core> a owl:Ontology ;
    dcterms:created "2026-08-11T10:11:58+02:00" ;
    dcterms:source "NeTEx_publication.xsd" ;
    dcterms:title "NeTEx core (root schemas)" ;
    owl:versionInfo "482a533" .

netex:PublicationDeliveryStructure a owl:Class ;
    rdfs:label "PublicationDelivery" ;
    rdfs:comment "Type for Publication Delivery." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:publicationTimestamp ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:participantRef ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:publicationRequest ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:publicationRefreshInterval ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            rdfs:comment "Description of contents." ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:description ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:dataObjects ;
            netex:xsdSequenceOrder 6 ] .

netex:PublicationRequestStructure a owl:Class ;
    rdfs:label "PublicationRequest" ;
    rdfs:comment "Type for Publication Request." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:requestTimestamp ;
            netex:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:participantRef ;
            netex:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:description ;
            netex:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:topics ;
            netex:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:requestPolicy ;
            netex:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty netex:subscriptionPolicy ;
            netex:xsdSequenceOrder 6 ] .

netex:dataObjects a owl:DatatypeProperty ;
    rdfs:label "dataObjects" ;
    rdfs:comment "NeTEx Entities of any type." .

netex:publicationRefreshInterval a owl:DatatypeProperty ;
    rdfs:label "PublicationRefreshInterval" ;
    rdfs:comment "How often data in publication is refreshed." ;
    rdfs:range xsd:duration ;
    netex:xsdType "xsd:duration" .

netex:publicationRequest a owl:ObjectProperty ;
    rdfs:label "PublicationRequest" ;
    rdfs:comment "Echo Request used to create bulk response." ;
    netex:xsdType "PublicationRequestStructure" .

netex:publicationTimestamp a owl:DatatypeProperty ;
    rdfs:label "PublicationTimestamp" ;
    rdfs:comment "Time of output of data." ;
    rdfs:range xsd:dateTime ;
    netex:xsdType "xsd:dateTime" .

netex:requestPolicy a owl:ObjectProperty ;
    rdfs:label "RequestPolicy" ;
    rdfs:comment "Policies to apply when fetching data specified by Topics." ;
    netex:xsdType "NetworkFrameRequestPolicyStructure" .

netex:requestTimestamp a owl:DatatypeProperty ;
    rdfs:label "RequestTimestamp" ;
    rdfs:comment "Time of request." ;
    rdfs:range xsd:dateTime ;
    netex:xsdType "xsd:dateTime" .

netex:subscriptionPolicy a owl:ObjectProperty ;
    rdfs:label "SubscriptionPolicy" ;
    rdfs:comment "Policy to use when processing Network Subscriptions." ;
    netex:xsdType "NetworkFrameSubscriptionPolicyStructure" .

netex:topics a owl:DatatypeProperty ;
    rdfs:label "topics" ;
    rdfs:comment "One or more Request filters that specify tthe data to be included in output. Multiple filters are logically ANDed." .

netex:description a owl:ObjectProperty ;
    rdfs:label "Description" ;
    netex:xsdType "MultilingualString" .

netex:participantRef a owl:ObjectProperty ;
    rdfs:label "ParticipantRef" ;
    netex:isReference true ;
    netex:xsdType "siri:ParticipantCodeType" .

