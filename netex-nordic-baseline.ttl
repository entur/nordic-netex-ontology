## -----------------------------------------------------------------
## Nordic NeTEx Profile — Baseline (positive membership allowlist)
## -----------------------------------------------------------------
## Seeded once from the nordic-netex-documentation Table_*.md files as
## the pre-CCB field inventory. Nordic-owned classes carry
## profile:scope profile:NP; downstream profiles may assign other classes
## to their own profile while reusing these field definitions. From
## here the Nordic profile inherits from CCB decisions — a change flips
## a field's provenance from nordic:Baseline to nordic:decision "NP-xxxx".
## This file is not regenerated from documentation; the seeder is a local
## bootstrap aid.
## -----------------------------------------------------------------

@prefix netex:   <https://netex-cen.eu/ontology#> .
@prefix nordic:  <https://netex-cen.eu/nordic#> .
@prefix profile: <https://netex-cen.eu/profile#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .

<https://netex-cen.eu/profile/nordic-baseline> a owl:Ontology ;
    rdfs:label "Nordic NeTEx Profile — Baseline" ;
    rdfs:comment "Positive membership allowlist: which classes and fields are in the profile, with cardinality." ;
    owl:imports <https://netex-cen.eu/nordic> ,
                <https://netex-cen.eu/profile/nordic> .

## --- AlternativeName (NP) ---
netex:AlternativeName profile:scope profile:NP ;
    nordic:provenance nordic:Baseline .

[] a nordic:ProfileMember ;
    nordic:onClass netex:AlternativeName ;
    nordic:element "NameType" ;
    nordic:path "AlternativeName/NameType" ;
    nordic:cardinality "0..1" ;
    nordic:provenance nordic:Baseline .
[] a nordic:ProfileMember ;
    nordic:onClass netex:AlternativeName ;
    nordic:element "Name" ;
    nordic:path "AlternativeName/Name" ;
    nordic:cardinality "1..1" ;
    nordic:provenance nordic:Baseline .

