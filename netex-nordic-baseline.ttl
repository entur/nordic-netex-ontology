## -----------------------------------------------------------------
## Nordic NeTEx Profile — Baseline (positive membership allowlist)
## -----------------------------------------------------------------
## Seeded once from the nordic-netex-documentation Table_*.md files as
## the pre-CCB field inventory. Each profiled class is a nordic:X
## profile:ProfileClass pointing at netex:X via profile:onClass, with
## profile:scope profile:NP; fields hang on it via profile:memberOf.
## Nothing here is asserted on the netex: classes themselves. From
## here the Nordic profile inherits from CCB decisions — a change flips
## a field's provenance from nordic:Baseline to nordic:decision "NP-xxxx".
## This file is not regenerated from documentation; the seeder is a local
## bootstrap aid.
## -----------------------------------------------------------------

@prefix netex:   <https://netex-cen.eu/ontology#> .
@prefix nordic:  <https://netex-cen.eu/nordic#> .
@prefix profile: <https://netex-cen.eu/profile#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .

<https://netex-cen.eu/profile/nordic-baseline> a owl:Ontology ;
    rdfs:label "Nordic NeTEx Profile — Baseline" ;
    rdfs:comment "Positive membership allowlist: which classes and fields are in the profile, with cardinality." ;
    owl:imports <https://netex-cen.eu/nordic> ,
                <https://netex-cen.eu/profile/nordic> .

## --- AccessibilityAssessment (NP) ---
nordic:AccessibilityAssessment a profile:ProfileClass ;
    profile:onClass netex:AccessibilityAssessment ;
    profile:scope profile:NP ;
    nordic:provenance nordic:Baseline .

## --- AccessibilityLimitation (NP) ---
nordic:AccessibilityLimitation a profile:ProfileClass ;
    profile:onClass netex:AccessibilityLimitation ;
    profile:scope profile:NP ;
    nordic:provenance nordic:Baseline .

## --- AlternativeName (NP) ---
nordic:AlternativeName a profile:ProfileClass ;
    profile:onClass netex:AlternativeName ;
    profile:scope profile:NP ;
    nordic:provenance nordic:Baseline .

[] a profile:ProfileMember ;
    profile:memberOf nordic:AlternativeName ;
    profile:element "NameType" ;
    profile:path "AlternativeName/NameType" ;
    profile:cardinality "0..1" ;
    nordic:provenance nordic:Baseline .
[] a profile:ProfileMember ;
    profile:memberOf nordic:AlternativeName ;
    profile:element "Name" ;
    profile:path "AlternativeName/Name" ;
    profile:cardinality "1..1" ;
    nordic:provenance nordic:Baseline .

