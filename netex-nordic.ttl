## -----------------------------------------------------------------
## Nordic NeTEx Profile Ontology
## -----------------------------------------------------------------
## ROLE: Defines what the Nordic Profile ALLOWS, REQUIRES, and EXCLUDES
##       beyond the XSD schema. Cardinality tightening, element ordering,
##       and navigational domain chains.
##
## This is the shared Nordic agreement (NO, SE, FI, DK) — constraints
## that go beyond what XSD expresses but are mandatory for interoperability.
##
## Imports:
##   netex.ttl (generated) — CEN-owned NeTEx base ontology, provided via submodule
##   netex-nordic-vocab.ttl — Nordic-specific vocabulary (nordic:)
## -----------------------------------------------------------------

@prefix netex:   <https://netex-cen.eu/ontology#> .
@prefix nordic:  <https://netex-cen.eu/nordic#> .
@prefix profile: <https://netex-cen.eu/profile#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .

## --- Import generated NeTEx base + Nordic vocabulary ---
<https://netex-cen.eu/profile/nordic> a owl:Ontology ;
    owl:imports <https://netex-cen.eu/ontology> ,
                <https://netex-cen.eu/nordic> .

## =================================================================
## PROFILE DEFINITION
## =================================================================

profile:NP a nordic:Profile ;
    rdfs:label "Nordic Profile" ;
    skos:notation "NP" ;
    skos:definition "Shared NeTEx profile for Norway, Sweden, Finland and Denmark" ;
    nordic:dataConfidence [
        nordic:level "HIGH" ;
        nordic:basis "Multiple production datasets from Entur (NO), validated element ordering against live exports. Profile maintained by cross-Nordic editorial team." ;
        nordic:datasets "Entur aggregated NeTEx (VYG), per-line exports, Entur stop register" ;
        nordic:lastValidated "2026-06"
    ] .

## =================================================================
## PROFILE CONSTRAINTS — SHACL SHAPES
## =================================================================
## NP-specific exclusions, allowances, and cardinality tightening.
## Expressed as SHACL NodeShapes for validation with standard tooling
## (pySHACL, Apache Jena, TopBraid).
##
## sh:path references point to the generated object/datatype
## properties in the NeTEx base ontology (lowerCamelCase, derived
## 1:1 from the XSD element names), enabling traceability between
## constraints and the base schema vocabulary.
##
## Shape naming: profile:NP_{ClassName}Shape
## -----------------------------------------------------------------

## --- StopPlace ---

profile:NP_StopPlaceShape a sh:NodeShape ;
    sh:targetClass netex:StopPlace ;
    rdfs:label "StopPlace — NP constraints" ;
    ## Excluded
    sh:property [
        sh:path netex:parentSiteRef ;
        sh:maxCount 0 ;
        sh:name "ParentSiteRef" ;
        sh:description "Not used in NP — stop hierarchy managed by central registry"
    ] , [
        sh:path netex:tariffZoneRef ;
        sh:maxCount 0 ;
        sh:name "TariffZoneRef" ;
        sh:description "Not used in NP"
    ] ;
    ## Allowed (0..1)
    sh:property [
        sh:path netex:topographicPlaceRef ;
        sh:maxCount 1 ;
        sh:name "TopographicPlaceRef"
    ] , [
        sh:path netex:validBetween ;
        sh:maxCount 1 ;
        sh:name "ValidBetween"
    ] , [
        sh:path netex:accessibilityAssessment ;
        sh:maxCount 1 ;
        sh:name "AccessibilityAssessment"
    ] .

## --- Quay ---

profile:NP_QuayShape a sh:NodeShape ;
    sh:targetClass netex:Quay ;
    rdfs:label "Quay — NP constraints" ;
    sh:property [
        sh:path netex:accessibilityAssessment ;
        sh:maxCount 1 ;
        sh:name "AccessibilityAssessment"
    ] , [
        sh:path netex:boardingPositions ;
        sh:maxCount 1 ;
        sh:name "boardingPositions"
    ] .

## --- Line ---

profile:NP_LineShape a sh:NodeShape ;
    sh:targetClass netex:Line ;
    rdfs:label "Line — NP constraints" ;
    sh:property [
        sh:path netex:representedByGroupRef ;
        sh:maxCount 1 ;
        sh:name "RepresentedByGroupRef"
    ] , [
        sh:path netex:transportSubmode ;
        sh:maxCount 1 ;
        sh:name "TransportSubmode"
    ] , [
        sh:path netex:publicCode ;
        sh:maxCount 1 ;
        sh:name "PublicCode"
    ] , [
        sh:path netex:privateCode ;
        sh:maxCount 1 ;
        sh:name "PrivateCode"
    ] .

## --- ServiceJourney ---

profile:NP_ServiceJourneyShape a sh:NodeShape ;
    sh:targetClass netex:ServiceJourney ;
    rdfs:label "ServiceJourney — NP constraints" ;
    ## Excluded
    sh:property [
        sh:path netex:flexibleLineRef ;
        sh:maxCount 0 ;
        sh:name "FlexibleLineRef" ;
        sh:description "Not used in NP — use Line with FlexibleServiceProperties"
    ] , [
        sh:path netex:blockRef ;
        sh:maxCount 0 ;
        sh:name "BlockRef" ;
        sh:description "Not used in NP — block assignment via DatedServiceJourney"
    ] .

## --- JourneyPattern ---

profile:NP_JourneyPatternShape a sh:NodeShape ;
    sh:targetClass netex:JourneyPattern ;
    rdfs:label "JourneyPattern — NP constraints" ;
    ## Required (tightened from XSD 0..1)
    sh:property [
        sh:path netex:routeRef ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class netex:Route ;
        sh:name "RouteRef" ;
        sh:description "XSD allows 0..1, NP mandates 1..1"
    ] .

## --- Vehicle ---

profile:NP_VehicleShape a sh:NodeShape ;
    sh:targetClass netex:Vehicle ;
    rdfs:label "Vehicle — NP constraints" ;
    ## Required (tightened from XSD 0..1)
    sh:property [
        sh:path netex:vehicleTypeRef ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class netex:VehicleType ;
        sh:name "VehicleTypeRef" ;
        sh:description "XSD allows 0..1, NP mandates 1..1"
    ] .

## --- Authority ---

profile:NP_AuthorityShape a sh:NodeShape ;
    sh:targetClass netex:Authority ;
    rdfs:label "Authority — NP constraints" ;
    sh:property [
        sh:path netex:name ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:name "Name" ;
        sh:description "XSD allows 0..1, NP mandates 1..1"
    ] .

## --- Operator ---

profile:NP_OperatorShape a sh:NodeShape ;
    sh:targetClass netex:Operator ;
    rdfs:label "Operator — NP constraints" ;
    sh:property [
        sh:path netex:name ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:name "Name" ;
        sh:description "XSD allows 0..1, NP mandates 1..1"
    ] .

## --- VehicleType ---

profile:NP_VehicleTypeShape a sh:NodeShape ;
    sh:targetClass netex:VehicleType ;
    rdfs:label "VehicleType — NP constraints" ;
    sh:property [
        sh:path netex:name ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:name "Name" ;
        sh:description "XSD allows 0..1, NP mandates 1..1"
    ] .

## --- FareZone ---

profile:NP_FareZoneShape a sh:NodeShape ;
    sh:targetClass netex:FareZone ;
    rdfs:label "FareZone — NP constraints" ;
    sh:property [
        sh:path netex:name ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:name "Name" ;
        sh:description "XSD allows 0..1, NP mandates 1..1"
    ] .

## --- Interchange ---

profile:NP_InterchangeShape a sh:NodeShape ;
    sh:targetClass netex:Interchange ;
    rdfs:label "Interchange — NP constraints" ;
    sh:property [
        sh:path netex:fromPointRef ;
        sh:maxCount 1 ;
        sh:name "FromPointRef"
    ] , [
        sh:path netex:toPointRef ;
        sh:maxCount 1 ;
        sh:name "ToPointRef"
    ] .

## --- DatedServiceJourney ---

profile:NP_DatedServiceJourneyShape a sh:NodeShape ;
    sh:targetClass netex:DatedServiceJourney ;
    rdfs:label "DatedServiceJourney — NP constraints" ;
    sh:property [
        sh:path netex:serviceJourneyRef ;
        sh:name "ServiceJourneyRef" ;
        sh:description "Reference to the template ServiceJourney this dated instance realizes" ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] , [
        sh:path netex:operatingDayRef ;
        sh:name "OperatingDayRef" ;
        sh:description "The specific operating day this journey runs on" ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] , [
        sh:path netex:datedVehicleJourneyRef ;
        sh:name "DatedVehicleJourneyRef" ;
        sh:description "Deviation/replacement tracking — allowed in NP"
    ] , [
        sh:path netex:serviceAlteration ;
        sh:name "ServiceAlteration" ;
        sh:description "Alteration status code when journey deviates from plan" ;
        sh:maxCount 1 ;
        sh:in ( "planned" "cancellation" "replaced" "extraJourney" )
    ] .

## =================================================================
## ELEMENT ORDERING (XSD-derived)
## =================================================================
## Canonical element sequence per class, derived from XSD type
## hierarchy. Tables, descriptions, and generators should follow
## this order. Attributes (@id, @version, @order) are listed first
## by convention — XML attributes have no sequence constraint.
## Only elements documented in the profile Tables are listed.
## -----------------------------------------------------------------

netex:ServiceJourney nordic:elementOrder [
    nordic:position 1 ; nordic:element "@id"
] , [
    nordic:position 2 ; nordic:element "@version"
] , [
    nordic:position 3 ; nordic:element "keyList"
] , [
    nordic:position 4 ; nordic:element "Name"
] , [
    nordic:position 5 ; nordic:element "PrivateCode"
] , [
    nordic:position 6 ; nordic:element "Description"
] , [
    nordic:position 7 ; nordic:element "TransportMode"
] , [
    nordic:position 8 ; nordic:element "TransportSubmode"
] , [
    ## XSD: ServiceTimeGroup — DepartureTime before dayTypes
    nordic:position 9 ; nordic:element "DepartureTime"
] , [
    nordic:position 10 ; nordic:element "DepartureDayOffset"
] , [
    nordic:position 11 ; nordic:element "dayTypes"
] , [
    nordic:position 12 ; nordic:element "JourneyPatternRef"
] , [
    ## XSD: ServiceJourneyPatternRef is the specialised alternative to JourneyPatternRef
    nordic:position 12 ; nordic:element "ServiceJourneyPatternRef"
] , [
    nordic:position 13 ; nordic:element "VehicleTypeRef"
] , [
    nordic:position 14 ; nordic:element "BlockRef"
] , [
    nordic:position 15 ; nordic:element "OperatorRef"
] , [
    nordic:position 16 ; nordic:element "LineRef"
] , [
    nordic:position 17 ; nordic:element "FlexibleLineRef"
] , [
    nordic:position 18 ; nordic:element "passingTimes"
] , [
    nordic:position 19 ; nordic:element "parts"
] .

netex:Operator nordic:elementOrder [
    nordic:position 1 ; nordic:element "@id"
] , [
    nordic:position 2 ; nordic:element "@version"
] , [
    nordic:position 3 ; nordic:element "CompanyNumber"
] , [
    nordic:position 4 ; nordic:element "Name"
] , [
    nordic:position 5 ; nordic:element "ShortName"
] , [
    nordic:position 6 ; nordic:element "LegalName"
] , [
    nordic:position 7 ; nordic:element "ContactDetails"
] , [
    nordic:position 8 ; nordic:element "OrganisationType"
] , [
    nordic:position 9 ; nordic:element "CountryRef"
] , [
    nordic:position 10 ; nordic:element "PrimaryMode"
] , [
    nordic:position 11 ; nordic:element "CustomerServiceContactDetails"
] .

netex:StopPlace nordic:elementOrder [
    nordic:position 1 ; nordic:element "@id"
] , [
    nordic:position 2 ; nordic:element "@version"
] , [
    nordic:position 3 ; nordic:element "ValidBetween"
] , [
    nordic:position 4 ; nordic:element "keyList"
] , [
    nordic:position 5 ; nordic:element "Name"
] , [
    nordic:position 6 ; nordic:element "Centroid"
] , [
    nordic:position 7 ; nordic:element "AccessibilityAssessment"
] , [
    nordic:position 8 ; nordic:element "TopographicPlaceRef"
] , [
    nordic:position 9 ; nordic:element "ParentSiteRef"
] , [
    nordic:position 10 ; nordic:element "TransportMode"
] , [
    nordic:position 11 ; nordic:element "StopPlaceType"
] , [
    nordic:position 12 ; nordic:element "Weighting"
] , [
    nordic:position 13 ; nordic:element "quays"
] .

netex:Line nordic:elementOrder [
    nordic:position 1 ; nordic:element "@id"
] , [
    nordic:position 2 ; nordic:element "@version"
] , [
    nordic:position 3 ; nordic:element "Name"
] , [
    ## XSD: DataManagedObjectGroup — ShortName follows Name
    nordic:position 4 ; nordic:element "ShortName"
] , [
    nordic:position 5 ; nordic:element "TransportMode"
] , [
    nordic:position 6 ; nordic:element "TransportSubmode"
] , [
    nordic:position 7 ; nordic:element "PublicCode"
] , [
    nordic:position 8 ; nordic:element "PrivateCode"
] , [
    ## XSD: LinePropertiesGroup — AuthorityRef before OperatorRef
    nordic:position 9 ; nordic:element "AuthorityRef"
] , [
    nordic:position 10 ; nordic:element "OperatorRef"
] , [
    nordic:position 11 ; nordic:element "Monitored"
] , [
    nordic:position 12 ; nordic:element "RepresentedByGroupRef"
] , [
    nordic:position 13 ; nordic:element "Presentation"
] .

netex:Route nordic:elementOrder [
    nordic:position 1 ; nordic:element "@id"
] , [
    nordic:position 2 ; nordic:element "@version"
] , [
    nordic:position 3 ; nordic:element "Name"
] , [
    nordic:position 4 ; nordic:element "ShortName"
] , [
    nordic:position 5 ; nordic:element "Description"
] , [
    nordic:position 6 ; nordic:element "LineRef"
] , [
    nordic:position 7 ; nordic:element "DirectionType"
] , [
    nordic:position 8 ; nordic:element "pointsInSequence"
] , [
    nordic:position 9 ; nordic:element "InverseRouteRef"
] .

netex:JourneyPattern nordic:elementOrder [
    nordic:position 1 ; nordic:element "@id"
] , [
    nordic:position 2 ; nordic:element "@version"
] , [
    nordic:position 3 ; nordic:element "Name"
] , [
    nordic:position 4 ; nordic:element "RouteRef"
] , [
    nordic:position 5 ; nordic:element "pointsInSequence"
] , [
    nordic:position 6 ; nordic:element "linksInSequence"
] .

netex:DatedServiceJourney nordic:elementOrder [
    nordic:position 1 ; nordic:element "@id"
] , [
    nordic:position 2 ; nordic:element "@version"
] , [
    nordic:position 3 ; nordic:element "ServiceAlteration"
] , [
    nordic:position 4 ; nordic:element "BlockRef"
] , [
    nordic:position 5 ; nordic:element "ServiceJourneyRef"
] , [
    nordic:position 6 ; nordic:element "replacedJourneys"
] , [
    nordic:position 7 ; nordic:element "OperatingDayRef"
] .

netex:DayType nordic:elementOrder [
    nordic:position 1 ; nordic:element "@id"
] , [
    nordic:position 2 ; nordic:element "@version"
] , [
    nordic:position 3 ; nordic:element "Name"
] , [
    nordic:position 4 ; nordic:element "properties"
] .

netex:ScheduledStopPoint nordic:elementOrder [
    nordic:position 1 ; nordic:element "@id"
] , [
    nordic:position 2 ; nordic:element "@version"
] , [
    nordic:position 3 ; nordic:element "ValidBetween"
] , [
    nordic:position 4 ; nordic:element "Name"
] , [
    nordic:position 5 ; nordic:element "TimingPointStatus"
] .

netex:PassengerStopAssignment nordic:elementOrder [
    nordic:position 1 ; nordic:element "@id"
] , [
    nordic:position 2 ; nordic:element "@version"
] , [
    nordic:position 3 ; nordic:element "@order"
] , [
    nordic:position 4 ; nordic:element "ValidBetween"
] , [
    nordic:position 5 ; nordic:element "ScheduledStopPointRef"
] , [
    nordic:position 6 ; nordic:element "StopPlaceRef"
] , [
    nordic:position 7 ; nordic:element "QuayRef"
] .

netex:DestinationDisplay nordic:elementOrder [
    nordic:position 1 ; nordic:element "@id"
] , [
    nordic:position 2 ; nordic:element "@version"
] , [
    nordic:position 3 ; nordic:element "Name"
] , [
    nordic:position 4 ; nordic:element "SideText"
] , [
    nordic:position 5 ; nordic:element "FrontText"
] , [
    nordic:position 6 ; nordic:element "vias"
] .

## =================================================================
## DOMAIN CHAINS (navigational shortcuts)
## =================================================================

nordic:TimetableChain rdfs:comment """
    Line → Route → JourneyPattern → ServiceJourney → DatedServiceJourney
    The core modelling chain: from abstract line identity
    through physical route, stop sequence, timed trip template,
    to a concrete instance on a specific date.
""" ;
    nordic:step1 netex:Line ;
    nordic:step2 netex:Route ;
    nordic:step3 netex:JourneyPattern ;
    nordic:step4 netex:ServiceJourney ;
    nordic:step5 netex:DatedServiceJourney .

nordic:StopChain rdfs:comment """
    ScheduledStopPoint → PassengerStopAssignment → StopPlace → Quay
    The logical-to-physical stop bridge.
""" ;
    nordic:step1 netex:ScheduledStopPoint ;
    nordic:step2 netex:PassengerStopAssignment ;
    nordic:step3 netex:StopPlace ;
    nordic:step4 netex:Quay .

nordic:CalendarChain rdfs:comment """
    DayType → DayTypeAssignment → OperatingPeriod / Date
    How services are bound to dates.
""" ;
    nordic:step1 netex:DayType ;
    nordic:step2 netex:DayTypeAssignment ;
    nordic:step3 netex:OperatingPeriod .

nordic:OrganisationChain rdfs:comment """
    Authority → Contract → Operator → ResponsibilitySet
    Organisational governance and responsibility.
""" ;
    nordic:step1 netex:Authority ;
    nordic:step2 netex:Contract ;
    nordic:step3 netex:Operator ;
    nordic:step4 netex:ResponsibilitySet .

## =================================================================
## END OF NORDIC PROFILE ONTOLOGY
## =================================================================
