## -----------------------------------------------------------------
## Nordic NeTEx Profile Ontology
## -----------------------------------------------------------------
## ROLE: Defines what the Nordic Profile INCLUDES, ALLOWS, REQUIRES and
##       EXCLUDES beyond the XSD schema: the membership allowlist,
##       cardinality tightening, element ordering, and navigational
##       domain chains.
##
## This is the shared Nordic agreement (NO, SE, FI, DK) — constraints
## that go beyond what XSD expresses but are mandatory for interoperability.
##
## Imports:
##   netex.ttl (generated) — CEN-owned NeTEx base ontology, provided via submodule
##   netex-nordic-vocab.ttl — Nordic-specific vocabulary (nordic:)
## -----------------------------------------------------------------

@prefix netex:   <https://netex-cen.eu/ontology#> .
@prefix nordic:  <https://netex-cen.eu/nordic#> .
@prefix profile: <https://netex-cen.eu/profile#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .

## --- Import generated NeTEx base + Nordic vocabulary ---
<https://netex-cen.eu/profile/nordic> a owl:Ontology ;
    rdfs:label "Nordic NeTEx Profile" ;
    rdfs:comment "The Nordic Profile: membership allowlist (profile nodes and fields), SHACL shapes (allow / require / exclude), profile element ordering and navigational domain chains." ;
    owl:imports <https://netex-cen.eu/ontology> ,
                <https://netex-cen.eu/nordic> .

## =================================================================
## PROFILE DEFINITION
## =================================================================

profile:NP a nordic:Profile ,
        profile:Scope ;
    rdfs:label "Nordic Profile" ;
    skos:notation "NP" ;
    skos:definition "Shared NeTEx profile for Norway, Sweden, Finland and Denmark" ;
    nordic:dataConfidence [
        nordic:level "HIGH" ;
        nordic:basis "Multiple production datasets from Entur (NO), validated element ordering against live exports. Profile maintained by cross-Nordic editorial team." ;
        nordic:datasets "Entur aggregated NeTEx (VYG), per-line exports, Entur stop register" ;
        nordic:lastValidated "2026-06"
    ] .

## =================================================================
## PROFILE MEMBERSHIP (positive allowlist)
## =================================================================
## Which classes and fields are in NP. Each class is a nordic:X
## profile:ProfileClass pointing at netex:X; fields hang on it via
## profile:memberOf. nordic:Baseline marks pre-CCB content; CCB changes
## carry nordic:decision "NP-xxxx".
## -----------------------------------------------------------------

## --- AccessibilityAssessment (NP) ---
nordic:AccessibilityAssessment a profile:ProfileClass ;
    profile:onClass netex:AccessibilityAssessment ;
    profile:scope profile:NP ;
    nordic:provenance nordic:Baseline .

## --- AccessibilityLimitation (NP) ---
nordic:AccessibilityLimitation a profile:ProfileClass ;
    profile:onClass netex:AccessibilityLimitation ;
    profile:scope profile:NP ;
    nordic:provenance nordic:Baseline .

## --- AlternativeName (NP) ---
nordic:AlternativeName a profile:ProfileClass ;
    profile:onClass netex:AlternativeName ;
    profile:scope profile:NP ;
    nordic:provenance nordic:Baseline .

[] a profile:ProfileMember ;
    profile:memberOf nordic:AlternativeName ;
    profile:element "NameType" ;
    profile:path "AlternativeName/NameType" ;
    profile:cardinality "0..1" ;
    skos:definition "Classification of the alternative name (e.g., alias, translation, copy)"@en ;
    nordic:provenance nordic:Baseline .
[] a profile:ProfileMember ;
    profile:memberOf nordic:AlternativeName ;
    profile:element "Name" ;
    profile:path "AlternativeName/Name" ;
    profile:cardinality "1..1" ;
    skos:definition "The alternative name text"@en ;
    nordic:provenance nordic:Baseline .

## --- AlternativeText (NP) ---
nordic:AlternativeText a profile:ProfileClass ;
    profile:onClass netex:AlternativeText ;
    profile:scope profile:NP ;
    nordic:provenance nordic:Baseline .

[] a profile:ProfileMember ;
    profile:memberOf nordic:AlternativeText ;
    profile:element "@id" ;
    profile:path "AlternativeText/@id" ;
    profile:cardinality "1..1" ;
    skos:definition "Unique identifier for the alternative text"@en ;
    nordic:provenance nordic:Baseline .
[] a profile:ProfileMember ;
    profile:memberOf nordic:AlternativeText ;
    profile:element "@version" ;
    profile:path "AlternativeText/@version" ;
    profile:cardinality "1..1" ;
    skos:definition "Version number for change tracking"@en ;
    nordic:provenance nordic:Baseline .
[] a profile:ProfileMember ;
    profile:memberOf nordic:AlternativeText ;
    profile:element "Text" ;
    profile:path "AlternativeText/Text" ;
    profile:cardinality "1..1" ;
    skos:definition "The alternative text content"@en ;
    nordic:provenance nordic:Baseline .

