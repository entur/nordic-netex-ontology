    profile:path "ServiceJourneyInterchange/FromJourneyRef/@ref" ;
    profile:cardinality "1..1" ;
    skos:definition "Reference to the originating (feeder) journey"@en ;
    nordic:provenance nordic:Baseline .
[] a profile:ProfileMember ;
