    nordic:provenance nordic:Baseline .
[] a profile:ProfileMember ;
    profile:memberOf nordic:DayTypeAssignment ;
    profile:element "OperatingPeriod/@ref" ;
    profile:path "OperatingPeriodRef/@ref" ;
    profile:cardinality "0..1" ;
