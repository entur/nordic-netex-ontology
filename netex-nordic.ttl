] .

## =================================================================
## DOMAIN CHAINS (navigational shortcuts)
## =================================================================

nordic:TimetableChain rdfs:comment """
    Line → Route → JourneyPattern → ServiceJourney
    The core modelling chain: from abstract line identity
    through physical route and stop sequence to the timed trip.
""" ;
    nordic:step1 netex:Line ;
    nordic:step2 netex:Route ;
    nordic:step3 netex:JourneyPattern ;
    nordic:step4 netex:ServiceJourney .

nordic:StopChain rdfs:comment """
    ScheduledStopPoint → PassengerStopAssignment → StopPlace → Quay
    The logical-to-physical stop bridge.
""" ;
    nordic:step1 netex:ScheduledStopPoint ;
    nordic:step2 netex:PassengerStopAssignment ;
    nordic:step3 netex:StopPlace ;
    nordic:step4 netex:Quay .

nordic:CalendarChain rdfs:comment """
    DayType → DayTypeAssignment → OperatingPeriod / Date
    How services are bound to dates.
""" ;
    nordic:step1 netex:DayType ;
    nordic:step2 netex:DayTypeAssignment ;
    nordic:step3 netex:OperatingPeriod .

## =================================================================
## END OF NORDIC PROFILE ONTOLOGY
## =================================================================
