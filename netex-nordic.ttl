## =================================================================
## PROFILE CONSTRAINTS — SHACL SHAPES
## =================================================================
## NP-specific exclusions, allowances, and cardinality tightening.
## Expressed as SHACL NodeShapes for validation with standard tooling
## (pySHACL, Apache Jena, TopBraid).
##
## sh:path references point to the generated object/datatype
## properties in the NeTEx base ontology (lowerCamelCase, derived
## 1:1 from the XSD element names), enabling traceability between
## constraints and the base schema vocabulary.
##
## Shape naming: profile:NP_{ClassName}Shape
## -----------------------------------------------------------------

## --- StopPlace ---

profile:NP_StopPlaceShape a sh:NodeShape ;
    sh:targetClass netex:StopPlace ;
    rdfs:label "StopPlace — NP constraints" ;
    ## Excluded
    sh:property [
        sh:path netex:tariffZoneRef ;
        sh:maxCount 0 ;
        sh:name "TariffZoneRef" ;
        sh:description "Not used in NP"
    ] ;
    ## Allowed (0..1)
    sh:property [
        sh:path netex:topographicPlaceRef ;
        sh:maxCount 1 ;
        sh:name "TopographicPlaceRef"
    ] , [
        sh:path netex:parentSiteRef ;
        sh:maxCount 1 ;
        sh:name "ParentSiteRef" ;
        sh:description "Used for multimodal StopPlace hierarchy (child stop referencing its parent), confirmed present in NSR exports"
    ] , [
        sh:path netex:validBetween ;
        sh:maxCount 1 ;
        sh:name "ValidBetween"
    ] , [
        sh:path netex:accessibilityAssessment ;
        sh:maxCount 1 ;
        sh:name "AccessibilityAssessment"
    ] .

## --- Quay ---

profile:NP_QuayShape a sh:NodeShape ;
    sh:targetClass netex:Quay ;
    rdfs:label "Quay — NP constraints" ;
    sh:property [
        sh:path netex:accessibilityAssessment ;
        sh:maxCount 1 ;
        sh:name "AccessibilityAssessment"
    ] , [
        sh:path netex:boardingPositions ;
        sh:maxCount 1 ;
        sh:name "boardingPositions"
    ] .

## --- Line ---

profile:NP_LineShape a sh:NodeShape ;
    sh:targetClass netex:Line ;
    rdfs:label "Line — NP constraints" ;
    sh:property [
        sh:path netex:representedByGroupRef ;
        sh:maxCount 1 ;
        sh:name "RepresentedByGroupRef"
    ] , [
        sh:path netex:transportSubmode ;
        sh:maxCount 1 ;
        sh:name "TransportSubmode"
    ] , [
        sh:path netex:publicCode ;
        sh:maxCount 1 ;
        sh:name "PublicCode"
    ] , [
        sh:path netex:privateCode ;
        sh:maxCount 1 ;
        sh:name "PrivateCode"
    ] .

## --- ServiceJourney ---

profile:NP_ServiceJourneyShape a sh:NodeShape ;
    sh:targetClass netex:ServiceJourney ;
    rdfs:label "ServiceJourney — NP constraints" ;
    ## Excluded
    sh:property [
        sh:path netex:flexibleLineRef ;
        sh:maxCount 0 ;
        sh:name "FlexibleLineRef" ;
        sh:description "Not used in NP — use Line with FlexibleServiceProperties"
    ] , [
        sh:path netex:blockRef ;
        sh:maxCount 0 ;
        sh:name "BlockRef" ;
        sh:description "Not used in NP"
    ] .

## --- JourneyPattern ---

profile:NP_JourneyPatternShape a sh:NodeShape ;
    sh:targetClass netex:JourneyPattern ;
    rdfs:label "JourneyPattern — NP constraints" ;
    ## Required (tightened from XSD 0..1)
    sh:property [
        sh:path netex:routeRef ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class netex:Route ;
        sh:name "RouteRef" ;
        sh:description "XSD allows 0..1, NP mandates 1..1"
    ] .

## --- Vehicle ---

profile:NP_VehicleShape a sh:NodeShape ;
    sh:targetClass netex:Vehicle ;
    rdfs:label "Vehicle — NP constraints" ;
    ## Required (tightened from XSD 0..1)
    sh:property [
        sh:path netex:vehicleTypeRef ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class netex:VehicleType ;
        sh:name "VehicleTypeRef" ;
        sh:description "XSD allows 0..1, NP mandates 1..1"
    ] .

## --- Authority ---

profile:NP_AuthorityShape a sh:NodeShape ;
    sh:targetClass netex:Authority ;
    rdfs:label "Authority — NP constraints" ;
    sh:property [
        sh:path netex:name ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:name "Name" ;
        sh:description "XSD allows 0..1, NP mandates 1..1"
    ] .

## --- Operator ---

profile:NP_OperatorShape a sh:NodeShape ;
    sh:targetClass netex:Operator ;
    rdfs:label "Operator — NP constraints" ;
    sh:property [
        sh:path netex:name ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:name "Name" ;
        sh:description "XSD allows 0..1, NP mandates 1..1"
    ] .

## --- VehicleType ---

profile:NP_VehicleTypeShape a sh:NodeShape ;
    sh:targetClass netex:VehicleType ;
    rdfs:label "VehicleType — NP constraints" ;
    sh:property [
        sh:path netex:name ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:name "Name" ;
        sh:description "XSD allows 0..1, NP mandates 1..1"
    ] .

## --- Interchange ---

profile:NP_InterchangeShape a sh:NodeShape ;
    sh:targetClass netex:ServiceJourneyInterchange ;
    rdfs:label "Interchange — NP constraints" ;
    sh:property [
        sh:path netex:fromPointRef ;
        sh:maxCount 1 ;
        sh:name "FromPointRef"
    ] , [
        sh:path netex:toPointRef ;
        sh:maxCount 1 ;
        sh:name "ToPointRef"
    ] .

## =================================================================
## ELEMENT ORDERING (XSD-derived)
## =================================================================
## Canonical element sequence per class, derived from XSD type
## hierarchy. Tables, descriptions, and generators should follow
## this order. Attributes (@id, @version, @order) are listed first
## by convention — XML attributes have no sequence constraint.
## Only elements documented in the profile Tables are listed.
## -----------------------------------------------------------------

nordic:ServiceJourney profile:elementOrder [
    profile:position 1 ; profile:element "@id"
] , [
    profile:position 2 ; profile:element "@version"
] , [
    profile:position 3 ; profile:element "keyList"
] , [
    profile:position 4 ; profile:element "Name"
] , [
    profile:position 5 ; profile:element "PrivateCode"
] , [
    profile:position 6 ; profile:element "Description"
] , [
    profile:position 7 ; profile:element "TransportMode"
] , [
    profile:position 8 ; profile:element "TransportSubmode"
] , [
    ## XSD: ServiceTimeGroup — DepartureTime before dayTypes
    profile:position 9 ; profile:element "DepartureTime"
] , [
    profile:position 10 ; profile:element "DepartureDayOffset"
] , [
    profile:position 11 ; profile:element "dayTypes"
] , [
    profile:position 12 ; profile:element "JourneyPatternRef"
] , [
    ## XSD: ServiceJourneyPatternRef is the specialised alternative to JourneyPatternRef
    profile:position 12 ; profile:element "ServiceJourneyPatternRef"
] , [
    profile:position 13 ; profile:element "VehicleTypeRef"
] , [
    profile:position 14 ; profile:element "BlockRef"
] , [
    profile:position 15 ; profile:element "OperatorRef"
] , [
    profile:position 16 ; profile:element "LineRef"
] , [
    profile:position 17 ; profile:element "FlexibleLineRef"
] , [
    profile:position 18 ; profile:element "passingTimes"
] , [
    profile:position 19 ; profile:element "parts"
] .

nordic:Operator profile:elementOrder [
    profile:position 1 ; profile:element "@id"
] , [
    profile:position 2 ; profile:element "@version"
] , [
    profile:position 3 ; profile:element "CompanyNumber"
] , [
    profile:position 4 ; profile:element "Name"
] , [
    profile:position 5 ; profile:element "ShortName"
] , [
    profile:position 6 ; profile:element "LegalName"
] , [
    profile:position 7 ; profile:element "ContactDetails"
] , [
    profile:position 8 ; profile:element "OrganisationType"
] , [
    profile:position 9 ; profile:element "CountryRef"
] , [
    profile:position 10 ; profile:element "PrimaryMode"
] , [
    profile:position 11 ; profile:element "CustomerServiceContactDetails"
] .

nordic:StopPlace profile:elementOrder [
    profile:position 1 ; profile:element "@id"
] , [
    profile:position 2 ; profile:element "@version"
] , [
    profile:position 3 ; profile:element "ValidBetween"
] , [
    profile:position 4 ; profile:element "keyList"
] , [
    profile:position 5 ; profile:element "Name"
] , [
    profile:position 6 ; profile:element "Centroid"
] , [
    profile:position 7 ; profile:element "AccessibilityAssessment"
] , [
    profile:position 8 ; profile:element "TopographicPlaceRef"
] , [
    profile:position 9 ; profile:element "ParentSiteRef"
] , [
    profile:position 10 ; profile:element "TransportMode"
] , [
    profile:position 11 ; profile:element "StopPlaceType"
] , [
    profile:position 12 ; profile:element "Weighting"
] , [
    profile:position 13 ; profile:element "quays"
] .

nordic:Line profile:elementOrder [
    profile:position 1 ; profile:element "@id"
] , [
    profile:position 2 ; profile:element "@version"
] , [
    profile:position 3 ; profile:element "Name"
] , [
    ## XSD: DataManagedObjectGroup — ShortName follows Name
    profile:position 4 ; profile:element "ShortName"
] , [
    profile:position 5 ; profile:element "TransportMode"
] , [
    profile:position 6 ; profile:element "TransportSubmode"
] , [
    profile:position 7 ; profile:element "PublicCode"
] , [
    profile:position 8 ; profile:element "PrivateCode"
] , [
    ## XSD: LinePropertiesGroup — AuthorityRef before OperatorRef
    profile:position 9 ; profile:element "AuthorityRef"
] , [
    profile:position 10 ; profile:element "OperatorRef"
] , [
    profile:position 11 ; profile:element "Monitored"
] , [
    profile:position 12 ; profile:element "RepresentedByGroupRef"
] , [
    profile:position 13 ; profile:element "Presentation"
] .

nordic:Route profile:elementOrder [
    profile:position 1 ; profile:element "@id"
] , [
    profile:position 2 ; profile:element "@version"
] , [
    profile:position 3 ; profile:element "Name"
] , [
    profile:position 4 ; profile:element "ShortName"
] , [
    profile:position 5 ; profile:element "Description"
] , [
    profile:position 6 ; profile:element "LineRef"
] , [
    profile:position 7 ; profile:element "DirectionType"
] , [
    profile:position 8 ; profile:element "pointsInSequence"
] , [
    profile:position 9 ; profile:element "InverseRouteRef"
] .

nordic:JourneyPattern profile:elementOrder [
    profile:position 1 ; profile:element "@id"
] , [
    profile:position 2 ; profile:element "@version"
] , [
    profile:position 3 ; profile:element "Name"
] , [
    profile:position 4 ; profile:element "RouteRef"
] , [
    profile:position 5 ; profile:element "pointsInSequence"
] , [
    profile:position 6 ; profile:element "linksInSequence"
] .

nordic:DayType profile:elementOrder [
    profile:position 1 ; profile:element "@id"
] , [
    profile:position 2 ; profile:element "@version"
] , [
    profile:position 3 ; profile:element "Name"
] , [
    profile:position 4 ; profile:element "properties"
] .

nordic:ScheduledStopPoint profile:elementOrder [
    profile:position 1 ; profile:element "@id"
] , [
