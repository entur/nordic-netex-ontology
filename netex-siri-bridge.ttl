## -----------------------------------------------------------------
## NeTEx ⇄ SIRI Real-time Bridges
## -----------------------------------------------------------------
## ROLE: Curated overlay recording which generated NeTEx classes are
##       referenced by SIRI real-time services (ET, SX, VM, FM) via ID.
##       Not derived from the XSD — an editorial cross-standard bridge.
##
## Uses nordic:referencedBySIRI (defined in netex-nordic-vocab.ttl).
## Loaded alongside the generated base ontology.
## -----------------------------------------------------------------

@prefix netex:  <https://netex-cen.eu/ontology#> .
@prefix nordic: <https://netex-cen.eu/nordic#> .
@prefix siri:   <https://siri-cen.eu/ontology#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .

<https://netex-cen.eu/bridge/siri> a owl:Ontology ;
    rdfs:label "NeTEx–SIRI Real-time Bridges" ;
    owl:imports <https://netex-cen.eu/ontology> ,
                <https://netex-cen.eu/nordic> ;
    rdfs:comment "Editorial mapping of generated NeTEx classes to the SIRI services that reference them." .

siri:SIRI_ET a siri:Service ;
    rdfs:label "SIRI-ET — Estimated Timetable" ;
    siri:externalRepo "Profile_Documentation_SIRI" .

siri:SIRI_SX a siri:Service ;
    rdfs:label "SIRI-SX — Situation Exchange" ;
    siri:externalRepo "Profile_Documentation_SIRI" .

siri:SIRI_VM a siri:Service ;
    rdfs:label "SIRI-VM — Vehicle Monitoring" ;
    siri:externalRepo "Profile_Documentation_SIRI" .

siri:SIRI_FM a siri:Service ;
    rdfs:label "SIRI-FM — Facility Monitoring" ;
    siri:externalRepo "Profile_Documentation_SIRI" .

netex:Line nordic:referencedBySIRI siri:SIRI_ET , siri:SIRI_SX , siri:SIRI_VM , siri:SIRI_FM ;
    rdfs:comment "Via LineRef in EstimatedVehicleJourney, MonitoredVehicleJourney, AffectedLine, FacilityLocation" .

netex:Route nordic:referencedBySIRI siri:SIRI_ET , siri:SIRI_SX ;
    rdfs:comment "Via RouteRef in EstimatedVehicleJourney (mandatory for replacements), AffectedRoute" .

netex:ServiceJourney nordic:referencedBySIRI siri:SIRI_ET , siri:SIRI_VM , siri:SIRI_SX ;
    rdfs:comment "Via FramedVehicleJourneyRef / DatedVehicleJourneyRef" .

netex:DatedServiceJourney nordic:referencedBySIRI siri:SIRI_ET , siri:SIRI_VM , siri:SIRI_SX , siri:SIRI_FM ;
    rdfs:comment "Via DatedVehicleJourneyRef in all services" .

netex:JourneyPattern nordic:referencedBySIRI siri:SIRI_ET ;
    rdfs:comment "Via JourneyPatternRef in EstimatedVehicleJourney" .

netex:Operator nordic:referencedBySIRI siri:SIRI_ET , siri:SIRI_VM , siri:SIRI_SX , siri:SIRI_FM ;
    rdfs:comment "Via OperatorRef in all services" .

netex:Quay nordic:referencedBySIRI siri:SIRI_ET , siri:SIRI_VM , siri:SIRI_SX ;
    rdfs:comment "Via StopPointRef in EstimatedCall, RecordedCall, MonitoredCall, AffectedStopPoint" .

netex:StopPlace nordic:referencedBySIRI siri:SIRI_SX , siri:SIRI_FM , siri:SIRI_VM ;
    rdfs:comment "Via StopPlaceRef in AffectedStopPlace, FacilityLocation; OriginRef/DestinationRef in VM" .

netex:GroupOfLines nordic:referencedBySIRI siri:SIRI_ET , siri:SIRI_SX ;
    rdfs:comment "Via GroupOfLinesRef (ET, mandatory for replacements), NetworkRef (SX AffectedNetwork)" .
