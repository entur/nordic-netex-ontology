## -----------------------------------------------------------------
## Nordic NeTEx Structural Model (curated overlay)
## -----------------------------------------------------------------
## ROLE: Curated, navigable Nordic view of NeTEx structure that is
##       editorial rather than mechanical: frame containment.
##
## The generated base ontology remains authoritative for classes,
## properties, cardinality and XSD sequence. This overlay only adds
## the profile's frame containment between the Nordic profile nodes
## (nordic:X, defined in netex-nordic.ttl); nothing here is asserted on
## the netex: classes themselves.
##
## Imports: generated NeTEx base + netex-nordic-vocab.ttl + netex-nordic.ttl
## -----------------------------------------------------------------

@prefix netex:  <https://netex-cen.eu/ontology#> .
@prefix nordic: <https://netex-cen.eu/nordic#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .

<https://netex-cen.eu/nordic/model> a owl:Ontology ;
    rdfs:label "Nordic NeTEx Structural Model" ;
    owl:imports <https://netex-cen.eu/ontology> ,
                <https://netex-cen.eu/nordic> ,
                <https://netex-cen.eu/profile/nordic> ;
    rdfs:comment "Curated frame containment between Nordic profile nodes." .

## =================================================================
## PUBLICATION DELIVERY ENVELOPE
## =================================================================
## The delivery envelope wraps frame content via the dataObjects
## property. It may wrap a CompositeFrame, or individual frames
## directly without a CompositeFrame wrapper.
## -----------------------------------------------------------------

nordic:PublicationDelivery nordic:contains nordic:CompositeFrame ,
        nordic:SiteFrame ,
        nordic:ServiceFrame .

## =================================================================
## FRAME CONTAINMENT
## =================================================================

nordic:CompositeFrame nordic:contains nordic:ResourceFrame ,
        nordic:SiteFrame ,
        nordic:ServiceCalendarFrame ,
        nordic:ServiceFrame ,
        nordic:TimetableFrame ,
        nordic:FareFrame ,
        nordic:SalesTransactionFrame ,
        nordic:Codespace .

nordic:ResourceFrame nordic:containedIn nordic:CompositeFrame ;
    nordic:contains nordic:Authority ,
        nordic:Operator ,
        nordic:VehicleType ,
        nordic:Vehicle ,
        nordic:PurposeOfGrouping .

nordic:SiteFrame nordic:containedIn nordic:CompositeFrame ;
    nordic:contains nordic:StopPlace ,
        nordic:TopographicPlace ,
        nordic:Parking ,
        nordic:TariffZone .

nordic:ServiceCalendarFrame nordic:containedIn nordic:CompositeFrame ;
    nordic:contains nordic:ServiceCalendar ,
        nordic:DayType ,
        nordic:DayTypeAssignment ,
        nordic:OperatingPeriod ,
        nordic:OperatingDay .

nordic:ServiceFrame nordic:containedIn nordic:CompositeFrame ;
    nordic:contains nordic:Line ,
        nordic:Route ,
        nordic:JourneyPattern ,
        nordic:ScheduledStopPoint ,
        nordic:PassengerStopAssignment ,
        nordic:DestinationDisplay ,
        nordic:GroupOfLines ,
        nordic:Notice ,
        nordic:FlexibleServiceProperties ,
        nordic:RoutePoint ,
        nordic:ServiceLink ,
        nordic:SiteConnection ,
        nordic:DefaultConnection .

nordic:TimetableFrame nordic:containedIn nordic:CompositeFrame ;
    nordic:contains nordic:ServiceJourney ,
        nordic:Interchange ,
        nordic:TrainNumber .

nordic:FareFrame nordic:containedIn nordic:CompositeFrame .

nordic:SalesTransactionFrame nordic:containedIn nordic:CompositeFrame .

## =================================================================
## NESTED CLASS CONTAINMENT
## =================================================================
## Containment within frame member classes, one level below the
## frame-containment table above.
## -----------------------------------------------------------------

nordic:AccessibilityAssessment nordic:contains nordic:AccessibilityLimitation .
nordic:AccessibilityLimitation nordic:containedIn nordic:AccessibilityAssessment .

nordic:StopPlace nordic:contains nordic:AlternativeName ,
        nordic:Quay .
nordic:Quay nordic:containedIn nordic:StopPlace ;
    nordic:contains nordic:ShelterEquipment .
