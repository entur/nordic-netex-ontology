@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix void:    <http://rdfs.org/ns/void#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

# =============================================================================
# DCAT manifest of every RDF document this repository is composed of.
# Hand-maintained; update alongside any file that is added, split or removed.
#
# Predicates:
#   dcat:keyword       -> layer (base/vocab/model/profile/baseline/bridge/mapping)
#   dcterms:provenance -> where the file's content originates
#   void:triples       -> triple count at last update (see void:triples below)
# =============================================================================

<https://netex-cen.eu/catalog> a dcat:Catalog ;
    dcterms:title "Nordic NeTEx Ontology — catalog" ;
    dcterms:description "Manifest of every RDF document this repository composes: the vendored generated NeTEx base and the Nordic profile layer on top of it." ;
    dcterms:modified "2026-09-18"^^xsd:date ;
    dcat:dataset
        <https://netex-cen.eu/ontology> ,
        <https://netex-cen.eu/ontology/core> ,
        <https://netex-cen.eu/ontology/framework> ,
        <https://netex-cen.eu/ontology/gml> ,
        <https://netex-cen.eu/ontology/part1> ,
        <https://netex-cen.eu/ontology/part2> ,
        <https://netex-cen.eu/ontology/part3> ,
        <https://netex-cen.eu/ontology/part5> ,
        <https://netex-cen.eu/ontology/service> ,
        <https://netex-cen.eu/ontology/shacl> ,
        <https://netex-cen.eu/ontology/siri> ,
        <https://netex-cen.eu/nordic> ,
        <https://netex-cen.eu/nordic/model> ,
        <https://netex-cen.eu/profile/nordic> ,
        <https://netex-cen.eu/profile/nordic-baseline> ,
        <https://netex-cen.eu/bridge/siri> ,
        <https://netex-cen.eu/alignment/transmodel> .

